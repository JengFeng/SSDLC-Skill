# 環境變數範本 (.env.example)
# Phase 05: Deployment | 2026-06-28
# 複製此檔案為 .env 並填入真實值

# Flask 設定
FLASK_SECRET_KEY=change-me-to-random-64-chars
FLASK_ENV=production
FLASK_DEBUG=false

# 管理員帳號 (首次初始化使用)
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=change-me-now

# 安全設定
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# 日誌
LOG_LEVEL=INFO
