# 員工基本資料管理系統 — 環境變數設定
# ⚠️ 生產環境必須設定強隨機金鑰，勿使用預設值

# Flask Session Secret Key
# 產生方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 資料庫路徑
DB_PATH=hr_system.db

# AES-256 加密金鑰 (Fernet)
# 產生方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# AD SSO (LDAPS) 設定
AD_SERVER=ldap://ad.company.local
AD_DOMAIN=COMPANY
AD_BASE_DN=DC=company,DC=local
AD_BIND_USER=svc_hr@company.local
AD_BIND_PASSWORD=
