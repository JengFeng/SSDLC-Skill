<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<!--DB連線  ConnectionString1為該WS主要使用之DB，ConnectionString2為其同步備用之DB-->
		<!--<add name="ConnectionString1" connectionString="Data Source=127.0.0.1;Initial Catalog=TWN;Persist Security Info=True;User ID=sa;Password=wj/3ck6tj4" providerName="System.Data.SqlClient" />-->
		<!--<add name="ConnectionString1" connectionString="Data Source=59.120.223.165;Initial Catalog=TWN;Persist Security Info=True;User ID=idmm;Password=wj/3ck6tj4" providerName="System.Data.SqlClient" />-->
		<add name="ConnectionString1" connectionString="Data Source=192.168.51.57;Initial Catalog=TWN;Persist Security Info=True;User ID=idmm;Password=7dw?2tMM" providerName="System.Data.SqlClient" />
		<add name="ConnectionString2" connectionString="" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- ※正在使用中的預設資料庫，值1表示Server，值2表示Remoting※ -->
		<!-- ※另解 本WS的角色序號 1為第一WebService、2為第二WebService※-->
		<add key="Database" value="1" />
		<!--※是否自動呼叫同步程式，值true表示自動呼叫，值false表示手動開啟呼叫※-->
		<add key="IsAutoOpenSyncWork" value="false" />
		<!--※是否記錄每日所有Error Log，值true表示記錄，值false表示不記錄※-->
		<add key="SaveAllDayLog" value="false" />
		<!--※是否在每日Log內記錄DB1執行SQL錯誤，值true表示要記錄，值false表示不記錄※-->
		<add key="SaveDB1ExecuLog" value="false" />
		<!--※是否使用同步資料庫 值true表示可，值false表示不可※-->
		<add key="IsBackup" value="false" />
		<!--※是否要讓DB執行Execute 值true表示可，值false表示不可※-->
		<add key="IsExecute" value="true" />
		<!--※以下為Web Service自行同步，設定的參數(目前無使用)※-->
		<!--※是否要保留[曾經執行失敗][之後同步成功後]之SQL語法 值true表示保留，值false表示刪除※-->
		<add key="SaveExecuteSQLLog" value="false" />
		<!--※是否要保留[曾經執行失敗][之後同步成功後]之SQL語法備份bak檔 值true表示保留，值false表示刪除※-->
		<add key="SaveExecuteSQLBak" value="false" />
		<!--※是否使用開啟快取 值true表示可，值false表示不可※-->
		<add key="IsCache" value="false" />
		<!--※記錄快取的時間(分鐘)※-->
		<add key="CacheMinutes" value="60" />
	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.0" />
	</system.web>
	<system.serviceModel>
		<services>
			<service name="SyncDataBase.SqlServiceJson" behaviorConfiguration="webServiceBehavior">
				<endpoint address="" binding="webHttpBinding" contract="SyncDataBase.ISqlServiceJson" behaviorConfiguration="webBindingBehavior">
				</endpoint>
				<!--<endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>-->
			</service>
			<service name="SyncDataBase.SqlService" behaviorConfiguration="baseServiceBehavior">
				<endpoint address="" binding="basicHttpBinding" contract="SyncDataBase.ISqlService"/>
			</service>
			<service name="SyncDataBase.AdminService" behaviorConfiguration="admineServiceBehavior">
				<endpoint address="" binding="basicHttpBinding" contract="SyncDataBase.IAdminService" />
			</service>
			<service name="SyncDataBase.DapperService" behaviorConfiguration="dapperServiceBehavior">
				<endpoint address="" binding="basicHttpBinding" contract="SyncDataBase.IDapperService" />
			</service>
		</services>
		<behaviors>
			<endpointBehaviors>
				<behavior name="webBindingBehavior">
					<webHttp />
				</behavior>
			</endpointBehaviors>
			<serviceBehaviors>
				<behavior name="webServiceBehavior">
					<serviceMetadata httpGetEnabled="true" httpsGetEnabled="false" />
					<serviceDebug httpHelpPageEnabled="true" includeExceptionDetailInFaults="true" />
				</behavior>
				<behavior name="dapperServiceBehavior">
					<serviceMetadata httpGetEnabled="true" httpsGetEnabled="false" />
					<serviceDebug httpHelpPageEnabled="true" includeExceptionDetailInFaults="true" />
				</behavior>
				<behavior name="baseServiceBehavior">
					<serviceMetadata httpGetEnabled="true" httpsGetEnabled="false" />
					<serviceDebug httpHelpPageEnabled="true" includeExceptionDetailInFaults="true" />
				</behavior>
				<behavior name="admineServiceBehavior">
					<serviceMetadata httpGetEnabled="true" httpsGetEnabled="false" />
					<serviceDebug httpHelpPageEnabled="true" includeExceptionDetailInFaults="true" />
				</behavior>
				<behavior name="">
					<serviceMetadata httpGetEnabled="true" />
					<serviceDebug includeExceptionDetailInFaults="false" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
		<protocolMapping>
			<add binding="basicHttpsBinding" scheme="https" />
		</protocolMapping>
		<bindings>
			<basicHttpBinding>
				<binding maxReceivedMessageSize="2147483647" maxBufferSize="2147483647" maxBufferPoolSize="2147483647">
					<readerQuotas maxDepth="32" maxArrayLength="2147483647" maxStringContentLength="2147483647"/>
				</binding>
			</basicHttpBinding>
		</bindings>
		<serviceHostingEnvironment aspNetCompatibilityEnabled="false" multipleSiteBindingsEnabled="true" />
	</system.serviceModel>
	<system.webServer>
		<modules runAllManagedModulesForAllRequests="true" />
		<!--
        若要在偵錯期間瀏覽 Web 應用程式根目錄，請將下面的值設為 true。
        請在部署之前將該值設定為 false，以避免 Web 應用程式資料夾資訊洩漏。
      -->
		<directoryBrowse enabled="true" />
	</system.webServer>
</configuration>
