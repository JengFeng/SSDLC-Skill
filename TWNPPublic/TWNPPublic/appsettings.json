{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": false,
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/logs/sqlite-${shortdate}.log",
        "layout": "${date} [${uppercase:${level}}] ${message} ${exception}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile"
      }
    ]
  },
  //"MeterRecordSqllite": "Data Source=D:\\{0}.sqlite",
  "MeterRecordSqllite": "D:\\{0}.sqlite",
  //"DapperWcfUrl": "http://59.120.223.172/TWN_WCF/DapperService.svc",
  //"SQLWcfUrl": "http://59.120.223.172/TWN_WCF/SqlService.svc",
  "DapperWcfUrl": "http://localhost/TWN_WCF/DapperService.svc",
  "SQLWcfUrl": "http://localhost/TWN_WCF/SqlService.svc",
  //"DapperWcfUrl": "http://localhost:41027/DapperService.svc",
  //"DapperWcfUrl": "http://localhost:41027/DapperService.svc",
  "AllowedHosts": "*",
  "PrevURLName": ""
}
