@{
    ViewData["Title"] = "警示設定";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ListofWaterNO = (List<string>)ViewBag.WaterNo;
    //var MMcode = (Dictionary<string, Tuple<int, string>>)ViewBag.MMcode;
    //Toggle Button 放在 css 裡，有需要更動的再注意一下
}
@section validation{
<link rel="stylesheet" href=~/css/Switcher.css />
<script type="text/javascript" src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script type="text/javascript" src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<style>
    .form-check {
        margin: 10px 0px;
    }

    .btn-green-o-hover {
        color: #fff;
        background-color: #089BAB;
        border-color: #089BAB;
    }

    .onoffswitch-inner-on {
        margin-left: 0;
    }

    .onoffswitch-switch-on {
        right: 0px;
    }

</style>
}

<script>
    $(function(){
        $(".menuList > a:nth-child(3)").addClass("active").siblings().removeClass("active");
        let gettest = $(".btn-alertsetSwithch").attr('id');
        btnSwitchSetAlertWaterNo($('#' + gettest));
        GetAlertSetFromWaterNo($('#' + gettest).data('waterno'));

        $(".onoffswitch-checkbox").on('click', function(){
            let isChecked = this.checked;
            let $label = $("label[for='" + $(this).attr('id') + "']");
            if (isChecked) {
                $label.find('.onoffswitch-inner').addClass('onoffswitch-inner-on');
                $label.find('.onoffswitch-switch').addClass('onoffswitch-switch-on');
            } else {
                $label.find('.onoffswitch-inner').removeClass('onoffswitch-inner-on');
                $label.find('.onoffswitch-switch').removeClass('onoffswitch-switch-on');
            }
        });
    });

    function SetOnOffswitch(obj){
        let isChecked = $('#' + obj)[0].checked;
        let $label = $("label[for='" + obj + "']");
        if (isChecked) {
            $label.find('.onoffswitch-inner').addClass('onoffswitch-inner-on');
            $label.find('.onoffswitch-switch').addClass('onoffswitch-switch-on');
        } else {
            $label.find('.onoffswitch-inner').removeClass('onoffswitch-inner-on');
            $label.find('.onoffswitch-switch').removeClass('onoffswitch-switch-on');
        }
    }

    function ResetAllSet(){

        $("#AlertPhone").val('');
        $("#AlertEmail1").val('');
        $("#AlertEmail2").val('');
        $("#AlertEmail3").val('');

        $("#myonoffswitch1").prop('checked', false);
        $("#myonoffswitch2").prop('checked', false);
        $("#myonoffswitch3").prop('checked', false);
        $("#myonoffswitch4").prop('checked', false);

        $('.onoffswitch-inner').removeClass('onoffswitch-inner-on');
        $('.onoffswitch-switch').removeClass('onoffswitch-switch-on');

        $('input.form-check-input[value="103"]').prop('checked', false);
        $('input.form-check-input[value="104"]').prop('checked', false);
        $('input.form-check-input[value="105"]').prop('checked', false);
        $('input.form-check-input[value="106"]').prop('checked', false);

        $("#Code100Alert103Extion01").val('');
        $("#Code100Alert103Extion02").val('');
        $("#Code100Alert104Extion01").val('');
        $("#Code100Alert104Extion02").val('');
        $("#Code101Alert105Extion01").val('');
        $("#Code101Alert106Extion01").val('');
    }

    function GetAlertSetFromWaterNo(obj){
        let model = {
            WaterNo : obj
            };
         $.get("@Context.Items["urlPrefix"]@Url.Action("LoadAlertSet","Alert")",model,function(result){
            if(result.Success){
                $("#AlertPhone").val(result.Data.AlertPhone);

                $("#AlertEmail1").val(result.Data.AlertEmails[0]);
                $("#AlertEmail2").val(result.Data.AlertEmails[1]);
                $("#AlertEmail3").val(result.Data.AlertEmails[2]);

                if(result.Data.AlertValueYesterday != null && result.Data.AlertValueYesterday != ''){
                    let EVYesterday = "";
                    let strAry = [];
                    if(result.Data.ExtendValue1Yesterday != null && result.Data.ExtendValue1Yesterday != ''){
                        EVYesterday = result.Data.ExtendValue1Yesterday;
                         strAry = EVYesterday.split(',');
                    }

                    $("#myonoffswitch1").prop("checked",true);
                    SetOnOffswitch('myonoffswitch1');
                    if(result.Data.AlertValueYesterday == '103'){
                        $("#Code100Alert103Extion01").val(strAry[0]);
                        $("#Code100Alert103Extion02").val(strAry[1]);
                        $('input.form-check-input[value="103"]').prop('checked', true);

                    }else if(result.Data.AlertValueYesterday == '104'){
                        $("#Code100Alert104Extion01").val(strAry[0]);
                        $("#Code100Alert104Extion02").val(strAry[1]);
                        $('input.form-check-input[value="104"]').prop('checked', true);

                    }
                }


                if(result.Data.AlertValueLastMonth != null && result.Data.AlertValueLastMonth != ''){
                    let AVeLastMonth = "";
                    if(result.Data.ExtendValueLastMonth != null && result.Data.ExtendValueLastMonth != ''){
                        AVeLastMonth = result.Data.ExtendValueLastMonth;
                    }

                    $("#myonoffswitch2").prop("checked",true);
                    SetOnOffswitch('myonoffswitch2');
                    if(result.Data.AlertValueLastMonth == '105'){
                        $('input.form-check-input[value="105"]').prop('checked', true);
                        $("#Code101Alert105Extion01").val(AVeLastMonth);
                    }else if(result.Data.AlertValueLastMonth == '106'){
                        $('input.form-check-input[value="106"]').prop('checked', true);
                        $("#Code101Alert106Extion01").val(AVeLastMonth);
                    }
                }

                if(result.Data.AlertValueThreedayWaterUse != null && result.Data.AlertValueThreedayWaterUse != ''){
                    $("#myonoffswitch3").prop("checked",true);
                    SetOnOffswitch('myonoffswitch3');
                }

                if(result.Data.AlertValueThreedayWaterNonUse != null && result.Data.AlertValueThreedayWaterNonUse != ''){
                    $("#myonoffswitch4").prop("checked",true);
                    SetOnOffswitch('myonoffswitch4');
                }

            }
        });
    }

    function BtnSave(){
        var model = {
            WaterNo: $('.btn-green-o-hover').data('waterno'),
            //WaterNo : $("input[name='WaterNo']:checked").map(function(){return $(this).val();}).get(),
            AlertPhone:$("#AlertPhone").val(),
            AlertEmail1:$("input[name='AlertEmail1']").val(),
            AlertEmail2:$("input[name='AlertEmail2']").val(),
            AlertEmail3:$("input[name='AlertEmail3']").val(),

            //設定管理
            onoffswitch1:$("input[name='onoffswitch1']:checked").val(),
            onoffswitch2:$("input[name='onoffswitch2']:checked").val(),
            onoffswitch3:$("input[name='onoffswitch3']:checked").val(),
            onoffswitch4:$("input[name='onoffswitch4']:checked").val(),

            AlertValue1:$("input[name='radio1']:checked").val(),
            AlertValue2:$("input[name='radio2']:checked").val(),

            AlertExtion10010301:$("#Code100Alert103Extion01").val(),
            AlertExtion10010302:$("#Code100Alert103Extion02").val(),
            AlertExtion10010401:$("#Code100Alert104Extion01").val(),
            AlertExtion10010402:$("#Code100Alert104Extion02").val(),

            AlertExtion10110501:$("#Code101Alert105Extion01").val(),
            AlertExtion10110601:$("#Code101Alert106Extion01").val()

        };

        if(model.WaterNo.length == 0)
        {
            let confirmAction = confirm("若您尚未選擇水號，系統將清空您的設定，您確定要執行以下操作?");
            if (!confirmAction) {
                return;
            }
        }

        $(".text-danger").text('');
        var Validator = $("#FormAlertSet").validate();
        var url = "@Context.Items["urlPrefix"]@Url.Action("SaveAlertSet", "Alert")"
            $.ajax({
            url: url,
                type: "Post",
                data: model,
                success: function (data) {
                    if (data.Success) {
                        alert(data.Message);
                        //history.go(0);
                    } else {
                        if (data.ModelStateErrors != null) {
                            for (var key in data.ModelStateErrors) {
                                $("#danger" + key).text(data.ModelStateErrors[key][0]);
                            }
                        } else {
                            alert(data.Message);
                        }
                    }
                },
                traditional: true
            });
    }

    function btnSwitchSetAlertWaterNo(obj){
        $(".btn-alertsetSwithch").removeClass("btn-green-o-hover");
        $(obj).addClass("btn-green-o-hover");
        ResetAllSet();
        GetAlertSetFromWaterNo($(obj).data('waterno'));
    }

    function BtnReset(){
        history.go(0);
    }
</script>

<div class="pageWrap">
    <partial name="_MenuPartial" />
    <div class="pageArea">
        <partial name="_NewsBoxPartial" />
        <div class="mainGroup" style="padding:35px 50px">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard")"><i class="bi bi-house-door-fill"></i>首頁</a></li>
                    <li class="breadcrumb-item active" aria-current="page">警示設定</li>
                </ol>
            </nav>
            <form id="FormAlertSet">
                <div class="unitTitle">
                    <i class="bi bi-droplet"></i>
                    選擇水號
                </div>
                <div class="formGroup" style="display:flow-root">
                    @if (ListofWaterNO.Count() > 0)
                    {
                        foreach (var item in ListofWaterNO)
                        {
                            @*<input type="checkbox" value="@item" id="WaterNo@(item)" name="WaterNo"><label for="WaterNo@(item)">@item</label>*@
                            <button type="button" class="btn-alertsetSwithch btn-green-o" style="margin:5px" onclick="btnSwitchSetAlertWaterNo(this)" id="WaterNo@(item)" data-waterno="@item">@item</button>
                        }
                    }
                </div>
                <div class="unitTitle">
                    <i class="bi bi-person-square"></i>
                    基本資料
                </div>
                <div class="formGroup">
                    <div class="mb-3 row">
                        <label for="inputText" class="col-sm-3 col-form-label">
                            <span style="color:red">*</span>
                            <i class="bi bi-phone"></i> 聯繫電話設定
                        </label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" id="AlertPhone" placeholder="0901001001" autocomplete="off">
                            <span class="text-danger" id="dangerAlertPhone"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label for="inputEmail1" class="col-sm-3 col-form-label"><i class="bi bi-mailbox"></i> 電子郵件設定</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" id="AlertEmail1" name="AlertEmail1" placeholder="some@mail.com" autocomplete="off">
                            <span class="text-danger" id="dangerAlertEmail1"></span>
                        </div>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" id="AlertEmail2" name="AlertEmail2" placeholder="some@mail.com" autocomplete="off">
                            <span class="text-danger" id="dangerAlertEmail2"></span>
                        </div>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" id="AlertEmail3" name="AlertEmail3" placeholder="some@mail.com" autocomplete="off">
                            <span class="text-danger" id="dangerAlertEmail3"></span>
                        </div>
                    </div>
                </div>

                <div class="unitTitle">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    警訊設定管理
                </div>

                <div class="row">
                    <div class="col-sm-8 col-lg-8">
                        <div class="formGroup">
                            <div class="title row">
                                開啟
                                <div class="onoffswitch">
                                    <input type="checkbox" name="onoffswitch1" class="onoffswitch-checkbox" id="myonoffswitch1" @*onclick="btnonoffswitch(this)"*@>
                                    <label class="onoffswitch-label" for="myonoffswitch1" id="lbmyonoffswitch1">
                                        <span class="onoffswitch-inner"></span>
                                        <span class="onoffswitch-switch"></span>
                                    </label>
                                </div>
                                關閉
                                &nbsp;&nbsp;
                                日用水量(前日24:00至昨日23:00)
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="radio1" value="103">
                                <label class="form-check-label row">
                                    較前日比較突增
                                    <div class="col-auto">
                                        <input type="text" class="form-control" style="width:80px" id="Code100Alert103Extion01">
                                        <span class="text-danger" autocomplete="off"></span>
                                    </div>
                                    %(含以上)，用水突減
                                    <div class="col-auto">
                                        <input type="text" class="form-control" style="width:80px" id="Code100Alert103Extion02">
                                        <span class="text-danger" autocomplete="off"></span>
                                    </div>
                                    %(含以下)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="radio1" value="104">
                                <label class="form-check-label row">
                                    較上月日平均用水突增
                                    <div class="col-auto">
                                        <input type="text" class="form-control" style="width:80px" id="Code100Alert104Extion01">
                                        <span class="text-danger" autocomplete="off"></span>
                                    </div>
                                    %(含)以上，用水突減
                                    <div class="col-auto">
                                        <input type="text" class="form-control" style="width:80px" id="Code100Alert104Extion02">
                                        <span class="text-danger" autocomplete="off"></span>
                                    </div>
                                    %(含)以下
                                </label>
                            </div>

                            <div class="title row">
                                開啟
                                <div class="onoffswitch">
                                    <input type="checkbox" name="onoffswitch2" class="onoffswitch-checkbox" id="myonoffswitch2">
                                    <label class="onoffswitch-label" for="myonoffswitch2">
                                        <span class="onoffswitch-inner"></span>
                                        <span class="onoffswitch-switch"></span>
                                    </label>
                                </div>
                                關閉
                                &nbsp;&nbsp;
                                上月用水量
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="radio2" value="105">
                                <label class="form-check-label row" for="radio12">
                                    較前月用水突增
                                    <div class="col-auto">
                                        <input type="text" class="form-control" style="width:80px" id="Code101Alert105Extion01">
                                        <span class="text-danger" autocomplete="off"></span>
                                    </div>
                                    %(含)以上
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="radio2" value="106">
                                <label class="form-check-label row">
                                    較去年同期用水突增
                                    <div class="col-auto">
                                        <input type="text" class="form-control" style="width:80px" id="Code101Alert106Extion01">
                                        <span class="text-danger" autocomplete="off"></span>
                                    </div>
                                    %(含)以上
                                </label>
                            </div>

                        </div>
                    </div>
                    <div class="col-sm-4 col-lg-4">
                        <div class="formGroup">

                            <div class="title row">
                                開啟
                                <div class="onoffswitch">
                                    <input type="checkbox" name="onoffswitch3" class="onoffswitch-checkbox" id="myonoffswitch3">
                                    <label class="onoffswitch-label" for="myonoffswitch3">
                                        <span class="onoffswitch-inner"></span>
                                        <span class="onoffswitch-switch"></span>
                                    </label>
                                </div>
                                關閉
                                &nbsp;&nbsp;
                                連續三日無用水
                            </div>
                            <div class="form-check">
                            </div>

                            <div class="title row">
                                開啟
                                <div class="onoffswitch">
                                    <input type="checkbox" name="onoffswitch4" class="onoffswitch-checkbox" id="myonoffswitch4">
                                    <label class="onoffswitch-label" for="myonoffswitch4">
                                        <span class="onoffswitch-inner"></span>
                                        <span class="onoffswitch-switch"></span>
                                    </label>
                                </div>
                                關閉
                                &nbsp;&nbsp;
                                連續三日用水
                            </div>
                            <div class="form-check">
                            </div>

                        </div>
                    </div>
                </div>
            </form>
            <div class="btnGroup">
                <a class="btn-green-o" href="javascript:" onclick="BtnSave()">儲存</a>
                <a class="btn-lightGrey-o" href="javascript:" onclick="BtnReset()">重填</a>
            </div>
        </div>
    </div>
</div><!-- wrap end -->
