    function GetAlertSetFromWaterNo(obj){
        let model = {
            WaterNo : obj
            };
         $.get(GetWebSiteURL('@Url.Action("LoadAlertSet", "Alert")'),model,function(result){
            if(result.Success){
                console.log(result);
                $("#AlertPhone").val(result.Data.AlertPhone);

                $("#AlertEmail1").val(result.Data.AlertEmails[0]);
                $("#AlertEmail2").val(result.Data.AlertEmails[1]);
                $("#AlertEmail3").val(result.Data.AlertEmails[2]);
                $("#AlertEmail4").val(result.Data.AlertEmails[3]);
                $("#AlertEmail5").val(result.Data.AlertEmails[4]);

                const alertValues = [
                    result.Data.AlertValueYesterday,
                    result.Data.AlertValueWeek,
                    result.Data.AlertValueLastMonth,
                    result.Data.AlertValueContinuousWaterUsage,
                    result.Data.AlertValueContinuousIdleWaterUsage,
                    result.Data.AlertValueNighttimeWaterIncrease
                ];

                if (alertValues.some(value => value != null && value != '')) {
                    $("#myonoffswitch1").prop("checked", true);
                    SetOnOffswitch('myonoffswitch1');
                }

                if(result.Data.AlertValueYesterday != null && result.Data.AlertValueYesterday != ''){
                    let EVYesterday = "";
                    let strAry = [];
                    if(result.Data.ExtendValue1Yesterday != null && result.Data.ExtendValue1Yesterday != ''){
                        EVYesterday = result.Data.ExtendValue1Yesterday;
                         strAry = EVYesterday.split(',');
                    }
                    $('input[name="checkbox3"][value="100"]').prop('checked', true);
                    if(result.Data.AlertValueYesterday == '103'){
                        $("#Code100Alert103Extion01").val(strAry[0]);
                        $("#Code100Alert103Extion02").val(strAry[1]);
                        $("#Code100Alert103Extion03").val(strAry[2]);
                        $("#Code100Alert103Extion04").val(strAry[3]);
                        $('input.form-check-input[value="103"]').prop('checked', true);

                    }else if(result.Data.AlertValueYesterday == '104'){
                        $("#Code100Alert104Extion01").val(strAry[0]);
                        $("#Code100Alert104Extion02").val(strAry[1]);
                        $("#Code100Alert104Extion03").val(strAry[2]);
                        $("#Code100Alert104Extion04").val(strAry[3]);
                        $('input.form-check-input[value="104"]').prop('checked', true);

                    }
                }

                if (result.Data.AlertValueWeek != null && result.Data.AlertValueWeek != '') {
                    let EVWeekday = "";
                    let strAry = [];
                    if (result.Data.ExtendValue1Week != null && result.Data.ExtendValue1Week != '') {
                        EVWeekday = result.Data.ExtendValue1Week;
                        strAry = EVWeekday.split(',');
                    }

                    $('input[name="checkbox4"][value="646"]').prop('checked', true);
                    if (result.Data.AlertValueWeek == '647') {
                        $("#Code646Alert647Extion01").val(strAry[0]);
                        $("#Code646Alert647Extion02").val(strAry[1]);
                        $("#Code646Alert647Extion03").val(strAry[2]);
                        $("#Code646Alert647Extion04").val(strAry[3]);
                        $('input.form-check-input[value="647"]').prop('checked', true);

                    } else if (result.Data.AlertValueWeek == '648') {
                        $("#Code646Alert648Extion01").val(strAry[0]);
                        $("#Code646Alert648Extion02").val(strAry[1]);
                        $("#Code646Alert648Extion03").val(strAry[2]);
                        $("#Code646Alert648Extion04").val(strAry[3]);
                        $('input.form-check-input[value="648"]').prop('checked', true);

                    }
                }

                if (result.Data.AlertValueLastMonth != null && result.Data.AlertValueLastMonth != '') {
                    let AVeLastMonth = "";
                    let strAry = [];
                    if (result.Data.ExtendValueLastMonth != null && result.Data.ExtendValueLastMonth != '') {
                        AVeLastMonth = result.Data.ExtendValueLastMonth;
                        strAry = AVeLastMonth.split(',');
                    }
                    $('input[name="checkbox5"][value="101"]').prop('checked', true);
                    if (result.Data.AlertValueLastMonth == '105') {
                        $("#Code101Alert105Extion01").val(strAry[0]);
                        $("#Code101Alert105Extion02").val(strAry[1]);
                        $("#Code101Alert105Extion03").val(strAry[2]);
                        $("#Code101Alert105Extion04").val(strAry[3]);
                        $('input.form-check-input[value="105"]').prop('checked', true);
                        
                    } else if (result.Data.AlertValueLastMonth == '106') {
                        $("#Code101Alert106Extion01").val(strAry[0]);
                        $("#Code101Alert106Extion02").val(strAry[1]);
                        $("#Code101Alert106Extion03").val(strAry[2]);
                        $("#Code101Alert106Extion04").val(strAry[3]);
                        $('input.form-check-input[value="106"]').prop('checked', true);
                    }
                }

                if (result.Data.AlertValueContinuousWaterUsage != null && result.Data.AlertValueContinuousWaterUsage != '') {
                    let AVeContinuousWaterUsage = "";
                    if (result.Data.ExtendValueContinuousWaterUsage != null && result.Data.ExtendValueContinuousWaterUsage != '') {
                        AVeContinuousWaterUsage = result.Data.ExtendValueContinuousWaterUsage;
                    }

                    $('input[name="checkbox6"][value="108"]').prop('checked', true);
                    if (result.Data.AlertValueContinuousWaterUsage == '108') {
                        $('input[name="radio4"][value="108"]').prop('checked', true);
                        $("#Code102Alert108Extion01").val(AVeContinuousWaterUsage);
                    }
                    else $("#Code102Alert108Extion01").val('3');
                }
                else $("#Code102Alert108Extion01").val('3');

                if (result.Data.AlertValueContinuousIdleWaterUsage != null && result.Data.AlertValueContinuousIdleWaterUsage != '') {
                    let AVeContinuousIdleWaterUsage = "";
                    if (result.Data.ExtendValueContinuousIdleWaterUsage != null && result.Data.ExtendValueContinuousIdleWaterUsage != ''){
                        AVeContinuousIdleWaterUsage = result.Data.ExtendValueContinuousIdleWaterUsage;
                    }

                    $('input[name="checkbox7"][value="107"]').prop('checked', true);
                    if (result.Data.AlertValueContinuousIdleWaterUsage == '107') {
                        $('input[name="radio5"][value="107"]').prop('checked', true);
                        $("#Code102Alert107Extion01").val(AVeContinuousIdleWaterUsage);
                    }
                    else $("#Code102Alert107Extion01").val('3');
                }
                else $("#Code102Alert107Extion01").val('3');

                if (result.Data.AlertValueNighttimeWaterIncrease != null && result.Data.AlertValueNighttimeWaterIncrease != '') {
                    let AVeNighttimeWaterIncrease = "";
                    let strAry = [];
                    if (result.Data.ExtendValueNighttimeWaterIncrease != null && result.Data.ExtendValueNighttimeWaterIncrease != '') {
                        AVeNighttimeWaterIncrease = result.Data.ExtendValueNighttimeWaterIncrease;
                        strAry = AVeNighttimeWaterIncrease.split(',');
                    }
                    $('input[name="checkbox8"][value="649"]').prop('checked', true);
                    if (result.Data.AlertValueNighttimeWaterIncrease == '649') {
                        $('input[name="radio6"][value="649"]').prop('checked', true);
                        $("#Code102Alert649Extion01").val(strAry[0]);
                        $("#Code102Alert649Extion02").val(strAry[1]);
                    }
                }

                if(result.Data.AlertValueDailyWaterUsageLimit != null && result.Data.AlertValueDailyWaterUsageLimit != '') {
                    let AVeDailyWaterUsageLimit = "";
                    if (result.Data.ExtendValueDailyWaterUsageLimit != null && result.Data.ExtendValueDailyWaterUsageLimit != '') {
                        AVeDailyWaterUsageLimit = result.Data.ExtendValueDailyWaterUsageLimit;
                    }

                    $('input[name="checkbox1"][value="650"]').prop('checked', true);
                    $("#waterLimit").show(); // 顯示用水上限度數
                    if (result.Data.AlertValueDailyWaterUsageLimit == '650') {
                        $("#Code102Alert650Extion01").val(AVeDailyWaterUsageLimit);
                    }
                }

                if (result.Data.AlertValueWaterUsageBudget != null && result.Data.AlertValueWaterUsageBudget != '') {
                    let AVeWaterUsageBudget = "";
                    if (result.Data.ExtendValueWaterUsageBudget != null && result.Data.ExtendValueWaterUsageBudget != '') {
                        AVeWaterUsageBudget = result.Data.ExtendValueWaterUsageBudget;
                    }

                    $('input[name="checkbox2"][value="651"]').prop('checked', true);
                    $("#budgetLimit").show(); // 顯示用水預算上限
                    if (result.Data.AlertValueWaterUsageBudget == '651') {
                        $("#Code102Alert651Extion01").val(AVeWaterUsageBudget);
                    }
                }

                // if(result.Data.AlertValueLastMonth != null && result.Data.AlertValueLastMonth != ''){
                //     let AVeLastMonth = "";
                //     if(result.Data.ExtendValueLastMonth != null && result.Data.ExtendValueLastMonth != ''){
                //         AVeLastMonth = result.Data.ExtendValueLastMonth;
                //     }

                //     // $("#myonoffswitch2").prop("checked",true);
                //     // SetOnOffswitch('myonoffswitch2');
                //     if(result.Data.AlertValueLastMonth == '105'){
                //         $('input.form-check-input[value="105"]').prop('checked', true);
                //         $("#Code101Alert105Extion01").val(AVeLastMonth);
                //     }else if(result.Data.AlertValueLastMonth == '106'){
                //         $('input.form-check-input[value="106"]').prop('checked', true);
                //         $("#Code101Alert106Extion01").val(AVeLastMonth);
                //     }
                // }

                // if(result.Data.AlertValueThreedayWaterUse != null && result.Data.AlertValueThreedayWaterUse != ''){
                //     $("#myonoffswitch3").prop("checked",true);
                //     SetOnOffswitch('myonoffswitch3');
                // }

                // if(result.Data.AlertValueThreedayWaterNonUse != null && result.Data.AlertValueThreedayWaterNonUse != ''){
                //     $("#myonoffswitch4").prop("checked",true);
                //     SetOnOffswitch('myonoffswitch4');
                // }


                // // 將禁用邏輯移到這裡，在資料載入完成後執行
                // // ⭐ 修改後的禁用邏輯
                // const isGroupedAccount = @(isGroupedAccount.ToString().ToLower());
                // if (isGroupedAccount) {
                //     // 只禁用表單內的輸入欄位
                //     $("#FormAlertSet :input").prop("disabled", true);
                //     // 隱藏儲存/重填按鈕
                //     $(".btnGroup").hide();
                // } else {
                //     // 確保非歸戶帳號時欄位可用
                //     $("#FormAlertSet :input").prop("disabled", false);
                //     $(".btnGroup").show();
                // }

                 const isGroupedAccount = @(isGroupedAccount.ToString().ToLower());
                 if (isGroupedAccount) {
                     // 只禁用可輸入欄位，不要禁用水號按鈕
                     $("#FormAlertSet").find("input, textarea, select").prop("disabled", true);

                     // 若要保留水號切換，就不要碰 .btn-alertsetSwithch
                     $(".btnGroup").hide();
                 } else {
                     $("#FormAlertSet").find("input, textarea, select").prop("disabled", false);
                     $(".btnGroup").show();
                 }

            }
            else {
                $("#myonoffswitch1").prop("checked", false);
                SetOnOffswitch('myonoffswitch1');
            }
        });
    }

