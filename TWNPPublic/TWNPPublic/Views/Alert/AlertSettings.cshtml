                    $('input[name="checkbox4"][value="646"]').prop('checked', true);
                    if (result.Data.AlertValueWeek == '647') {
                        $("#Code646Alert647Extion01").val(strAry[0]);
                        $("#Code646Alert647Extion02").val(strAry[1]);
                        $("#Code646Alert647Extion03").val(strAry[2]);
                        $("#Code646Alert647Extion04").val(strAry[3]);
                        $('input.form-check-input[value="647"]').prop('checked', true);

