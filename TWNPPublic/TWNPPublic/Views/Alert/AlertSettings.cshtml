@{
    ViewData["Title"] = "警示設定";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ListofWaterNO = (List<string>)ViewBag.WaterNo;
    //var MMcode = (Dictionary<string, Tuple<int, string>>)ViewBag.MMcode;
}
@section validation{
<script type="text/javascript" src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script type="text/javascript" src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
<script>
    $(function(){
        $(".menuList > a:nth-child(4)").addClass("active").siblings().removeClass("active");
        $.get("@Url.Action("LoadAlertSet","Alert")",function(result){
            if(result.Success){
                $("#AlertPhone").val(result.Data.AlertPhone);

                $("#AlertEmail1").val(result.Data.AlertEmails[0]);
                $("#AlertEmail2").val(result.Data.AlertEmails[1]);
                $("#AlertEmail3").val(result.Data.AlertEmails[2]);
                if(result.Data.WaterNos.length > 0){
                    $.each(result.Data.WaterNos,function(index,value){
                          $("input[name=\"WaterNo\"][value=" + value + "]").prop('checked',true);
                    });
                }
                if(result.Data.AlertValueStraight7Day != '')
                    $("input[name=\"radio2\"][value=" + result.Data.AlertValueStraight7Day + "]").prop('checked',true);
                if(result.Data.AlertValueStraight30Day != '')
                    $("input[name=\"radio3\"][value=" + result.Data.AlertValueStraight7Day + "]").prop('checked',true);
                if(result.Data.ExtendValueStraight7Day != '')
                    $("#InputExtend").val(result.Data.ExtendValueStraight7Day);
            }
        });
        $('input:radio[name="radio1"]').change(function() {
            $('input:radio[name="radio2"]').prop('checked',false);
            $('input:radio[name="radio3"]').prop('checked',false);
        });

        $('input:radio[name="radio2"]').change(function() {
            $('input:radio[name="radio1"]').prop('checked',false);
        });

        $('input:radio[name="radio3"]').change(function() {
            $('input:radio[name="radio1"]').prop('checked',false);
        });
    });

    function BtnSave(){
        var model = {
            WaterNo : $("input[name='WaterNo']:checked").map(function(){return $(this).val();}).get(),
            AlertPhone:$("#AlertPhone").val(),
            AlertEmail1:$("input[name='AlertEmail1']").val(),
            AlertEmail2:$("input[name='AlertEmail2']").val(),
            AlertEmail3:$("input[name='AlertEmail3']").val(),
            AlertValue1:$("input[name='radio1']:checked").val(),
            AlertValue2:$("input[name='radio2']:checked").val(),
            AlertExtion2:$("#AlertExtion2").val(),
            AlertValue3:$("input[name='radio3']:checked").val()
        };
        var Validator = $("#FormAlertSet").validate();
        var url = "@Url.Action("SaveAlertSet", "Alert")"
            $.ajax({
            url: url,
                type: "Post",
                data: model,
                success: function (data) {
                    if (data.Success) {
                        alert(data.Message);
                    } else {
                        if (data.ModelStateErrors != null) {
                            for (var key in data.ModelStateErrors) {
                                $("#danger" + key).text(data.ModelStateErrors[key][0]);
                            }
                        } else {
                            alert(data.Message);
                        }
                    }
                },
                traditional: true
            });
    }

    function BtnReset(){
        history.go(0);
    }
</script>

<div class="pageWrap">
    <partial name="_MenuPartial" />
    <div class="pageArea">
        <partial name="_NewsBoxPartial" />
        <div class="mainGroup" style="padding:35px 50px">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard")"><i class="bi bi-house-door-fill"></i>首頁</a></li>
                    <li class="breadcrumb-item active" aria-current="page">警示設定</li>
                </ol>
            </nav>
            <form id="FormAlertSet">
                <div class="unitTitle">
                    <i class="bi bi-droplet"></i>
                    選擇水號
                </div>
                <div class="formGroup">
                    <div class="row">
                        @if (ListofWaterNO.Count() > 0)
                        {
                            foreach (var item in ListofWaterNO)
                            {
                                <div class="col-sm-3">
                                    <input type="checkbox" value="@item" id="WaterNo@(item)" name="WaterNo"><label for="WaterNo@(item)">@item</label>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="unitTitle">
                    <i class="bi bi-person-square"></i>
                    基本資料
                </div>
                <div class="formGroup">
                    <div class="mb-3 row">
                        <label for="inputText" class="col-sm-3 col-form-label">
                            <span style="color:red">*</span>
                            <i class="bi bi-phone"></i> 手機簡訊設定
                        </label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" id="AlertPhone" placeholder="0901001001">
                            <span class="text-danger" id="dangerAlertPhone"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label for="inputEmail1" class="col-sm-3 col-form-label"><i class="bi bi-mailbox"></i> 電子郵件設定</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" id="AlertEmail1" name="AlertEmail1" placeholder="some@mail.com">
                            <span class="text-danger" id="dangerAlertEmail1"></span>
                        </div>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" id="AlertEmail2" name="AlertEmail2" placeholder="some@mail.com">
                            <span class="text-danger" id="dangerAlertEmail2"></span>
                        </div>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" id="AlertEmail3" name="AlertEmail3" placeholder="some@mail.com">
                            <span class="text-danger" id="dangerAlertEmail3"></span>
                        </div>
                    </div>
                </div>
                <div class="unitTitle">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    警訊設定管理
                </div>
                <div class="formGroup">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio1" id="radio1" value="0">
                        <label class="form-check-label" for="radio1">
                            無警示
                        </label>
                    </div>

                    <div class="title">連續七天累積用水量</div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio2" id="radio2" value="4">
                        <label class="form-check-label" for="radio2">
                            較上週增加30%(含)以上
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio2" id="radio3" value="9">
                        <label class="form-check-label" for="radio3">
                            較上週增加50%(含)以上
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio2" id="radio4" value="10">
                        <label class="form-check-label" for="radio4">
                            較最近一月的週平均用水量突增30%(含)以上
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio2" id="radio5" value="11">
                        <label class="form-check-label" for="radio5">
                            較最近一月的週平均用水量突增50%(含)以上
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio2" id="radio5" value="12">
                        <label class="row m-0" for="radio5">
                            較上週增加
                            <div class="col-auto">
                                <input type="text" class="form-control" id="AlertExtion2">
                                 <span class="text-danger" id="dangerAlertExtion2"></span>
                            </div>
                            度(含)以上(可自行輸入，惟至少50度以上)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio2" id="radio6" value="13">
                        <label class="form-check-label" for="radio6">
                            較去年同期突增30%(含)以上
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio2" id="radio7" value="14">
                        <label class="form-check-label" for="radio7">
                            較去年同期突增50%(含)以上
                        </label>
                    </div>
                    <div class="title">連續三十天累積用水量</div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio3" id="radio8" value="7">
                        <label class="form-check-label" for="radio8">
                            較去年同期突增30%(含)以上
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio3" id="radio9" value="8">
                        <label class="form-check-label" for="radio9">
                            較去年同期突增50%(含)以上
                        </label>
                    </div>
                </div>
            </form>
            <div class="btnGroup">
                <a class="btn-green-o" href="javascript:" onclick="BtnSave()">儲存</a>
                <a class="btn-lightGrey-o" href="javascript:" onclick="BtnReset()">重填</a>
            </div>
        </div>
    </div>
</div><!-- wrap end -->
