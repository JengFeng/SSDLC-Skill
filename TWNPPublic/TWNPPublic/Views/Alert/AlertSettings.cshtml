    function btnSwitchSetAlertWaterNo(obj){
        $(".btn-alertsetSwithch").removeClass("btn-green-o-hover");
        $(obj).addClass("btn-green-o-hover");
        ResetAllSet();
        GetAlertSetFromWaterNo($(obj).data('waterno'));
    }

    function BtnReset(){
        history.go(0);
    }
