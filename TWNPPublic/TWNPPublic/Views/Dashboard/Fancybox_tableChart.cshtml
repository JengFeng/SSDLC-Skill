<script>
    function btnJumpTime(obj) {
        let Jempdata = $(obj).val();
        window.location.href = GetWebSiteURL('@Url.Action("Fancybox_tableChart", "Dashboard")?Cdate=') + Jempdata;
    }

    function UpdateNote(obj) {
        var getNoteArea = $('#textNote' + obj);
        getNoteArea.find('.info>span').hide();
        getNoteArea.find('.info>textarea').show();
        getNoteArea.find('.btnsave').show();
        getNoteArea.find('.btncancel').show();
        getNoteArea.find('.btnUpdate').hide();
    }

    function Cancel(obj) {
        var getNoteArea = $('#textNote' + obj);
        getNoteArea.find('span').show();
        getNoteArea.find('textarea').hide();
        getNoteArea.find('.btnsave').hide();
        getNoteArea.find('.btncancel').hide();
        getNoteArea.find('.btnUpdate').show();
    }

    function SaveNote(obj) {
        var getNoteArea = $('#textNote' + obj);
        let url = GetWebSiteURL('@Url.Action("UpdateHourNote", "Dashboard")');
        let model = {
            NoteSN: @ViewBag.NoteSN,
            Hour: obj,
            Msg: getNoteArea.find('textarea').val(),
            ADate: $("#tbJumpTime").val()
        };
        $.post(url, model, function (data) {
            if (data.Success) {
                alert(data.Message);
                getNoteArea.find('span').text(model.Msg);
                getNoteArea.find('span').show();
                getNoteArea.find('textarea').hide();
                getNoteArea.find('.btnsave').hide();
                getNoteArea.find('.btncancel').hide();
                getNoteArea.find('.btnUpdate').show();
                history.go(0);
            }
            else {
                alert(data.Message);
            }
        });
    }

    function ChangePage(obj) {
        switch (obj) {
            case 'last':
                window.location.href = GetWebSiteURL('@Url.Action("Fancybox_tableChart", "Dashboard", new { Cdate = Cdate.AddDays(-1).ToString("yyyy-MM-dd") })');
                break;
            case 'next':
                window.location.href = GetWebSiteURL('@Url.Action("Fancybox_tableChart", "Dashboard", new { Cdate = Cdate.AddDays(1).ToString("yyyy-MM-dd") })');
                break;
        }
    }

    var myChart = echarts.init(document.getElementById('mychart'));

    window.onresize = function () {
        myChart.resize();
    };

    $(function () {
        LoadChart();
    });
</script>
