@using TWNPPublic.Models.Entity
@using System.Globalization;
@{
    ViewData["Title"] = "目前指針詳細資料";
    Layout = "~/Views/Shared/_Layout_Fancybox.cshtml";
    var Cdate = (DateTime)ViewBag.Cdate;
    CultureInfo culture = new CultureInfo("zh-TW");
    culture.DateTimeFormat.Calendar = new TaiwanCalendar();
    string RocTime = Cdate.ToString("yyy年MM月dd日", culture);
    var HourNotes = (List<B_NOTE_HOUR>)ViewBag.HourNotes;
}
@section echart{
<script type="text/javascript" src="~/js/echarts/echarts.js"></script>
}
<script>
    $(function(){
        var searchAreaInlineHeight = $(".searchAreaInline")[0].clientHeight;
        var total = searchAreaInlineHeight;
        $('.chartTableGroup').css('height','calc(100% - {total}px)'.replace('{total}',total));
    });
    $(function(){
        var chartsTitleHeightHeight = $(".chartsTitleHeight")[0].clientHeight;
        var total = chartsTitleHeightHeight;
        $('.chartBox').css('height','calc(100% - {total}px)'.replace('{total}',total));
    });
    $(function(){
        $(".videoScroll,.chartsScroll").mCustomScrollbar({
            autoHideScrollbar:true,
            advanced:{
                updateOnContentResize: true,
                updateOnImageLoad: false
            },
            theme:"minimal-dark",
                mouseWheel:{ preventDefault:true }
        });
        $(".videoScroll,.chartsScroll").mCustomScrollbar("update");
    });
    function LoadChart(){
        var model = {
            Cdate :$("#divWaterUserSearchChartTitle").data("themeswitchchart")
            };
        $.post("@Url.Action("WaterNoteTableChart","Dashboard")", model ,function(result){
            $("#spanError").text('');
            if(result.Success){
                const colors = ['#5391C7'];
                var option;
                option = {
                    color: colors,
                    tooltip: {
                        trigger: 'axis',
                        axisPointer: {
                            type: 'cross'
                        }
                    },
                    grid: {
                        bottom:80
                    },
                    toolbox: {
                        show: true,
                        feature: {
                            saveAsImage: {}
                        }
                    },
                    legend: {
                       y:'top',
                        x:'left',
                        data: ["用水量趨勢"]
                    },
                    xAxis: {
                        axisLabel:{
                            rotate:result.Data.Rotate
                        },
                        name: '時間',
                        type: 'category',
                        data: result.Data.X
                    },
                    yAxis: {
                        type: 'value',
                        axisLine: {
                            show: true,
                            lineStyle: {
                                color: colors[0]
                            }
                        },
                        axisLabel: {formatter: '{value} 度'}
                    },
                    series: [
                        {
                            name: '用水量趨勢',
                            type: 'line',
                            data:  result.Data.Y
                        },
                        {
                          name: '移動上界',
                          type: 'line',
                          data: result.Data.Ymax,
                          lineStyle: {
                            opacity: 0
                          },
                          areaStyle: {
                            color: '#ccc'
                          },
                          stack: 'confidence-band',
                          symbol: 'none'
                        },
                        {
                          name: '移動下界',
                          type: 'line',
                          data: result.Data.Ymin,
                          lineStyle: {
                            opacity: 0
                          },
                          areaStyle: {
                            color: '#ccc'
                          },
                          stack: 'confidence-band',
                          symbol: 'none'
                        }]
                };
                option && myChart.setOption(option);
            }
            else{
                $("#spanError").text('此時間段尚無資料');
                myChart.clear();
            }
        });
    }
</script>
<div class="wrap-page">
    <div class="searchAreaInline">
        <div class="unitTitle">
            用戶記事
        </div>
    </div><!-- searchAreaInline end -->
    <div class="chartTableGroup">
        <div class="main videoScroll">
            <table class="footable green" data-empty="尚無資料">
                <thead>
                    <tr>
                        <th>時間</th>
                        <th>估算用水量(度)</th>
                        <th data-breakpoints="xs sm">較前日突增減(%)</th>
                        <th data-breakpoints="xs sm">用水記事</th>
                    </tr>
                </thead>
                <tbody>
                    @if (HourNotes != null)
                    {

                        foreach (var item in HourNotes)
                        {
                            var TimeSource = String.Format("{0:00}", item.A_HOUR);
                            <tr>
                                <td>@(TimeSource):00</td>
                                <td>@item.AMOUNT</td>
                                <td>@item.APERCENT</td>
                                <td class="text-red">
                                    <div class="tdflex"  id="textNote@(TimeSource)">
                                        <div class="info">
                                            <span>@item.NOTE</span>
                                            <textarea class="form-control" style="display: none;">@item.NOTE</textarea>
                                        </div>
                                        <a class="btn-green-o btnsave" href="javascript:;" onclick="SaveNote('@(TimeSource)')" style="display: none;">確認</a>
                                        <a class="btn-green-o btncancel" href="javascript:;" onclick="Cancel('@(TimeSource)')" style="display: none;">取消</a>
                                        <a class="btn-green-o btnUpdate" href="javascript:;" onclick="UpdateNote('@(TimeSource)')">修改</a>
                                    </div>
                                </td>
@*

                                <td class="text-red" id="textNote@(TimeSource)">
                                    <span>@item.NOTE</span>
                                    <textarea class="form-control" style="display: none;">@item.NOTE</textarea>
