        </div>
        <div class="main">
            <div class="chartBlock">
                <div class="searchAreaInline chartsTitleHeight">
                    <div class="unitTitle">
                        用戶水率
                    </div>
                    <div class="themeSwitch">
                        <a class="btn-green-o-line" href="javascript:;" onclick="ChangePage('last')"><i class="bi bi-chevron-left"></i></a>
                        <div class="name"
                             id="divWaterUserSearchChartTitle"
                             data-themeswitchchart="@DateTime.Now.ToString("yyyy/MM/dd")">
                            @(RocTime)當周用水量
                        </div>
                        <a class="btn-green-o-line" href="javascript:;" onclick="ChangePage('next')"><i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
                <div class="chartBox">
                    <span id="spanError">此時間段尚無資料</span>
                    <div class="pagechartGroup" id="mychart" style="width:100%;height:600px">
                    </div>
                </div>
            </div>
        </div><!-- main end -->
    </div>

</div><!-- wrap end -->
<script>
    function UpdateNote(obj){
        var getNoteArea = $('#textNote' + obj);
        getNoteArea.find('.info>span').hide();
        getNoteArea.find('.info>textarea').show();
        getNoteArea.find('.btnsave').show();
        getNoteArea.find('.btncancel').show();
        getNoteArea.find('.btnUpdate').hide();
    }

    function Cancel(obj){
        var getNoteArea = $('#textNote' + obj);
        getNoteArea.find('span').show();
        getNoteArea.find('textarea').hide();
        getNoteArea.find('.btnsave').hide();
        getNoteArea.find('.btncancel').hide();
        getNoteArea.find('.btnUpdate').show();
    }

    function SaveNote(obj){
        var getNoteArea = $('#textNote' + obj);
        let url = "@Url.Action("UpdateHourNote","Dashboard")";
        let model = {
            NoteSN : @ViewBag.NoteSN,
            Hour : obj,
            Msg : getNoteArea.find('textarea').val()
        };
        $.post(url,model,function(data){
            if(data.Success){
                alert(data.Message);
                getNoteArea.find('span').text(model.Msg);
                getNoteArea.find('span').show();
                getNoteArea.find('textarea').hide();
                getNoteArea.find('.btnsave').hide();
                getNoteArea.find('.btncancel').hide();
                getNoteArea.find('.btnUpdate').show();
            }
            else{
                alert(data.Message);
            }
        });
    }

    function ChangePage(obj){
        switch(obj)
        {
            case 'last':
                window.location.href = "@Url.Action("Fancybox_tableChart","Dashboard",new{ Cdate =  Cdate.AddDays(-1).ToString("yyyy-MM-dd") })";
            break;
            case 'next':
                window.location.href = "@Url.Action("Fancybox_tableChart","Dashboard",new{ Cdate =  Cdate.AddDays(1).ToString("yyyy-MM-dd") })";
            break;
        }
    }

    var myChart = echarts.init(document.getElementById('mychart'));

        window.onresize = function() {
        myChart.resize();
    };

    $(function(){
         LoadChart();
    });
</script>