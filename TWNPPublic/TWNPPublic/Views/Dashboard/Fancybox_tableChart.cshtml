@using TWNPPublic.Models.Entity
@using System.Globalization;
@using TWNPPublic.Common.Extension
@inject IAspNetUser aspNetUser
@{
    ViewData["Title"] = "目前指針詳細資料";
    Layout = "~/Views/Shared/_Layout_Fancybox.cshtml";
    var Cdate = (DateTime)ViewBag.Cdate;
    CultureInfo culture = new CultureInfo("zh-TW");
    culture.DateTimeFormat.Calendar = new TaiwanCalendar();
    string RocTime = Cdate.ToString("yyy年MM月dd日", culture);
    var HourNotes = (List<B_NOTE_HOUR>)ViewBag.HourNotes;
}
@section echart{
    <script type="text/javascript" src="~/js/echarts/echarts.js"></script>
}
    <script>
        $(function () {
            var searchAreaInlineHeight = $(".searchAreaInline")[0].clientHeight;
            var total = searchAreaInlineHeight;
            $('.chartTableGroup').css('height', 'calc(100% - {total}px)'.replace('{total}', total));
        });
        $(function () {
            var chartsTitleHeightHeight = $(".chartsTitleHeight")[0].clientHeight;
            var total = chartsTitleHeightHeight;
            $('.chartBox').css('height', 'calc(100% - {total}px)'.replace('{total}', total));
        });
        $(function () {
            $(".videoScroll,.chartsScroll").mCustomScrollbar({
                autoHideScrollbar: true,
                advanced: {
                    updateOnContentResize: true,
                    updateOnImageLoad: false
                },
                theme: "minimal-dark",
                mouseWheel: { preventDefault: true }
            });
            $(".videoScroll,.chartsScroll").mCustomScrollbar("update");
        });

        roundDown = function (num, decimal) { return Math.floor((num + Number.EPSILON) * Math.pow(10, decimal)) / Math.pow(10, decimal); }

        function LoadChart() {
            var model = {
                Cdate: $("#divWaterUserSearchChartTitle").data("themeswitchchart")
            };

            let total = 0;

            $.post("@Url.Action("WaterNoteTableChart","Dashboard")", model, function (result) {
                $("#spanError").text('');
                if (result.Success) {
                    const colors = ['#5391C7'];
                    var option;
                    option = {
                        color: colors,
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: {
                                type: 'cross'
                            }
                        },
                        grid: {
                            bottom: 80
                        },
                        toolbox: {
                            show: true,
                            feature: {
                                saveAsImage: { title: "另存圖片" }
                            }
                        },
                        legend: {
                            y: 'top',
                            x: 'middle',
                            data: ["用水量趨勢"]
                        },
                        xAxis: {
                            nameGap: 25,
                            nameLocation: 'center',
                            name: '時間(小時)',
                            type: 'category',
                            data: result.Data.X
                        },
                        yAxis: {
                            nameLocation: 'center',
                            nameGap: 25,
                            nameRotate: 360,
                            name: '用 \n 水 \n 量 \n ︵ \n 度 \n ︶ \n',
                            type: 'value',
                            axisLine: {
                                show: true,
                                lineStyle: {
                                    color: colors[0]
                                }
                            },
                            axisLabel: { formatter: '{value}' }
                        },
                        series: [
                            {
                                name: '用水量趨勢',
                                type: 'line',
                                data: result.Data.Y
                            }
                        ]
                    };

                    result.Data.Y.forEach((item, index) => $('#maintable tbody tr:eq(' + index + ') td:eq(2)').html(item));
                    result.Data.O.forEach((item, index) => $('#maintable tbody tr:eq(' + index + ') td:eq(1)').html(item));
                    result.Data.Y.forEach((item) => { total += item });

                    total = roundDown(total, 2);

                    $("#totalCounter").text(`${total}`);

                    option && myChart.setOption(option);
                }
                else {
                    $("#spanError").text('此時間段尚無資料');
                    myChart.clear();
                }
                $(".footable").footable();
            });
        }
    </script>
    <div class="wrap-page">
        <div class="searchAreaInline">
            <div class="unitTitle">
                用戶記事
            </div>
        </div><!-- searchAreaInline end -->
        <div class="chartTableGroup">
            <div class="main videoScroll">
                <table class="footable green" data-empty="尚無資料" id="maintable">
                    <thead>
                        <tr>
                            <th>時間</th>
                            <th>指針數讀值</th>
                            <th>用水量</th>
                            <th data-breakpoints="xs sm">用水記事</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (HourNotes != null)
                    {
                        foreach (var item in HourNotes)
                        {
                            var TimeSource = String.Format("{0:00}", item.A_HOUR);
                            <tr>
                                <td>@(TimeSource):00</td>
                                <td></td>
                                <td></td>
                                <td class="text-red">
                                    <div class="tdflex" id="textNote@(TimeSource)">
                                        <div class="info col-lg-6">
                                            <span>@item.NOTE</span>
                                            <textarea class="form-control" style="display: none;">@item.NOTE</textarea>
                                        </div>
                                        <a class="btn-green-o btnsave" href="javascript:;" onclick="SaveNote('@(TimeSource)')" style="display: none;">確認</a>
                                        <a class="btn-green-o btncancel" href="javascript:;" onclick="Cancel('@(TimeSource)')" style="display: none;">取消</a>
                                        <a class="btn-green-o btnUpdate" href="javascript:;" onclick="UpdateNote('@(TimeSource)')">修改</a>
                                    </div>
                                </td>
                                @* <td class="text-red" id="textNote@(TimeSource)">
                        <span>@item.NOTE</span>
                        <textarea class="form-control" style="display: none;">@item.NOTE</textarea>
                        <a class="btn-green-o btnsave" href="javascript:;" onclick="SaveNote('@(TimeSource)')" style="display: none;">確認</a>
                        <a class="btn-green-o btncancel" href="javascript:;" onclick="Cancel('@(TimeSource)')" style="display: none;">取消</a>
                        <a class="btn-green-o btnUpdate" href="javascript:;" onclick="UpdateNote('@(TimeSource)')">修改</a>
                        </td>*@
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="text-center">
                            合計共
                        </td>
                        <td>
                            &nbsp;
                        </td>
                        <td>
                            <span id="totalCounter"></span>
                        </td>
                        <td>
                            &nbsp;
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="main">
            <div class="chartBlock">
                <div class="searchAreaInline chartsTitleHeight">
                    <div class="unitTitle">
                        用水量趨勢圖
                    </div>
                    <div class="themeSwitch">
                        <a class="btn-green-o-line" href="javascript:;" onclick="ChangePage('last')"><i class="bi bi-chevron-left"></i></a>
                        <div class="row p-2 align-items-center"
                             id="divWaterUserSearchChartTitle"
                             data-themeswitchchart="@Cdate.ToString("yyyy/MM/dd")">
                            @* @(RocTime)*@
                            <div class="col-auto">
                                <input type="date" value="@Cdate.ToString("yyyy-MM-dd")" onchange="btnJumpTime(this)"
                                       id="tbJumpTime" class="form-control" />
                            </div>
                            <div class="name col-auto">
                                當日用水量
                            </div>
                        </div>
                        <a class="btn-green-o-line" href="javascript:;" onclick="ChangePage('next')"><i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
                <div class="chartBox">
                    <span id="spanError">資料載入中</span>
                    <div class="pagechartGroup" id="mychart" style="width:100%;height:600px">
                    </div>
                </div>
            </div>
        </div><!-- main end -->
    </div>
</div><!-- wrap end -->
<script>
    function btnJumpTime(obj) {
        let Jempdata = $(obj).val();
        window.location.href = "@Url.Action("Fancybox_tableChart","Dashboard")?Cdate=" + Jempdata;
    }

    function UpdateNote(obj) {
        var getNoteArea = $('#textNote' + obj);
        getNoteArea.find('.info>span').hide();
        getNoteArea.find('.info>textarea').show();
        getNoteArea.find('.btnsave').show();
        getNoteArea.find('.btncancel').show();
        getNoteArea.find('.btnUpdate').hide();
    }

    function Cancel(obj) {
        var getNoteArea = $('#textNote' + obj);
        getNoteArea.find('span').show();
        getNoteArea.find('textarea').hide();
        getNoteArea.find('.btnsave').hide();
        getNoteArea.find('.btncancel').hide();
        getNoteArea.find('.btnUpdate').show();
    }

    function SaveNote(obj) {
        var getNoteArea = $('#textNote' + obj);
        let url = "@Url.Action("UpdateHourNote","Dashboard")";
        let model = {
            NoteSN: @ViewBag.NoteSN,
            Hour: obj,
            Msg: getNoteArea.find('textarea').val(),
            ADate: $("#tbJumpTime").val()
        };
        $.post(url, model, function (data) {
            if (data.Success) {
                alert(data.Message);
                getNoteArea.find('span').text(model.Msg);
                getNoteArea.find('span').show();
                getNoteArea.find('textarea').hide();
                getNoteArea.find('.btnsave').hide();
                getNoteArea.find('.btncancel').hide();
                getNoteArea.find('.btnUpdate').show();
                history.go(0);
            }
            else {
                alert(data.Message);
            }
        });
    }

    function ChangePage(obj) {
        switch (obj) {
            case 'last':
                window.location.href = "@Url.Action("Fancybox_tableChart","Dashboard",new{ Cdate =  Cdate.AddDays(-1).ToString("yyyy-MM-dd") })";
                break;
            case 'next':
                window.location.href = "@Url.Action("Fancybox_tableChart","Dashboard",new{ Cdate =  Cdate.AddDays(1).ToString("yyyy-MM-dd") })";
                break;
        }
    }

    var myChart = echarts.init(document.getElementById('mychart'));

    window.onresize = function () {
        myChart.resize();
    };

    $(function () {
        LoadChart();
    });
</script>
