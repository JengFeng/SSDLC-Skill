@{
    ViewData["Title"] = "用水情形分析";
    Layout = "~/Views/Shared/_Layout_Fancybox.cshtml";
}
@section echart{
<script type="text/javascript" src="~/js/echarts/echarts.js"></script>
}
<script>

    $(function () {
        var width = $('#divpagechartGroup').width();
        var height = $('#divpagechartGroup').height();
        $("#WaterUserAnalyzer").css("width", width);
        $("#WaterUserAnalyzer").css("height", height);
        LoadAnalyzeChart();
    });

    function btnSwitchTimesplit(obj){
        $(obj).addClass("active").siblings().removeClass("active");
        LoadChart();
    }

    function LoadChart(obj){
        //時間切割粒度
        let timesplit = $(".timesplit.btn-green-o.active").data("timesplit");
        //先抓中間的舊的時間
        var currenttime = $("#divWaterUserSearchChartTitle").data('themeswitchchart');
        switch(timesplit){
            case 'day':
            $("#divWaterUserSearchChartTitle").text(currenttime + '當日用水分析預測');
            break;
            case 'week':
            $("#divWaterUserSearchChartTitle").text(currenttime + '當週用水分析預測');
            break;
            case 'month':
            $("#divWaterUserSearchChartTitle").text(currenttime + '當月用水分析預測');
            break;
            default:
                alert('未合法的時間單位')
            return;
        }
        LoadAnalyzeChart();
    }

</script>
<script>
$(function(){
	var searchAreaInlineHeight = $(".searchAreaInline")[0].clientHeight;
	var total = searchAreaInlineHeight;
	$('.version1').css('height','calc(100% - {total}px)'.replace('{total}',total));
});
$(function(){
    $(".videoScroll").mCustomScrollbar({
        autoHideScrollbar:true,
        advanced:{
            updateOnContentResize: true,
            updateOnImageLoad: false
        },
        theme:"minimal-dark",
            mouseWheel:{ preventDefault:true }
    });
    $(".videoScroll").mCustomScrollbar("update");
});

</script>
<style>
.pagechartGroup > div{
    height:inherit;
}
    .mCSB_container{
    height:inherit;

    }
</style>

<div class="wrap-page">
    <div class="searchAreaInline">
        <div class="unitTitle">
            用水分析預測
        </div>
        <div class="cycleGroup">
            <a class="timesplit btn-green-o" data-timesplit="day" onclick="btnSwitchTimesplit(this)" href="javascript:;">日</a>
            <a class="timesplit btn-green-o active" data-timesplit="week" onclick="btnSwitchTimesplit(this)" href="javascript:;">週</a>
            <a class="timesplit btn-green-o" data-timesplit="month" onclick="btnSwitchTimesplit(this)" href="javascript:;">月</a>
        </div>
        <div class="themeSwitch">
            <div class="name"
                 id="divWaterUserSearchChartTitle"
                 data-themeswitchchart="@ViewBag.CurrentTime">
                @ViewBag.CurrentTimeTW 當周用水分析預測
            </div>
        </div>
    </div><!-- searchAreaInline end -->
    <div class="version1">
        <div class="main videoScroll">
            <span id="spanAlert"></span>
                <div id="divpagechartGroup" style="width:100%; height:100%;"></div>
            </div>
        </div>
    </div><!-- main end -->
</div><!-- wrap end -->
<!-- 六個狀態色碼
    .circularRed{ border-color: #FF0000; }
    .circularGrey{ border-color: #B7B9C0; }
    .circularOrange{ border-color: #FEAD54; }
    .circularBlue{ border-color: #5391C7; }
    .circularGreen{ border-color: #089BAB; }
    .circularLightGreen{ border-color: #85F9B6;}
-->

<script>

    var chartDom = document.getElementById('divpagechartGroup');
    var myChart = echarts.init(chartDom);

    function LoadAnalyzeChart(){
        let model = {
            timespilt:$(".timesplit.btn-green-o.active").data("timesplit"),
            Cdate:$("#divWaterUserSearchChartTitle").data('themeswitchchart')
        };
        let url = "@Url.Action("LoadWaterUseAnalyzer","Dashboard")";
        var option
        $.get(url,model,function(data){
            $("#spanAlert").text('');
            if(data.Data.alert != ''){
                $("#spanAlert").text(data.Data.alert);
            }

            option ={
              tooltip: {
                trigger: 'axis',
                axisPointer: {
                  type: 'cross',
                  crossStyle: {
                    color: '#999'
                  }
                }
              },
              legend: {
                orient: 'horizontal',
                top: 10,
                data: ["去年同期用水趨勢","本期用水趨勢","去年同期觀光人次"]
              },
              xAxis: {
                type: 'category',
                data: data.Data.X
              },
              yAxis: [
                {
                    type: 'value',
                    name: '用水趨勢',
                    position: 'left',
                    alignTicks: true,
                    axisLine: {
                        show: true,
                    },
                    axisLabel: {formatter: '{value} 度數'}
                },
                {
                    type: 'value',
                    name: '觀光人次',
                    position: 'right',
                    alignTicks: true,
                    axisLine: {
                        show: true,
                    },
                    axisLabel: {formatter: '{value} 人次'}
                }
              ],
              series: [
                {
                  name: '去年同期用水趨勢',
                  data: data.Data.Ynextyear,
                  type: 'line',
                  smooth: true
                },
                {
                  name: '本期用水趨勢',
                  data: data.Data.Ythisyear,
                  type: 'line',
                  smooth: true
                },
                {
                  name: '去年同期觀光人次',
                  yAxisIndex: 1,
                  data: [50, 50, 50, 50, 35, 47, 60],
                  type: 'line',
                  smooth: true
                }
              ]
            };
            option && myChart.setOption(option);
        });
    }

    window.onresize = function() {
      myChart.resize();
    };

</script>
