    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "用水量趨勢圖";
    Layout = "~/Views/Shared/_Layout_Fancybox.cshtml";
}
@section echart{
<script type="text/javascript" src="~/js/echarts/echarts.js"></script>
}

<div class="wrap-page">
    <div class="searchAreaInline">
        <div class="unitTitle">
            用水量趨勢圖
        </div>
        <div class="themeSwitch">
            <a class="btn-green-o-line"
               href="javascript:;"
               id="LeftSwitchChart"
               data-themeswitchchart="@DateTime.Now.AddDays(-7).ToString("yyyy/MM/dd")"
               data-switcher="last"
               title="@DateTime.Now.AddDays(-7).ToString("yyyy/MM/dd")"
               onclick="btnSwitchWaterSearch(this)">
                <i class="bi bi-chevron-left"></i>
            </a>
            <div class="name"
                 id="divWaterUserSearchChartTitle"
                 data-themeswitchchart="@ViewBag.Cdate">
                @(ViewBag.Cdate)當日用水量
            </div>
            <a class="btn-green-o-line"
               href="javascript:;"
               id="RightSwitchChart"
               data-switcher="next"
               data-themeswitchchart="@DateTime.Now.AddDays(7).ToString("yyyy/MM/dd")"
               title="@DateTime.Now.AddDays(7).ToString("yyyy/MM/dd")"
               onclick="btnSwitchWaterSearch(this)">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div><!-- searchAreaInline end -->
    <div class="version1">
        <div class="main videoScroll">
            <span id="spanError">此時間段尚無資料</span>
            <div class="pagechartGroup" id="mychart" style="width:100%;height:600px">
            </div>
        </div>
    </div><!-- main end -->
</div><!-- wrap end -->


<script>
    $(function () {
        LoadChart();
    });

    window.onresize = function() {
        myChart.resize();
    };

    var myChart = echarts.init(document.getElementById('mychart'));

    function LoadChart(){
         var model = {
            Cdate :$("#divWaterUserSearchChartTitle").data("themeswitchchart")
         };
        $.post(GetWebSiteURL('@Url.Action("ModalBarchart", "Dashboard")'), model ,function(result){
            $("#spanError").text('');
            if(result.Success){
                const colors = ['#5391C7'];
                var option;
                option = {
                    color: colors,
                    tooltip: {
                        trigger: 'axis',
                        axisPointer: {
                            type: 'cross'
                        }
                    },
                    toolbox: {
                        show: true,
                        feature: {
                            saveAsImage: {title: "另存圖片"}
                        }
                    },
                    grid: {
                        right:'5%',
                        left:'5%',
                        bottom:'15%'
                    },
                    legend: {
                        orient: 'horizontal',
                        top: 10,
                        data: ["用水量分析"]
                    },
                    xAxis: {
                        name: result.Data.XrayUnit,
                        type: 'category',
                        data: result.Data.X,
                        nameTextStyle: {
                             fontSize: 20,
                             padding: 0
                        },
                        nameLocation: 'middle',
                        nameGap: 50
                    },
                    yAxis: {
                        name:' 用水量(度)',
                        type: 'value',
                        axisLine: {
                            show: true,
                            lineStyle: {
                                color: colors[0]
                            }
                        },
                        nameTextStyle: {
                             fontSize: 20
                        },
                        nameLocation: 'center',
                        nameGap: 45,
                        nameRotate : 360,
                        name:'用 \n 水 \n 量 \n ︵ \n 度 \n ︶ \n',
                        axisLabel: {
                            fontSize: 18,
                            formatter: '{value}'
                        }
                    },
                    series: [{
                        name: '用水量分析',
                        type: 'line',
                        data:  result.Data.Y
                    }]
                };
                option && myChart.setOption(option);
            }
            else{
                $("#spanError").text('此時間段尚無資料');
                myChart.clear();
            }
        });
    }

    function btnSwitchWaterSearch(obj){
        var switcher = $(obj).data('switcher');
        let datechange;
        var current = $('#divWaterUserSearchChartTitle').data('themeswitchchart');
        var currentTime = new Date(current);
        switch(switcher){
            case 'next':
                datechange = DataFormatPaser(currentTime.setDate(currentTime .getDate()+1));
                $('#divWaterUserSearchChartTitle').data('themeswitchchart',datechange);
                $('#divWaterUserSearchChartTitle').text(datechange + '當周用水量');
            break;
            case 'last':
                datechange = DataFormatPaser(currentTime.setDate(currentTime .getDate()-1));
                $('#divWaterUserSearchChartTitle').data('themeswitchchart',datechange);
                $('#divWaterUserSearchChartTitle').text(datechange + '當周用水量');
            break;
        }
        LoadChart();
    }

    //用水量查詢用日期轉換
    function DataFormatPaser(origindate){
        var odate = new Date(origindate);
        var dd = (odate.getDate() + 1 <= 10 ? '0' : '') + (odate.getDate());
        var mm = (odate.getMonth() + 1 <= 10 ? '0' : '') + (odate.getMonth() + 1);
        var y = odate.getFullYear();
        return y + '/' + mm + '/' + dd;
    }
</script>