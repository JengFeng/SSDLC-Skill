<!-- 圖台頁面 1 -->
<div class="mapGroup" id="map"></div>
<!--右下角圖層功能控制-->
<ul class="menuSettingBox maplayerSetting">
	<li><a href="javascript:;" class="menuBoxBtn layerSettingBtn active" title="圖層設定"></a></li>
	<li><a href="javascript:;" class="menuBoxBtn gpsSettingBtn" title="定位點查詢" onclick="Layer1.locateGps();"></a></li>
</ul><!-- 圖層開關 -->
<script type="text/javascript" src="~/js/EzMap.js"></script>
<script type="text/javascript">
    var map = null;
    (function(){
        MapInit(map, 'map');
        LayerMapInit1(() => { 
            Layer1.hideBtn('layer');            // 隱藏圖層按鈕
            $(LayerTree1.elm.boxWindow).hide(); // 隱藏圖層視窗
            Layer1.renderCurrentAddress();      // 顯示目前水號位置
        });
    })();

    function LayerMapInit1(callback) {
        if (callback === undefined) return;
        var intervalLayer1 = setInterval(() => {
            if (Layer1 === null) return;
            if ($(Layer1.boxLayerId).length > 0 && (LayerTree1 === null || !LayerTree1.inited)) return;
            clearInterval(intervalLayer1);
            setTimeout(()=>{ callback.apply(); }, 500);
        }, 500);
    }

    //# 取得地址轉坐標服務
	if (typeof (GetAddressCoordinate) === 'undefined') 
		function GetAddressCoordinate(address){
            var param = (address != undefined && address != null ? '?address=' + address : '');
            return '@Url.Action("GetAddressCoordinate", "Layer")' + param;
		}

    function GetCurrentAddressUrl() { 
        return '@Url.Action("GetCurrentAddress","Dashboard")';
    }   // 取得目前水號地址 Api
</script>
