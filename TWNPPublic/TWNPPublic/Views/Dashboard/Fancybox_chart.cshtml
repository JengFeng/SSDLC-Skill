@{
    ViewData["Title"] = "用水情形分析";
    Layout = "~/Views/Shared/_Layout_Fancybox.cshtml";
}
@section echart{
<script type="text/javascript" src="/js/echarts/echarts.js"></script>
}

<div class="wrap-page">
    <div class="searchAreaInline">
        <div class="unitTitle">
            用水情形分析
        </div>
        <div class="cycleGroup">
            <a class="btn-green-o active" href="javascript:;">日</a>
            <a class="btn-green-o" href="javascript:;">周</a>
            <a class="btn-green-o" href="javascript:;">月</a>
        </div>
        <div class="themeSwitch">
            <a class="btn-green-o-line" href="javascript:;" data-lasttime="@DateTime.Now.AddDays(-7).ToString("yyyy-MM-dd")" onclick="btnThemeSwitch(this)"><i class="bi bi-chevron-left"></i></a>
            <div class="name">@(ViewBag.CurrentTime)當周用水量</div>
            <a class="btn-green-o-line" href="javascript:;" data-nexttime="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" onclick="btnThemeSwitch(this)"><i class="bi bi-chevron-right"></i></a>
        </div>
    </div><!-- searchAreaInline end -->
    <div class="version1">
        <div class="main videoScroll">
            <div class="pagechartGroup" id="divpagechartGroup" style="width:100%;height:500px">              
            </div>
        </div>
    </div><!-- main end -->
</div><!-- wrap end -->
<!-- 六個狀態色碼
    .circularRed{ border-color: #FF0000; }
    .circularGrey{ border-color: #B7B9C0; }
    .circularOrange{ border-color: #FEAD54; }
    .circularBlue{ border-color: #5391C7; }
    .circularGreen{ border-color: #089BAB; }
    .circularLightGreen{ border-color: #85F9B6;}
-->    

<script>
    var chartDom = document.getElementById('divpagechartGroup');
    var myChart = echarts.init(chartDom);
    var option;

    option = {
      xAxis: {
        type: 'category',
        data: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
      },
      yAxis: {
        type: 'value'
      },
      series: [
        {
          data: [150, 230, 224, 218, 135, 147, 260],
          type: 'line'
        }
      ]
    };

    option && myChart.setOption(option);

    window.onresize = function() {
      myChart.resize();
    };

    function btnThemeSwitch(){

    }
</script>