@{
    ViewData["Title"] = "用水情形分析";
    Layout = "~/Views/Shared/_Layout_Fancybox.cshtml";
}
@section echart{
<script type="text/javascript" src="~/js/echarts/echarts.js"></script>
}
<script>
    $(function(){
        var searchAreaInlineHeight = $(".searchAreaInline")[0].clientHeight;
        var total = searchAreaInlineHeight;
        $('.version1').css('height','calc(100% - {total}px)'.replace('{total}',total));
    });
    $(function(){
        $(".videoScroll").mCustomScrollbar({
            autoHideScrollbar:true,
            advanced:{
                updateOnContentResize: true,
                updateOnImageLoad: false
            },
            theme:"minimal-dark",
                mouseWheel:{ preventDefault:true }
        });
        $(".videoScroll").mCustomScrollbar("update");
    });

</script>
<script>
    $(function(){
        LoadChart();
        LoadFakeTimeline();
    });

    function btnSwitchTimesplit(obj){
        $(obj).addClass("active").siblings().removeClass("active");
        LoadChart();
    }

    //上面的按鈕
    function btnSwitchWaterSearch(obj){
        //時間切割粒度
        var timesplit = $(".timesplit.btn-green-o.active").data("timesplit");
        //先抓中間的舊的時間
        var oldmiddle = new Date($("#divWaterUserSearchChartTitle").data('themeswitchchart'));
        //在看往左還是往右
        //正負號
        var SetTimeStage = 0;
        switch($(obj).data('switcher')){
            case 'next':
                SetTimeStage = 1;
            break;
            case 'last':
                SetTimeStage = -1;
            break;
        }

        switch(timesplit){
            case 'day':
                oldmiddle = DataFormatPaser(oldmiddle.setDate(oldmiddle.getDate()+1*SetTimeStage));
            break;
            case 'week':
                var test =  DataFormatPaser(oldmiddle.setDate(oldmiddle.getDate()+(7*SetTimeStage)))
                oldmiddle = test;
            break;
            case 'month':
                oldmiddle = DataFormatPaser(oldmiddle.setMonth(oldmiddle.getMonth()+1*SetTimeStage));
            break;
            default:
                alert('未合法的時間單位')
            return;
        }

        //新的中間的時間
        var middledate = oldmiddle;
        //左邊的時間
        var leftdate = new Date(middledate);
        var setleftdate ="";
        //右邊的時間
        var rightdate = new Date(middledate);
        var setrightdate =""

        switch(timesplit){
            case 'day':
                setleftdate = DataFormatPaser(leftdate.setDate(leftdate.getDate()-1));
                setrightdate = DataFormatPaser(rightdate.setDate(rightdate.getDate()+1));
            break;
            case 'week':
                setleftdate = DataFormatPaser(leftdate.setDate(leftdate.getDate()-7));
                setrightdate = DataFormatPaser(rightdate.setDate(rightdate.getDate()+7));
            break;
            case 'month':
                setleftdate = DataFormatPaser(leftdate.setMonth(leftdate.getMonth()-1));
                setrightdate = DataFormatPaser(rightdate.setMonth(rightdate.getMonth()+1));
            break;
            default:
            alert('未合法的時間單位')
            return;
        }

        $("#LeftSwitchChart").prop('title', setleftdate);
        $("#LeftSwitchChart").data('themeswitchchart',setleftdate)
        $("#divWaterUserSearchChartTitle").text(middledate + "當周用水量");
        $("#divWaterUserSearchChartTitle").data('themeswitchchart',middledate)
        $("#RightSwitchChart").prop('title', setrightdate);
        $("#RightSwitchChart").data('themeswitchchart',setrightdate);

        LoadChart();
    }

    //用水量查詢用日期轉換
    function DataFormatPaser(origindate){
        var odate = new Date(origindate);
        var dd = (odate.getDate() + 1 <= 10 ? '0' : '') + (odate.getDate());
        var mm = (odate.getMonth() + 1 < 10 ? '0' : '') + (odate.getMonth() + 1);
        var y = odate.getFullYear();
        return y + '/' + mm + '/' + dd;
    }

</script>
<style>
    .pagechartGroup > div {
        height: inherit;
    }

    .mCSB_container {
        height: inherit;
    }
</style>
<div class="wrap-page">
    <div class="searchAreaInline">
        <div class="unitTitle">
            用水情形分析
        </div>
        <div class="cycleGroup">
            <a class="timesplit btn-green-o" data-timesplit="day" onclick="btnSwitchTimesplit(this)" href="javascript:;">日</a>
            <a class="timesplit btn-green-o active" data-timesplit="week" onclick="btnSwitchTimesplit(this)" href="javascript:;">週</a>
            <a class="timesplit btn-green-o" data-timesplit="month" onclick="btnSwitchTimesplit(this)" href="javascript:;">月</a>
        </div>
        <div class="themeSwitch">
            <a class="btn-green-o-line"
               href="javascript:;"
               id="LeftSwitchChart"
               data-themeswitchchart="@DateTime.Now.AddDays(-7).ToString("yyyy/MM/dd")"
               data-switcher="last"
               title="@DateTime.Now.AddDays(-7).ToString("yyyy/MM/dd")"
               onclick="btnSwitchWaterSearch(this)">
                <i class="bi bi-chevron-left"></i>
            </a>
            <div class="name"
                 id="divWaterUserSearchChartTitle"
                 data-themeswitchchart="@DateTime.Now.ToString("yyyy/MM/dd")">
                @DateTime.Now.ToString("yyyy/MM/dd")當週用水量
            </div>
            <a class="btn-green-o-line"
               href="javascript:;"
               id="RightSwitchChart"
               data-switcher="next"
               data-themeswitchchart="@DateTime.Now.AddDays(7).ToString("yyyy/MM/dd")"
               title="@DateTime.Now.AddDays(7).ToString("yyyy/MM/dd")"
               onclick="btnSwitchWaterSearch(this)">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div><!-- searchAreaInline end -->
    <div class="version1">
        <div class="main videoScroll">
            <span id="spanError">此時間段尚無資料</span>
            <div class="pagechartGroup" style="width:100%; height:inherit;">
                <div id="mychart" style="width:100%; height:100%;"></div>
            </div>
        </div>
        <div class="main videoScroll" style="text-align:center;margin-top:15px">
            <div class="pagechartGroup" id="mychart2" style="width:1200px;height:100px;">
            </div>
        </div>
    </div><!-- main end -->
</div><!-- wrap end -->
<!-- 六個狀態色碼
    .circularRed{ border-color: #FF0000; }
    .circularGrey{ border-color: #B7B9C0; }
    .circularOrange{ border-color: #FEAD54; }
    .circularBlue{ border-color: #5391C7; }
    .circularGreen{ border-color: #089BAB; }
    .circularLightGreen{ border-color: #85F9B6;}
-->

<script>
    window.onresize = function() {
        myChart.resize();
    };

    var myChart = echarts.init(document.getElementById('mychart'));
    function LoadChart(){
        $("#spanError").text('');
         var model ={
             Cdate :$("#divWaterUserSearchChartTitle").data("themeswitchchart"),
             timespilt: $(".timesplit.btn-green-o.active").data("timesplit")
         };
        $.post("@Url.Action("GetDashWaterAnalyer","Dashboard")", model ,function(result){
            if(result.Success){
                const colors = ['#5391C7'];

                var option;
                option = {
                    color: colors,
                    tooltip: {
                        trigger: 'axis',
                        axisPointer: {
                            type: 'cross'
                        }
                    },
                    toolbox: {
                        show: true,
                        feature: {
                            saveAsImage: {title: "另存圖片"}
                        }
                    },
                    grid: {
                        right:'5%',
                        left:'5%',
                        bottom:'15%'
                    },
                    legend: {
                        orient: 'horizontal',
                        top: 10,
                        data: ["用水量分析"]
                    },
                    xAxis: {
                        name: result.Data.XrayUnit,
                        type: 'category',
                        data: result.Data.X,
                        nameTextStyle: {
                             fontSize: 20,
                             padding: 0
                        },
                        nameLocation: 'middle',
                        nameGap: 50,
                        axisLabel: {
                            fontSize: 20,
                            formatter: '{value}'
                        }
                    },
                    yAxis: {
                        name:' 用水量(度)',
                        type: 'value',
                        axisLine: {
                            show: true,
                            lineStyle: {
                                color: colors[0]
                            }
                        },
                        nameTextStyle: {
                             fontSize: 24
                        },
                        nameLocation: 'middle',
                        nameGap: 45,
                        axisLabel: {
                            fontSize: 20,
                            formatter: '{value}'
                        }
                    },
                    series: [{
                        name: '用水量分析',
                        type: 'line',
                        data:  result.Data.Y
                    }]
                };
                option && myChart.setOption(option);
            }
            else{
                $("#spanError").text('此時間段尚無資料');
                myChart.clear();
            }
        });
    }

    var mychart2 = echarts.init(document.getElementById('mychart2'))
    function LoadFakeTimeline(){
        const hours = [
            '00:00', '01:00', '02:00', '03:00', '04:00', '05:00', '6a',
            '7a', '8a', '9a', '10a', '11a',
            '12p', '1p', '2p', '3p', '4p', '5p',
            '6p', '7p', '8p', '9p', '10p', '11p'
        ];
        option = {
          tooltip: {
            position: 'top'
          },
          legend: {
            data: ['斷訊','低電壓','逆流','用水增加','連續用水','無異常']
          },
          title: [
          {
            textBaseline: 'middle',
            top: ((1 + 0.5) * 100) / 7 + '%',
            text: '用水分析圖'
          }],
          singleAxis: [{
            left: 150,
            type: 'category',
            boundaryGap: false,
            data: hours,
            axisLabel: {
              interval: 2
            }}],
            series: [
            {
                name:'斷訊',
                singleAxisIndex: 0,
                coordinateSystem: 'singleAxis',
                type: 'scatter',
                data: [[0,'斷訊'],[1,'斷訊'],[2,'斷訊'],[3,'斷訊'],[4,'斷訊']],
                symbolSize:10
            },
            {
                name:'低電壓',
                singleAxisIndex: 0,
                coordinateSystem: 'singleAxis',
                type: 'scatter',
                data: [[5,'低電壓']],
                symbolSize:10
            },
            {
                name:'逆流',
                singleAxisIndex: 0,
                coordinateSystem: 'singleAxis',
                type: 'scatter',
                data: [],
                symbolSize:10
            },
            {
                name:'用水增加',
                singleAxisIndex: 0,
                coordinateSystem: 'singleAxis',
                type: 'scatter',
                data: [],
                symbolSize:10
            },
            {
                name:'連續用水',
                singleAxisIndex: 0,
                coordinateSystem: 'singleAxis',
                type: 'scatter',
                data: [],
                symbolSize:10
            },
            {
                name:'無異常',
                singleAxisIndex: 0,
                coordinateSystem: 'singleAxis',
                type: 'scatter',
                data: [],
                symbolSize:10
            }]};
            option && mychart2.setOption(option);
    }

</script>