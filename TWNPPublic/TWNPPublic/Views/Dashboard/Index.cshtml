    //用水量查詢用日期轉換
    function DataFormatPaser(origindate){
        var odate = new Date(origindate);
        var dd = (odate.getDate() + 1 <= 10 ? '0' : '') + (odate.getDate());
        var mm = (odate.getMonth() + 1 < 10 ? '0' : '') + (odate.getMonth() + 1);
        var y = odate.getFullYear();
        return y + '/' + mm + '/' + dd;
    }

