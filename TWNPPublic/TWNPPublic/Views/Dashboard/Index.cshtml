              OpenNotesModal(date.dateStr);
            },
            eventContent: function (arg) {
                var customHtml = '';
                customHtml += "<div onclick=\"OpenNotesModal('"+arg.event._def.extendedProps.NoteDate+"')\">檢視</div>";
                return { html: customHtml }
            },
            events:function(info, successCallback, failureCallback) {
                var model = {start : info.startStr, end : info.endStr };
                $.post(GetWebSiteURL('@Url.Action("ListedNotes", "Dashboard")'),model,function(result){
                     var events = result.Data;
                     successCallback(events);
                });
            }
