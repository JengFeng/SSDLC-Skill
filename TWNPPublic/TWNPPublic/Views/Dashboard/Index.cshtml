    function OpenContactPerson(){
        $("#modcontactpersonbody").empty();
        $.get(GetWebSiteURL('@Url.Action("GetContactPersonData", "Dashboard")'), function(result){
            if(result.Success){
                //console.log(result.Data);
                // 檢查 FACTORY 或 TEL 是否為空或 null
                let factory = result.Data.FACTORY || "無廠所資料";  // 若沒有廠所資料，顯示預設文字
                let tel = result.Data.TEL || "無聯絡電話";  // 若沒有聯絡電話，顯示預設文字

                // 如果 TEL 是有效的，進行格式化
                let intlTel = "";
                if (tel !== "無聯絡電話") {
                    let rawTel = tel.replace(/[^\d]/g, '');  // 去除非數字符號
                    if (rawTel.startsWith("0")) {
                        intlTel = "+886" + rawTel.substring(1);  // 去除開頭的 0 並加上台灣的國際區號
                    } else {
                        intlTel = "+886" + rawTel;  // 直接加上台灣國際區號
                    }
                }

              $("#modcontactpersonbody").append( '<div>廠所:'+ factory + '  聯絡電話:<a href="tel:' + intlTel + '">' + tel +'</a></div>');
            }
            else{
                $("#modcontactpersonbody").append( '<div>廠所: 無廠所資料  聯絡電話:無聯絡電話</div>');
            }

            $("#ModalContactPerson").modal('show');
        });
    }

