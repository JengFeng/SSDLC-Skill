                        nameLocation : 'center',
                        type: 'category',
                        data: result.Data.X,
                        name: result.Data.XrayUnit
                    },
                    yAxis: {
                        nameLocation : 'center',
                        nameGap: 25,
                        nameRotate : 360,
                        name:'用 \n 水 \n 量 \n ︵ \n 度 \n ︶ \n',
                        triggerEvent:true,
                        type: 'value',
                        axisLine: {
                        show: true,
                            lineStyle: {
                                color: colors[1]
                            }
                        },
                        axisLabel: {formatter: '{value}'}
                    },
                    series: [{
                            name: '度數',
                            data: result.Data.Y,
                            type: 'bar',
                            itemStyle:{
                                color:new echarts.graphic.LinearGradient(0, 0, 0, 1, [{
                                offset: 0,
                                color: '#248ff7'
                            }, {
                                offset: 1,
                                color: 'rgba(22,75,247,0.1)'
                            }])
