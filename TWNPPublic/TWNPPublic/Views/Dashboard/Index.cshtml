<script>

    $(function () {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            locale: 'zh-tw',             // 地區設台灣就顯示'週一', '週二', '週三', '週四', '週五'
            contentHeight: 250,
            initialDate: new Date(),        // 設定預設顯示日期
            editable: false,                // 月曆是否允許手動編輯(拖移)
            selectable: true,               // 是否可以選取月曆
            slotEventOverlap: false,        // 事件使否重疊覆蓋
            dayMaxEvents: false,            // 當行程太多是否用 more 檢視完整
            weekends: true,                // 顯示星期六跟星期日
            allDaySlot: false,              // 顯示 all day 欄位(週、日檢視最上方出現，若有整日的行程時則會顯示在此)
            contentHeight: 300,
            dayHeaderFormat: {
                weekday: 'narrow'
            },
            eventContent: function (arg) {
                var event = arg.event;
                var customHtml = '';
                customHtml += "<span onclick=\"OpenNotesModal()\">檢視</span>";
                return { html: customHtml }
            },
            events:function(info, successCallback, failureCallback) {
                var model = {start : info.startStr, end : info.endStr };
                $.post("@Url.Action("ListedNotes","Dashboard")",model,function(result){
                     var events = result.Data;
                     successCallback(events);
                });
            }
        });
        calendar.render();
    });
</script>
