<!-- 月曆套件 -->
<link href='~/js/fullcalendar-5.10.1/main.css' rel='stylesheet' />
<script src='~/js/fullcalendar-5.10.1/main.js'></script>
<script src='~/js/fullcalendar-5.10.1/locales/zh-tw.js'></script>
<script>

    $(function () {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            locale: 'zh-tw',             // 地區設台灣就顯示'週一', '週二', '週三', '週四', '週五'
            contentHeight: 250,
            initialDate: new Date(),        // 設定預設顯示日期
            editable: false,                // 月曆是否允許手動編輯(拖移)
            selectable: true,               // 是否可以選取月曆
            slotEventOverlap: false,        // 事件使否重疊覆蓋
            dayMaxEvents: true,            // 當行程太多是否用 more 檢視完整
            weekends: true,                // 顯示星期六跟星期日
            allDaySlot: false,              // 顯示 all day 欄位(週、日檢視最上方出現，若有整日的行程時則會顯示在此)
            contentHeight: 300,
            dayHeaderFormat: {
                weekday: 'narrow'
            },
            events:function(info, successCallback, failureCallback) {
                var model = {start : info.startStr, end : info.endStr };
                $.post("@Url.Action("ListedNotes","Dashboard")",model,function(result){
                     var events = [];
                     successCallback(events);
                });
            }
        });
        calendar.render();
    });
</script>
<!-- Easymap -->
<script type="text/javascript" src="http://easymap.gis.tw/easymap/latest/easymap.js?"></script>
<script type="text/javascript">
    $(function () {

        $.get("@Url.Action("GetDashMainData","Dashboard")", function(result){
            if(result.Success){
                //名稱
                $('#divNAME').html('歡迎  ' + result.Data.NAME + '！');
                //目前指針度數
                $('#divNEW_METER').html(result.Data.NEW_METER + '<span>度</span>');
                //本月水費
                $('#divTHISMONTH_MONEY').html(result.Data.THISMONTH_MONEY + '<span>元</span>');
                //本期預估
                $('#divTHISMONTHEND_METER').html(result.Data.THISMONTHEND_METER + '<span>元</span>');
                //去年同期水費
                $('#divLASTYEAR_MONEY').html('<i class="bi bi-arrow-up text-red"></i>' + result.Data.LASTYEAR_MONEY + '<span>元</span>');
                //用水情形比較
                InitCompareChart(result.Data.LASTYEAR_METER,result.Data.LASTMONTH_METER,result.Data.THISMONTH_METER);
            }
        });
        InitWaterUseSearchChart();

    });

    //初始化用水情形比較圖表
    function InitCompareChart(LASTYEAR_METER,LASTMONTH_METER,THISMONTH_METER){
        var xAxisDataLASTYEAR_METER = "無資料",xAxisDataLASTMONTH_METER = "無資料",xAxisDataTHISMONTH_METER = "無資料";

        if(LASTYEAR_METER != null)
           xAxisDataLASTYEAR_METER = '去年當月\n' + LASTYEAR_METER +'度';
        if(LASTMONTH_METER != null)
           xAxisDataLASTMONTH_METER = '上個月\n'+LASTMONTH_METER+'度'
        if(THISMONTH_METER != null)
           xAxisDataTHISMONTH_METER = '本月已用\n'+THISMONTH_METER+'度';

        var chartCompareWaterUse = echarts.init(document.getElementById('ChartCompareWaterUse'));
        option = {
            grid: {
              top: 20
            },
            xAxis: {
                type: 'category',
                data: [xAxisDataLASTYEAR_METER, xAxisDataLASTMONTH_METER, xAxisDataTHISMONTH_METER]
            },
            yAxis: {
                type: 'value'
            },
            series: [
            {
                data: [LASTYEAR_METER, LASTMONTH_METER, THISMONTH_METER],
                type: 'bar'
            }]
        };
        chartCompareWaterUse.setOption(option);
    }

    //初始化用水量查詢圖表
    function InitWaterUseSearchChart(){
        var model ={ Cdate :$("#divWaterUserSearchChartTitle").data("themeswitchchart")};
        $.post("@Url.Action("GetDashWaterUseSearchChart","Dashboard")", model ,function(result){
            if(result.Success){
                var chartWaterUseMonitor = echarts.init(document.getElementById('ChartWaterUseMonitor'));
                option = {
                    grid: {
                      top: 20
                    },
                    xAxis: {
                        type: 'category',
                        data: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
                    },
                    yAxis: {
                        type: 'value'
                    },
                    series: [
                        {
                            data: result.Data,
                            type: 'bar'
                        }]
                    };
                chartWaterUseMonitor.setOption(option);
            }
        });
    }

    //easy map
    var map = null;
    function init() {
        //map = new Easymap('map');	//'map'為div的id
        //map.zoomToXY(new dgXY(121.3, 24.5), 9);

        //map.switchMapType('VectorTile')
    }

</script>
<script>
    $(function () {
        $(".menuList > a:nth-child(1)").addClass("active").siblings().removeClass("active");

        $(".open-mapGroup").click(function () {
            $(".mapGroup").addClass("active");
        });
        $(".close-mapGroup").click(function () {
            $(".mapGroup").removeClass("active");
        });
        $(".open-configureGroup").click(function () {
            $(".configureGroup").addClass("active");
        });
        $(".close-configureGroup").click(function () {
            $(".configureGroup").removeClass("active");
        });

    });

</script>
