                else
                {
                    <text>result.Data.Y = result.Data.Y.map(function(item){ return ( item == null ? null : roundDown(item,2) );})</text>
                }
              
                //業務版有小數點
                if( sessionStorage.getItem('fromtwn') == 'true' ){
                    result.Data.Y = result.Data.Y.map(function(item){ return ( item == null ? null : roundDown(item,2) );})
                }
                //民眾版沒有小數點
                else{
                    result.Data.Y = result.Data.Y.map(function(item){ return ( item == null ? null : Math.round(item) );})
                }

                option = {
                    color: colors,
                    legend:{
                        data: ['度數'],
                        y:'top',
                        x:'middle'
                    },
                    toolbox: {
                        show: true,
                        feature: {
                            saveAsImage: {title: "另存圖片"}
                        }
                    },
