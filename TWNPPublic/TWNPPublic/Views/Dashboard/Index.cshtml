    //用水量查詢標題的左右按鈕
    function btnSwitchWaterSearch(obj){
        //這個會變成中間
        var btnSetNow = $(obj);
        //中間的時間
        let currenttime = new Date($("#divWaterUserSearchChartTitle").data('themeswitchchart'));
        //時間粒度
        let timesplit = $(".timesplit.btn-green-o.active").data("timesplit");
        var SwitcherTime;
        switch($(obj).data('switcher')){
            case 'next':
            switch(timesplit){
                case 'day':
                    SwitcherTime =  DataFormatPaser(currenttime.setDate(currenttime.getDate()+1));
                break;
                case 'week':
                    SwitcherTime =  DataFormatPaser(currenttime.setDate(currenttime.getDate()+7));
                break;
                case 'month':
                    SwitcherTime =  DataFormatPaser(currenttime.setMonth(currenttime.getMonth()+1));
                break;
                default:
                    alert('未合法的時間單位')
                return;
            }
            break;
            case 'last':
            switch(timesplit){
                case 'day':
                    SwitcherTime =  DataFormatPaser(currenttime.setDate(currenttime.getDate()-1));
                break;
                case 'week':
                    SwitcherTime =  DataFormatPaser(currenttime.setDate(currenttime.getDate()-7));
                break;
                case 'month':
                    SwitcherTime =  DataFormatPaser(currenttime.setMonth(currenttime.getMonth()-1));
                break;
                default:
                    alert('未合法的時間單位')
                return;
            }
            break;
        }

        $("#divWaterUserSearchChartTitle").data('themeswitchchart',SwitcherTime);
        $("#divWaterUserSearchChartTitle").attr('data-themeswitchchart',SwitcherTime);
        //InitWaterUseSearchChart();
    }



    roundDown = function (num, decimal) { return Math.floor((num + Number.EPSILON) * Math.pow(10, decimal)) / Math.pow(10, decimal); }
    //roundDown = function (num, decimal) { return Math.round(num * Math.pow(10, decimal)) / Math.pow(10, decimal); }
    //用水量查詢圖表
    function InitWaterUseSearchChart(){
        $("#spanError").text('');

        var currenttime = $("#divWaterUserSearchChartTitle").data('themeswitchchart');
        let timesplit = $(".timesplit.btn-green-o.active").data("timesplit");
        switch(timesplit){
            case 'day':
            $("#divWaterUserSearchChartTitle").text(currenttime + '當日用水量');
            break;
            case 'week':
            $("#divWaterUserSearchChartTitle").text(currenttime + '當週用水量');
            break;
            case 'month':
            $("#divWaterUserSearchChartTitle").text(currenttime + '當月用水量');
            break;
            default:
                alert('未合法的時間單位')
            return;
        }


        var model ={
            Cdate :$("#divWaterUserSearchChartTitle").data("themeswitchchart"),
            timespilt: $(".timesplit.btn-green-o.active").data("timesplit")
        };
        $.post(GetWebSiteURL('@Url.Action("GetDashWaterAnalyer", "Dashboard")'), model ,function(result){
            if(result.Success){
