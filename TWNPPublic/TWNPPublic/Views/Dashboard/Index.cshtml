    const colors = ['#ffb1c1', '#5391C7'];
    //初始化異常狀態列表
    function InitTableB_Message(obj){
        $("#tbB_Message > tbody").empty();
        $.each(obj,function(index,value){
            $("#tbB_Message > tbody").append('<tr>' +
                                            '<td class="width15">'+value.Time+'</td>' +
                                            '<td>'+ value.Message +'</td>' +
                                            '<td class="width15"><a class="btn-green-o" href="javascript:;" onclick="OpenExceptionModal()"><i class="bi bi-window"></i>查看</a></td>'+
                                            '</tr>');

        });
    }

    //初始化用水情形比較圖表
    function InitCompareChart(LASTYEAR_METER,LASTMONTH_METER,THISMONTH_METER){
        var xAxisDataLASTYEAR_METER = "無資料",xAxisDataLASTMONTH_METER = "無資料",xAxisDataTHISMONTH_METER = "無資料";

        if(LASTYEAR_METER != null)
           xAxisDataLASTYEAR_METER = '去年當月\n' + LASTYEAR_METER +'度';
        if(LASTMONTH_METER != null)
           xAxisDataLASTMONTH_METER = '上個月\n'+LASTMONTH_METER+'度'
        if(THISMONTH_METER != null)
           xAxisDataTHISMONTH_METER = '本月已用\n'+THISMONTH_METER+'度';

        var chartCompareWaterUse = echarts.init(document.getElementById('ChartCompareWaterUse'));
        option = {
            color: colors,
            grid: {
              top: 20
            },
            xAxis: {
                type: 'category',
                data: [xAxisDataLASTYEAR_METER, xAxisDataLASTMONTH_METER, xAxisDataTHISMONTH_METER]
            },
            yAxis: {
                type: 'value',
                axisLine: {
                    show: true,
                    lineStyle: {
                        color: colors[0]
                    }
                },
                axisLabel: {formatter: '{value} 度'}
            },
            series: [
            {
                data: [LASTYEAR_METER, LASTMONTH_METER, THISMONTH_METER],
                type: 'bar',
                itemStyle:{
                        color:new echarts.graphic.LinearGradient(0, 0, 0, 1, [{
                        offset: 0,
                        color: '#ffb1c1'
                    }, {
                        offset: 1,
                        color: 'rgba(255, 192, 184, 0.1)'
                    }])
                },
                label: {
                    show: true,
                    position: 'top',
                    textStyle: {
                        color: colors[0],
                        fontSize: 16
                    }
                }
            }]
        };
        chartCompareWaterUse.setOption(option);
    }

    //easy map
    var map = null;
    function init() {
        //map = new Easymap('map');	//'map'為div的id
        //map.zoomToXY(new dgXY(121.3, 24.5), 9);
        //map.switchMapType('VectorTile')
    }

    //用水量查詢標題的左右按鈕
    function btnSwitchWaterSearch(obj){
        //這個會變成中間
        var btnSetNow = $(obj);
        //中間的時間
        var middledate = btnSetNow.data('themeswitchchart');
        // 左邊的時間
        var leftdate = new Date(middledate);
        var setleftdate = DataFormatPaser(leftdate.setDate(leftdate.getDate()-7));
        //右邊的時間
        var rightdate = new Date(middledate);
        var setrightdate = DataFormatPaser(rightdate.setDate(rightdate.getDate()+7));

        $("#LeftSwitchChart").prop('title', setleftdate);
        $("#LeftSwitchChart").data('themeswitchchart',setleftdate)
        $("#divWaterUserSearchChartTitle").text(middledate + "當周用水量");
        $("#divWaterUserSearchChartTitle").data('themeswitchchart',middledate)
        $("#RightSwitchChart").prop('title', setrightdate);
        $("#RightSwitchChart").data('themeswitchchart',setrightdate);

        InitWaterUseSearchChart();
    }

    //用水量查詢圖表
    function InitWaterUseSearchChart(){
        var model ={ Cdate :$("#divWaterUserSearchChartTitle").data("themeswitchchart")};
        $.post("@Url.Action("GetDashWaterUseSearchChart","Dashboard")", model ,function(result){
            if(result.Success){
                var chartWaterUseMonitor = echarts.init(document.getElementById('ChartWaterUseMonitor'));
                option = {
                    color: colors,
                    grid: {
                      top: 20
                    },
                    xAxis: {
                        type: 'category',
                        data: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
                    },
                    yAxis: {
                        type: 'value',
                        axisLine: {
                        show: true,
                            lineStyle: {
                                color: colors[1]
                            }
                        },
                        axisLabel: {formatter: '{value} 度'}
                    },
                    series: [{
                            data: result.Data,
                            type: 'bar',
                            itemStyle:{
                                color:new echarts.graphic.LinearGradient(0, 0, 0, 1, [{
                                offset: 0,
                                color: '#248ff7'
                            }, {
                                offset: 1,
                                color: 'rgba(22,75,247,0.1)'
                            }])
                            },
                            label: {
                                show: true,
                                position: 'top',
                                textStyle: {
                                    color: colors[1],
                                    fontSize: 16
                                }
                            }
                        }]
                    };
                chartWaterUseMonitor.setOption(option);
            }
        });
    }

    //用水量查詢用日期轉換
    function DataFormatPaser(origindate){
        var odate = new Date(origindate);
        var dd = (odate.getDate() + 1 <= 10 ? '0' : '') + (odate.getDate());
        var mm = (odate.getMonth() + 1 <= 10 ? '0' : '') + (odate.getMonth() + 1);
        var y = odate.getFullYear();
        return y + '/' + mm + '/' + dd;
    }


