    //初始化用水情形比較圖表
    function InitCompareChart(LASTYEAR_METER,LASTMONTH_METER,THISMONTH_METER){
        var xAxisDataLASTYEAR_METER = "無資料",xAxisDataLASTMONTH_METER = "無資料",xAxisDataTHISMONTH_METER = "無資料";

        if(LASTYEAR_METER != null)
           xAxisDataLASTYEAR_METER = '去年同期\n\n(帳單年月:'+ LASTYEAR_DATE +')\n\n (計費期間:'+ LASTYEAR_DATE1 + ')'/*+ parseInt(LASTYEAR_METER) +'度'*/;
        if(LASTMONTH_METER != null)
           xAxisDataLASTMONTH_METER = '上一期\n\n (帳單年月:'+ BILLDATE1 +')\n\n (計費期間:'+ LASTMONTH_DATE1 + ')'/*+ parseInt(LASTMONTH_METER) +'度'*/;
        if(THISMONTH_METER != null)
           xAxisDataTHISMONTH_METER = '本期累積\n\n (計費期間:'+ THISMONTHEND_DATE+')' /*+ parseInt(THISMONTH_METER) +'度'*/;
        option = {
            color: colors,
            legend:{
                data: ['度數'],
                y:'top',
                x:'middle',
                padding:[30,0,0,0]
            },
            toolbox: {
                show: true,
                feature: {
                    saveAsImage: {title: "另存圖片"}
                }
            },
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    type: 'shadow'
                },
               confine: true,
               formatter: function (params) {
                  var p = params[0];

                  var axisText = p.axisValue
                    .replace(/\n+/g, '\n')   //\n 變一個
                    .replace(/\n/g, '<br/>');

                  return axisText + '<br/>' +
                         p.marker + p.seriesName + '：' + p.value;
               }
            },
            xAxis: {
                type: 'category',
                data: [xAxisDataLASTYEAR_METER, xAxisDataLASTMONTH_METER, xAxisDataTHISMONTH_METER],
                axisLabel: {
                  interval: 0,
                  formatter: function (value) {
                    var width = window.innerWidth;

                    if (width < 480) {
                      // 手機：縮短文字
                      return value.split('\n')[0]; // 只顯示第一行
                    } else if (width < 768) {
                      // 平板：顯示前兩段
                      return value.split('\n').slice(0, 2).join('\n');
                    } else {
                      // 桌機：完整顯示
                      return value;
                    }
                  }
                }
            },
            yAxis: {
                nameLocation : 'center',
                nameGap: 45,
                nameRotate : 360,
                name:'用 \n 水 \n 量 \n ︵ \n 度 \n ︶ \n',
                type: 'value',
                axisLine: {
                    show: true,
                    lineStyle: {
                        color: colors[0]
                    }
                },
                axisLabel: {formatter: '{value}'}
            },
            series: [
            {
                name: '度數',
                data: [parseInt(LASTYEAR_METER), parseInt(LASTMONTH_METER), parseInt(THISMONTH_METER)],
                type: 'bar',
