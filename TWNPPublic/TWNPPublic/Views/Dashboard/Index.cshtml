    /* 以條件生成 Listed 查詢條件 */
    function GetTableQueryString() {
        return GetWebSiteURL('@Url.Action("ListedExceptionState", "Dashboard")')
    }

    function ReloadTable(result) {
        let pagesize = 3;

        function setChartBoxHeight() {
            var unitTitleHeight = $(".unitTitleHeight")[0]?.clientHeight || 0;
            $('.chartBox').css('height', 'calc(100% - ' + unitTitleHeight + 'px)');

            var winHeight = window.outerHeight;
            if (winHeight <= 670) {
               $('.chartBox').css('height', '200px');
            }
            else if(winHeight <= 780) {
               $('.chartBox').css('height', '300px');
            }
        }

        function initializeChart() {
            var chartBoxHeight = $(".chartBox")[0].clientHeight;

            if (chartCompareWaterUse) {
                chartCompareWaterUse.dispose();
            }

            chartCompareWaterUse = echarts.init(document.getElementById('ChartCompareWaterUse'), null, {
                height: chartBoxHeight
            });

            InitCompareChart(result.Data.LASTYEAR_METER, result.Data.LASTMONTH_METER, result.Data.THISMONTH_METER);
            DashSlowQuery();
        }

        if (AbnormalList == null) {
            $("#tbB_Message").footable();
        } else {
            LoadPaginate(AbnormalList.length, 3);
            InitTableB_Message(AbnormalList.slice((currentpage - 1) * pagesize, currentpage * pagesize));
            $("#tbB_Message").footable();
        }

        setChartBoxHeight();

        setTimeout(function () {
            initializeChart();
        }, 1500);
    }

    /* 現在頁數 */
    let currentpage = 1;
    /* 總頁簽方法*/
    function LoadPaginate(TotalCount,ItemPerPage) {
        //$("#PageCount").html("共 " + TotalCount + " 筆");
        maxpage = (TotalCount / ItemPerPage);
        //處理頁籤
        var tags = LoadPageItem('#first', '<<');
        tags += LoadPageItem('#prev', '<');
        if (parseInt(currentpage, 10) <= 5) {
            for (var i = 0; i < Math.min(9, maxpage); i++) {
                if (i == parseInt(currentpage, 10) - 1) {
                    tags += LoadPageItem('#' + (i + 1), i + 1, 'active');
                } else {
                    tags += LoadPageItem('#' + (i + 1), i + 1);
                }
            }
        } else if (parseInt(currentpage, 10) >= maxpage - 4) {
            for (var i = Math.max(Math.ceil(maxpage) - 9, 0); i < maxpage; i++) {
                if (i == parseInt(currentpage, 10) - 1) {
                    tags += LoadPageItem('#' + (i + 1), i + 1, 'active');
                } else {
                    tags += LoadPageItem('#' + (i + 1), i + 1);
                }
            }
        } else {
            for (var i = parseInt(currentpage, 10) - 5; i < parseInt(currentpage, 10) + 4; i++) {
                if (i == parseInt(currentpage, 10) - 1) {
                    tags += LoadPageItem('#' + (i + 1), i + 1, 'active');
                } else {
                    tags += LoadPageItem('#' + (i + 1), i + 1);
                }
            }
        }
        tags += LoadPageItem('#next', '>');
        tags += LoadPageItem('#last', '>>');
        $('#UlPagination').html(tags);
    }

     /* 頁數載入方法
     * @@param href 頁數指標參數
     * @@param pagename 要顯示的頁碼
     * @@param active 是否標記
     */
    function LoadPageItem(href, pagename, active) {
        var TplPageitem = $('script[data-template="TemplatePageitem"]').text().split(/\$\{(.+?)\}/g);
        return TplPageitem.map(render({
            "HrefName": href,
            "PageName": pagename,
            "Active": active
            })).join('')
    }

    /* 換頁方法 */
    function PagelinkOnclick(obj) {
        //console.log(obj);
        var $this = $(obj);
        var gopage = currentpage;
        if ($this.attr('href') == "#first") {
            gopage = 1;
        } else if ($this.attr('href') == "#prev") {
            if (currentpage - 1 == 0) {
                gopage = 1;
            } else {
                gopage = currentpage - 1;
            }
        } else if ($this.attr('href') == "#next") {
            if (currentpage + 1 > Math.ceil(maxpage)) {
                gopage = Math.ceil(maxpage);
            } else {
                gopage = currentpage + 1;
            }
        } else if ($this.attr('href') == "#last") {
            gopage = Math.ceil(maxpage);
        } else {
            gopage = parseInt($this.attr('href').substring(1, 5), 10);
        }
        if (gopage == currentpage) { return false; }
        currentpage = gopage;
        ReloadTable();
        return false;
    }

     /* Template Helper */
    function render(props) {
        return function (tok, i) { return (i % 2) ? props[tok] : tok; };
    }

    window.onresize = function() {
        //chartWaterUseMonitor.resize();
        chartCompareWaterUse.resize();
    };

</script>
<script type="text/template" data-template="TemplatePageitem">
    <li class="page-item ${Active}"><a class="page-link" href="${HrefName}" onclick="PagelinkOnclick(this)">${PageName}</a></li>
</script>
