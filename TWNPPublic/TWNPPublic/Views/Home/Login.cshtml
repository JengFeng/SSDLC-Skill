@using TWNPPublic.ViewModels.Home
@model LoginViewModel
@{
    ViewData["Title"] = "登入頁面";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section validation{
<script type="text/javascript" src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script type="text/javascript" src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
<link rel="stylesheet" href="~/css/Login.css">

<div class="wrap_login">
    <div class="loginGroup animated fadeInDown">
        <div class="InputBox">
            <div class="logo">
                <div class="systemTitle" style="text-align: center;">台灣自來水公司</div>
                <div class="companyName" style="text-align: center;">水表e管家</div>
            </div>
            <div class="formBox">
                <form id="formLogin" autocomplete="off" method="post" action="@Url.Action("Login","Home")">
                    <span class="text-danger">
                        @Html.ValidationSummary(true)
                    </span>
                    <div class="form-group">
                        <label>帳號(水號)</label>
                        <div>
                            @Html.TextBoxFor(m=>m.UserName , new {@class="form-control",@placeholder="請輸入您的帳號"})
                            @Html.ValidationMessageFor(m=>m.UserName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label>密碼</label>
                        <div>
                            @if (ViewBag.islocalhost)
                            {
                                @Html.PasswordFor(m => m.Pwd, new { @class = "form-control", @placeholder = "請輸入您的密碼", @value = "24516669" })
                            }
                            else
                            {
                                @Html.PasswordFor(m => m.Pwd, new { @class = "form-control", @placeholder = "請輸入您的密碼" })
                            }
                            @Html.ValidationMessageFor(m => m.Pwd, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label>驗證碼</label>
                        <div class="codeGroup">
                            <div>
                                @Html.TextBoxFor(m=>m.CapthCode , new {@class="form-control width100",@placeholder="驗證碼"})
                                @Html.ValidationMessageFor(m=>m.CapthCode, "", new { @class = "text-danger" })
                            </div>
                            <div>
                                <img id="CapthCodes" src="@Url.Action("CreateValidate","Home")" style="width: 40%;">
                                <a class="btn-grey-o" href="javascript:ReloadCapth();">重新整理</a>
                            </div>
                        </div>
                    </div>
                    <div class="btnGroup">
                        <a class="btn-green-o" href="javascript:;" onclick="submitForm()">送出</a>
                        <a class="btn-lightGrey-o" href="javascript:;" onclick="clearFrom()">清除</a>
                    </div>
                </form>
            </div>
            <div style="display:flex;justify-content:end;margin-right:15px">
                <div>
                    <a href="@Url.Action("ResetPw","Home")">忘記密碼</a>
                </div>
            </div>
        </div><!-- InputBox -->
    </div><!-- loginGroup end -->
</div><!-- wrap_login end-->
<script>

    function ReloadCapth() {
        $("#CapthCodes").attr("src", "@Context.Items["urlPrefix"]@Url.Action("CreateValidate", "Home")" + "?" + Math.random());;
    }

    function submitForm(){
        $('#formLogin').submit();
    }

    function clearFrom(){
        document.getElementById("formLogin").reset();
    }
</script>