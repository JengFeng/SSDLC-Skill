@using TWNPPublic.ViewModels.Home
@model AppTokenConfirmViewModel
@{
    ViewData["Title"] = "APP 授權確認";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/Login.css">

<div class="wrap_login">
    <div class="loginGroup animated fadeInDown">
        <div class="InputBox">
            <div class="logo">
                <div class="systemTitle" style="text-align: center;">台灣自來水公司</div>
                <div class="companyName" style="text-align: center;">水表e管家</div>
            </div>
            <div class="formBox">
                <form id="formExternalLoginConfirm" autocomplete="off" method="post" action="@Url.Action("ConfirmExternalLogin", "Home")">
                    <input type="hidden" asp-for="GrantType" />
                    <input type="hidden" asp-for="AccountNo" />
                    <input type="hidden" asp-for="WaterNo" />
                    <input type="hidden" asp-for="RedirectUri" />

                    <span class="text-danger">
                        @Html.ValidationSummary(true)
                    </span>
                    <div class="form-group">
                        <label>帳號</label>
                        <div>
                            <input class="form-control" value="@Model.AccountNo" readonly="readonly" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>水號</label>
                        <div>
                            <input class="form-control" value="@Model.WaterNo" readonly="readonly" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>授權確認</label>
                        <div>
                            <span>此帳號已存在有效金鑰，是否重新驗證並核發新金鑰？</span>
                        </div>
                    </div>
                    <div class="btnGroup">
                        <a class="btn-green-o" href="javascript:;" onclick="submitExternalLoginConfirmForm()">確認</a>
                        <a class="btn-lightGrey-o" href="@Url.Action("CancelExternalLogin", "Home", new { account_no = Model.AccountNo, water_no = Model.WaterNo })">取消</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    function submitExternalLoginConfirmForm() {
        $('#formExternalLoginConfirm').submit();
    }
</script>
