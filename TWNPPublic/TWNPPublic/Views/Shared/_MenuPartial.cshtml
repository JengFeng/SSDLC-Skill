@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<div class="topBar">
    <div class="topMenuLogo">
        <!-- <div class="enName">台灣自來水公司</div> -->
        <!-- <div class="systemName">用戶用水查詢系統</div> -->
    </div>
    <div class="menuBar">
        <div class="tipGroup">
            <div class="menuGroup">
                <div class="updateTime" id="areaUpdateTime">
                    @if (HttpContextAccessor.HttpContext != null)
                    {
                        var UserName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
                        if (UserName != null)
                        {
                            @UserName
                        }
                    }
                    &nbsp;

                    <i class="bi bi-clock"></i> 登入時間 @DateTime.Now.ToString("HH:mm:ss")
                </div>
                <div class="menuList">
                    <a class="" href="@Url.Action("Index","Dashboard")"><i class="bi bi-columns-gap"></i>首頁</a>
                    <a class="" href="@Url.Action("UseWaterQueryNew","Quality")"><i class="bi bi-columns-gap"></i>用水量查詢</a>
                    @*<a class="" href="@Url.Action("WaterQuality","Quality")"><i class="bi bi-search"></i>水質查詢</a>*@
                    <a class="" href="@Url.Action("UseWaterQueryPin","Quality")"><i class="bi bi-droplet"></i>用水指針查詢</a>
                    @{
                        if (HttpContextAccessor.HttpContext != null)
                        {
                            var UserId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
                            if (!string.IsNullOrEmpty(UserId))
                            {
                                <a class="" href="@Url.Action("AlertSettings","Alert")"><i class="bi bi-gear-fill"></i>警示設定</a>
                            }

                            if( UserId != "0")
                            {
                                <a class="" href="@Url.Action("UserSettingsNew","UserManage")"><i class="bi bi-gear-fill"></i>帳號設定</a>
                            }
                        }
                    }
                    <a class="CustomerSurvey" href="" id=""><i class="bi bi-bar-chart-line"></i>滿意度調查</a>

                    <select id="SelectWaterNos" class="form-SelectWaterNos SelectWaterNoslist" onchange="SelectWaterNosChange()">
                    </select>
                </div>
            </div>
            <div class="toggleBtnBox">
                <nav class="menu-opener ">
                    <div class="menu-opener-inner"></div>
                </nav>
            </div>
            <div class="userArea">
                <div class="signOut">
                    <div class="text" id="LogoutHint">00:00後</div>
                    <a href="javascript:;" onclick="btnLogout()">登出</a>
                </div>
            </div>
        </div><!-- tipGroup end -->
    </div><!-- menuBar end -->
</div><!-- topBar end -->
<nav>
    <ul class="nav_sub">
        <li>
            <div class="userArea">
                <div class="signOut">
                    <div class="text" id="mobileLogoutHint">00:00後</div>
                    <a href="javascript:;" onclick="btnLogout()">登出</a>
                </div>
            </div>
        </li>
        <li tabindex="-1">
           <select id="SelectWaterNos2" class="form-SelectWaterNos SelectWaterNoslist" onchange="SelectWaterNosChange()"></select>
        </li>
        <li tabindex="-1"><a class="" href="@Url.Action("Index","Dashboard")"><i class="bi bi-columns-gap"></i>首頁</a></li>
        <li tabindex="-1"><a class="" href="@Url.Action("UseWaterQueryNew","Quality")"><i class="bi bi-columns-gap"></i>用水量查詢</a></li>
        @*<li tabindex="-1"><a class="" href="@Url.Action("WaterQuality","Quality")"><i class="bi bi-search"></i>水質查詢</a></li>*@
        <li tabindex="-1"><a class="" href="@Url.Action("UseWaterQueryPin","Quality")"><i class="bi bi-droplet"></i>用水指針查詢</a></li>
        @{
              if (HttpContextAccessor.HttpContext != null)
              {
                  var UserId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
                  if (!string.IsNullOrEmpty(UserId))
                  {
                    <li tabindex="-1"><a class="" href="@Url.Action("AlertSettings","Alert")"><i class="bi bi-gear-fill"></i>警示設定</a></li>
                  }

                  if( UserId != "0")
                  {
                     <li tabindex="-1"><a class="" href="@Url.Action("UserSettingsNew","UserManage")"><i class="bi bi-gear-fill"></i>帳號設定</a></li>
                  }
              }
        } 
        <li>
            <a tabindex="-1" class="CustomerSurvey" id="" href="javascript:;" ><i class="bi bi-bar-chart-line"></i>滿意度調查</a>
        </li>
        <li>
            <a tabindex="-1" id="closeMobile" href="javascript:;"><i class="ion-android-close"></i><span class="sr-only">關閉手機選單</span></a>
        </li>
    </ul>
</nav>
<script>
    function btnLogout(){
       window.location.href = GetWebSiteURL('@Url.Action("Logout","Home")');
    }
    //$('#SelectWaterNos').change(function(){
    //    var value = $(this).val();
    //    var model = {
    //        WaterNos : value
    //    };
    //    $.post("@Url.Action("ChangeUserWaterNos","Dashboard")",model,function(result){
    //        if(result.Success)
    //        {
    //            history.go(0);
    //        }
    //        else
    //        {
    //            alert('一片空白');
    //        }
    //    });
    //});

    $('.SelectWaterNoslist').change(function(){
        var value = $(this).val();
        var model = {
            WaterNos : value
        };
        $.post(GetWebSiteURL('@Url.Action("ChangeUserWaterNos","Dashboard")'),model,function(result){
            if(result.Success)
            {
                history.go(0);
            }
            else
            {
                alert('一片空白');
            }
        });
    });

    //滿意度調查
   $('.CustomerSurvey').click(function() {
    var iframeUrl = "https://docs.google.com/forms/d/e/1FAIpQLSfppMYd7h5TCkhkULUrL1FByjnCb_KI_TAF6kX-E2sfT3Pt5w/viewform?embedded=true"; // 替換為實際的 <iframe> 網址
    var width = 1500; // 視窗寬度
    var height =1000; // 視窗高度
    var left = (screen.width - width) / 2; // 視窗左上角 X 座標
    var top = (screen.height - height) / 2; // 視窗左上角 Y 座標
      window.open(iframeUrl, "_blank", "width=" + width + ",height=" + height + ",left=" + left + ",top=" + top);
  });

</script>
