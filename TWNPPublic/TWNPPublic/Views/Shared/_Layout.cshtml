<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="HandheldFriendly" content="True">
    <meta name="MobileOptimized" content="480">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="shortcut icon" href="~/images/favicon.ico" />
    <link rel="bookmark" href="~/images/favicon.ico" />
    <title>@ViewData["Title"] -智慧水網民眾版</title>

    <link rel="stylesheet" href="~/css/All.css">
    <script src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js'></script>
    <!-- <script src="~/js/jquery-2.2.0.min.js" ></script> -->
    <script src="~/js/bootstrap.js"></script>
    <script src="~/js/layout.js"></script>

    <!-- custom scrollbars plugin -->
    <!-- custom scrollbar stylesheet -->
    <link rel="stylesheet" href="~/js/mCustomScrollbar/jquery.mCustomScrollbar.css">
    <script src="~/js/mCustomScrollbar/jquery.mCustomScrollbar.min.js"></script>
    <script src="~/js/mCustomScrollbar/jquery.mCustomScrollbar.concat.min.js"></script>

    <!-- 跑馬燈 -->
    <script type="text/javascript" src="~/js/marquee/jquery.marquee.js"></script>

    <!-- fancyBox套件 -->
    <link rel="stylesheet" href="~/js/fancyBox/jquery.fancybox.css" />
    <script type="text/javascript" src="~/js/fancyBox/jquery.fancybox.js"></script>

    <!-- footable套件 -->
    <link rel="stylesheet" href="~/js/footable/footable.bootstrap.css" />
    <script type="text/javascript" src="~/js/footable/footable.js"></script>

    <!-- 可能是圖台 -->
    <link rel="stylesheet" href="~/css/layerBox.css"/>
    @RenderSection("echart", required: false)
    @RenderSection("validation",required:false)

    <script type="text/javascript">
        // footable
        $(document).ready(function () {
            $(".footable").footable({
            });
        });
    </script>

    <script type="text/javascript">
        //fancybox圖片
        $(document).ready(function () {
            $(".fancybox").fancybox();
        });

        //fancybox 小頁面
        $(document).ready(function () {
            //水號選單
            $.get("@Url.Action("ListedUserWaterNos","Dashboard")", function(result){
                $.each(result.Data.WaterNos,function(index,value){
                    $("#SelectWaterNos").append('<option value=' + value + '>' + value + '</option>');
                });
                $("#SelectWaterNos option[value='"+result.Data.CurrentNos+"']").prop('selected', true);
            });

            //老馬燈AJAX
             $.get("@Url.Action("ListedNews","Dashboard")", function(result){
                if(result.Success){
                    $.each(result.Data,function(index,value){
                        var $ul = $("#marquee1").append("<li>" + value.TITLE + "</li>");
                        // update the marquee
                        $ul.marquee("update");
                    });
                }
             });


            if ($(window).width() < 768) {
                $(".fbox_Add,.fbox_Modify,.fbox_View").fancybox({
                    type: 'iframe',
                    autoSize: false,
                    width: '99.5%',
                    height: '98%'
                });
            } else {

                $(".fbox_Add").fancybox({
                    type: 'iframe',
                    autoSize: false,
                    width: '60%',
                    height: '98%'
                });
                $(".fbox_Modify").fancybox({
                    type: 'iframe',
                    autoSize: false,
                    width: '60%',
                    height: '98%'
                });
                $(".fbox_View").fancybox({
                    type: 'iframe',
                    autoSize: false,
                    width: '80%',
                    height: '98%'
                });
            }

        });

        var LimitSleepTimer = "15:01";
        $(document).ready(function () {
             $(document).mousemove(function (e) {
                timer2 = LimitSleepTimer;
            });
        });

        var timer2 = LimitSleepTimer;
        var interval = setInterval(function () {
            var timer = timer2.split(':');
            var minutes = parseInt(timer[0], 10);
            var seconds = parseInt(timer[1], 10);
            --seconds;
            minutes = (seconds < 0) ? --minutes : minutes;
            if (minutes < 0) clearInterval(interval);
            seconds = (seconds < 0) ? 59 : seconds;
            seconds = (seconds < 10) ? '0' + seconds : seconds;
            $('#LogoutHint').html(minutes + ':' + seconds + '後');
            $('#mobileLogoutHint').html(minutes + ':' + seconds + '後');
            timer2 = minutes + ':' + seconds;
            if (timer2 == "0:00") {
                alert("網頁已閒置超過15分鐘，請從新登入");
                window.location = "@Url.Action("Logout", "Home")";
            }
        }, 1000);
    </script>
</head>
<body>
    @RenderBody()
</body>
</html>
