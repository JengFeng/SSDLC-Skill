    <script type="text/javascript">
        //fancybox圖片
        $(document).ready(function () {
            $(".fancybox").fancybox();
        });

        //fancybox 小頁面
        $(document).ready(function () {
            ////水號選單
            //$.get("@Url.Action("ListedUserWaterNos","Dashboard")", function(result){
            //    $.each(result.Data.WaterNos,function(index,value){
            //        $("#SelectWaterNos").append('<option value=' + value + '>' + value + '</option>');
            //    });
            //    $("#SelectWaterNos option[value='"+result.Data.CurrentNos+"']").prop('selected', true);
            //});

            //console.log('水號選單');
             //水號選單
            $.get(GetWebSiteURL('@Url.Action("ListedUserWaterNos", "Dashboard")'), function(result){
                //console.log(result);
                if( result.Data == undefined ) return ;
                $.each(result.Data.WaterNos,function(index,value){
                    // if( result.Data.Name == '7D767220354' && result.Data.CurrentNos == '7D767190014'){
                    //     $(".SelectWaterNoslist").append('<option value=7D767220354>7D767220354</option>');
                    // }
                    // else if( result.Data.Name == '7D760002010' && result.Data.CurrentNos == '7D760003007'){
                    //     $(".SelectWaterNoslist").append('<option value=7D760002010>7D760002010</option>');
                    // }
                    // else{

                    //     if (value.NICK_NAME_SHOW == "1") {
                    //         $(".SelectWaterNoslist").append('<option value=' + value.WATER_NO + ' title=' + value.NICK_NAME + '>' + value.WATER_NO + '</option>');
                    //     }
                    //     else {
                    //         $(".SelectWaterNoslist").append('<option value=' + value.WATER_NO + '>' + value.WATER_NO + '</option>');
                    //     }
                    // }

                     if (value.NICK_NAME_SHOW == "1") {
                          $(".SelectWaterNoslist").append('<option value=' + value.WATER_NO + ' title=' + value.NICK_NAME + '>' + value.WATER_NO + '</option>');
                     }
                     else {
                         $(".SelectWaterNoslist").append('<option value=' + value.WATER_NO + '>' + value.WATER_NO + '</option>');
                     }
                    
                });

                // if ( result.Data.Name == '7D767220354' && result.Data.CurrentNos == '7D767190014' ){
                //     $(".SelectWaterNoslist option[value='7D767220354']").prop('selected', true);
                // }
                // else if( result.Data.Name == '7D760002010' && result.Data.CurrentNos == '7D760003007' ){
                //     $(".SelectWaterNoslist option[value='7D760002010']").prop('selected', true);
                // }
                // else{
                //      $(".SelectWaterNoslist option[value='"+result.Data.CurrentNos+"']").prop('selected', true);
                // }

                $(".SelectWaterNoslist option[value='"+result.Data.CurrentNos+"']").prop('selected', true);
               
               // 初始化 Select2
                $('.SelectWaterNoslist').select2({
                    placeholder: '請選擇或搜尋水號',
                    allowClear: false,
                    width: '100%',
                    language: {
                        noResults: function() {
                            return "查無相關結果";
                        },
                        searching: function() {
                            return "搜尋中...";
                        }
                    },
                    // 自訂搜尋邏輯：搜尋水號和 title 中的暱稱
                    matcher: function(params, data) {
                        // 如果沒有搜尋字串，顯示所有選項
                        if (!params.term || $.trim(params.term) === '') {
                            return data;
                        }

                        // 轉小寫以不區分大小寫
                        var term = params.term.toLowerCase();

                        // 取得選項的水號（text）
                        var waterNo = data.text.toLowerCase();

                        // 從 DOM 元素取得 title 屬性（暱稱）
                        var $element = $(data.element);
                        var nickname = $element.attr('title');

                        // 搜尋水號
                        if (waterNo.indexOf(term) > -1) {
                            return data;
                        }

                        // 搜尋暱稱（title 屬性）
                        if (nickname && nickname.toLowerCase().indexOf(term) > -1) {
                            return data;
                        }

                        // 都不符合則不顯示
                        return null;
                    }
                });

            });

            //老馬燈AJAX
             $.get(GetWebSiteURL('@Url.Action("ListedNews", "Dashboard")'), function(result){
                if(result.Success){
                    $("#marquee1").empty();
                    $.each(result.Data,function(index,value){
                        $("#marquee1").append("<li>" + value.TITLE + "</li>").ready(function(){});
                        // update the marquee
                    });
                }
                $("#marquee1").marquee();
             });


            if ($(window).width() < 768) {
                $(".fbox_Add,.fbox_Modify,.fbox_View").fancybox({
                    type: 'iframe',
                    autoSize: false,
                    width: '99.5%',
                    height: '98%'
                });
            } else {

                $(".fbox_Add").fancybox({
                    type: 'iframe',
                    autoSize: false,
                    width: '60%',
                    height: '98%'
                });
                $(".fbox_Modify").fancybox({
                    type: 'iframe',
                    autoSize: false,
                    width: '60%',
                    height: '98%'
                });
                $(".fbox_View").fancybox({
                    type: 'iframe',
                    autoSize: false,
                    width: '80%',
                    height: '98%',
                    beforeLoad: function () {                            
                           let model = {
                                 Cdate : '@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")'
                            };
                            $.get(GetWebSiteURL('@Url.Action("Fancybox_tableChart", "Dashboard")'),model,function(result){
                    
                                if ( result.includes('忘記密碼') )
                                {
                                    window.location.href = GetWebSiteURL('@Url.Action("Login", "Home")');
                                }
                             });
                        }
                });
            }

        });

        var LimitSleepTimer = "15:01";
        $(document).ready(function () {
             $(document).mousemove(function (e) {
                timer2 = LimitSleepTimer;
            });
        });

        var timer2 = LimitSleepTimer;
        var interval = setInterval(function () {
            var timer = timer2.split(':');
            var minutes = parseInt(timer[0], 10);
            var seconds = parseInt(timer[1], 10);
            --seconds;
            minutes = (seconds < 0) ? --minutes : minutes;
            if (minutes < 0) clearInterval(interval);
            seconds = (seconds < 0) ? 59 : seconds;
            seconds = (seconds < 10) ? '0' + seconds : seconds;
            $('#LogoutHint').html(minutes + ':' + seconds + '後');
            $('#mobileLogoutHint').html(minutes + ':' + seconds + '後');
            timer2 = minutes + ':' + seconds;
            if (timer2 == "0:00") {
                alert("網頁已閒置超過15分鐘，請從新登入");
                window.location = GetWebSiteURL('@Url.Action("Logout", "Home")');
            }
        }, 1000);

        //區分是直接從民眾版進入，還是從業務版進入
        var params = new URLSearchParams(window.location.search);
        if (params.has('fromtwn')) {
            sessionStorage.setItem('fromtwn', params.get('fromtwn'));
        }
    </script>
</head>
<body>
    @RenderBody()
</body>
</html>
