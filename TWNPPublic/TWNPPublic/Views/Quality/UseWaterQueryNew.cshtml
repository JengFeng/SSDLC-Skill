<script>
    $(function () {
        $("#inputStartTime").val("@DateTime.Now.AddDays(-1).ToString("yyyy/MM/dd 00:00")");//.val("@DateTime.Now.AddYears(-1).AddMonths(-1).AddDays(9).ToString("yyyy-MM-dd 00:00")");
        $("#inputEndTime").val("@DateTime.Now.AddDays(-1).ToString("yyyy/MM/dd 23:00")");//.val("@DateTime.Now.AddYears(-1).AddMonths(-1).AddDays(9).ToString("yyyy-MM-dd 23:00")");
        $(".menuList > a:nth-child(2)").addClass("active").siblings().removeClass("active");
        // 預設顯示小時對應的 checkbox
        $("#checkbox-group-day, #checkbox-group-month, #checkbox-group-year").show();
        console.log("ready!");
        // 頁面載入時，根據預設值更新 checkbox 顯示
        updateCheckboxVisibility($("#form-name").val());
        SettingTxtDate();
        // select 選單變更
        $("#form-name").change(function () {
            updateCheckboxVisibility($(this).val());
            updateDateInput($(this).val());
            btnSearch();
        });
        
        $("#inputStartTime").on("input", function () {
            if ($("#form-name").val() == 'hour') {
                $("#inputEndTime").val($("#inputStartTime").val().split(' ')[0] + " 23:00");
            }
        });

        $("#checkbox-day").prop("checked", true);
        btnSearch();
    });
</script>

