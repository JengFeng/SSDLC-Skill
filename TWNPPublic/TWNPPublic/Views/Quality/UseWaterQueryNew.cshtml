        for (var i = 0; i < JsonDatas.length; i++) {

            var Item = JsonDatas[i];
            var Datas = JsonDatas[i].Datas;//API取得的資料
            //沒資料時跳過
            if (Datas == undefined || Datas.result == null || Datas.result == undefined || Datas.result.length < 1)
                continue;

            //轉換資料
            Datas.result.forEach(function (d) {
                if (d.Y == null)
                    return;//continue的效果
                let X = d.X;
                if ($("#form-name").val() == 'hour') X = d.X.split('T')[1].substring(0, 5);//d.X.replace('T', ' ');
                if ($("#form-name").val() == 'day' || $("#form-name").val() == 'week' || $("#form-name").val() == 'month') {
                    //X = d.X.split('T')[0];
                    const datePart = d.X.split('T')[0]; // 取得日期部分 "2024-01-16"
                    const parts = datePart.split('-');  // 取得 ["2024", "01", "16"]
                    const monthDay = parts[1] + '-' + parts[2]; // 組合成 "01-16"
                    X = monthDay.replace('-', '/');
                }
                if ($("#form-name").val() == 'year') {
                    //X = d.X.split('T')[0];
                    const datePart = d.X.split('T')[0]; // 取得日期部分 "2024-01-16"
                    const parts = datePart.split('-');  // 取得 ["2024", "01", "16"]
                    const monthDay = parts[0]; // 組合成 "2024"
                    X = monthDay.replace('-', '/');
                }
               
                let Y = d.Y;//d.Y.toFixed(2);
                let DataID = Item.DataID;
                let strDate2 = new Date(d.X);
                Source_Data.push([strDate2, X, Y, DataID]);
            });
            console.log(Source_Data);

            //塞入資料篩選條件
            Datasets.push(
                {
                    id: Item.DataID,               //對應series中的datasetId
                    fromDatasetId: "Datasets_",    //對應[Datasets陣列]中的id
                    transform: {  //篩選資料
                        type: "filter",
                        config: { dimension: "DataID", value: Item.DataID }//要篩選Source_Data裡的哪個欄位以及哪個值

                    }
                }
            );

            //序列
            Series.push(
                {
                    type: "bar",
                    name: Item.SeriesName, //序列顯示名稱
                    datasetId: Item.DataID, //對應[Datasets陣列]中的id
