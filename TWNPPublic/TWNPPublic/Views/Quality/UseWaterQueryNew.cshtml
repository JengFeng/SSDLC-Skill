        // 驗證日期範圍的邏輯
    async function validateDateRange(startDate, endDate, Type) {
        // 定義對應時間格式
        let format;
        switch (Type) {
            case "hour":
                format = "YYYY/MM/DD HH:mm";
                break;
            case "day":
                format = "YYYY/MM/DD";
                break;
            case "week":
                format = "YYYY/MM";
                break;
            case "month":
                format = "YYYY/MM";
                break;
            case "year":
                format = "YYYY";
                break;
            default:
                format = null;
                break;
        }

        // 檢查格式是否正確
        if (format === null) {
            alert("請選擇X軸維度!!");
            return false;
        }

        // 檢查日期格式是否符合
        if (!moment(startDate, format, true).isValid() || !moment(endDate, format, true).isValid()) {
            alert(`時間格式不正確，請使用 ${format} 格式`);
            return false;
        }

        // 轉換為 Date 物件
        let Sdate = moment(startDate, format).toDate();
        let Edate = moment(endDate, format).toDate();

        // // 檢查 Type 為 "hour" 時，是否超過 24 小時
        // if (Type === "hour") {
        //     let diffHours = (Edate - Sdate) / (1000 * 60 * 60); // 換算成小時
        //     if (diffHours >= 24) {
        //         alert("開始時間和結束時間的差距不能等於或超過 24 小時");
        //         return false;
        //     }
        // }

        // 檢查 Type 為 "hour" 時，確保開始時間和結束時間為同一天，且時間差不能等於或超過 24 小時
        if (Type === "hour") {
            // 確保開始時間和結束時間是同一天
            if (!moment(Sdate).isSame(Edate, 'day')) {
                alert("開始時間和結束時間必須在同一天");
                return false;
            }

            // 計算時間差（小時）
            let diffHours = moment(Edate).diff(moment(Sdate), 'hours', true);
            if (diffHours >= 24) {
                alert("開始時間和結束時間的差距不能等於或超過 24 小時");
                return false;
            }
        }

        // 檢查時間差是否超過 3 年
        let diffDays = (Edate - Sdate) / (1000 * 60 * 60 * 24); // 換算成天數
        if (diffDays > 365 * 3) { // 3 年大約是 365*3 天
            alert("開始時間和結束時間的差距不能超過 3 年");
            return false;
        }

        return true; // 驗證通過
    }

    async function btnSearch() {
        JsonDatas = []; //清空資料
        let model = {
            startDate: $("#inputStartTime").val(),
            endDate: $("#inputEndTime").val(),
            Type: $('#form-name').val(),
            TimeType: '',
        };

        if ($("#form-name").val() == 'year') {
            model.Sdate =  $("#inputStartTime").val()+"-01-01";
            model.Edate =  $("#inputEndTime").val()+"-12-31";
        }

        // 呼叫 validateDateRange 來檢查日期範圍是否有效
        console.log("開始日期:", $("#inputStartTime").val());
        let startDate = $("#inputStartTime").val();
        let endDate = $("#inputEndTime").val();
        let Type = $('#form-name').val();

        let isValid = await validateDateRange(startDate, endDate, Type);
        if (!isValid) {
            return; // 如果日期範圍無效，則停止後續操作
        }

        let promises = []; // 用來存儲所有的 QueryData() 呼叫
        
        // 疊加1
        let QueryDataItem = {
            SeriesName: '查詢日期',//$('#form-name').val(),
            DataID: '1',
            StartDate: $("#inputStartTime").val(),
            EndDate: $("#inputEndTime").val(),
        };
        console.log(QueryDataItem);
        await promises.push(QueryData(QueryDataItem, model)); // 加入 Promise 陣列

        // 取得所有勾選的 checkbox 值 (套疊曲線)
        checkedValues = [];
        checkedValues = Array.from(document.querySelectorAll(".checkbox-group input[type='checkbox']:checked"))
            .map(cb => cb.value);
        console.log(checkedValues);
        checkedValues.forEach(value => {
            switch (value) {
                case "day":
                    model.TimeType = 'day';
                    let QueryDataItem2 = {
                        SeriesName: '前一日',
                        DataID: '2',
                    };
                    promises.push(QueryData(QueryDataItem2, model)); // 加入 Promise 陣列
                    break;
                case "month":
                    model.TimeType = 'month';
                    let QueryDataItem3 = {
                        SeriesName: '前一個月',
                        DataID: '3',
                    };
                    promises.push(QueryData(QueryDataItem3, model)); // 加入 Promise 陣列
                    break;
                case "year":
                    model.TimeType = 'year';
                    let QueryDataItem4 = {
                        SeriesName: '前一年',
                        DataID: '4',
                    };
                    promises.push(QueryData(QueryDataItem4, model)); // 加入 Promise 陣列
                    break;
                default:
                    console.log("未知選項");
            }
        });

        // **等待所有 QueryData() 完成後，才執行 SetStationData()**
        await Promise.all(promises);
        SetStationData();

        //同用水種別上年度同期平均用水量
        let checkedWaterValues = [];
        $('#c').text('');
        checkedWaterValues = Array.from(document.querySelectorAll(".checkbox-group-water input[type='checkbox']:checked"))
            .map(cb => cb.value);

        checkedWaterValues.forEach(value => {
            switch (value) {
                case "waterType":
                    QueryWaterTypeData();
                    break;
                default:
                    console.log("未知選項");
            }
        });
    }

    function QueryWaterTypeData(){

