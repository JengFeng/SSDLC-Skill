                    },  // 保存圖片
                    restore: {
                        show: false,     // 是否顯示
                        title: "還原",  // 工具名稱
                    },      // 還原配置
                    dataView: {
                        show: false,                         // 是否顯示
                        title: '資料檢視',                   // 工具名稱
                        readOnly: false,                    // 是否唯讀
                        lang: ['資料顯示', '關閉', '更新'],
                        backgroundColor: "#FFFFFF",         // 背景顏色
                        textareaColor: "#D5D5D5",           // 輸入背景顏色
                        textareaBorderColor: '#1E1E1E',     // 輸入邊框顏色
                        textColor: "#000",                  // 文字顏色
                        buttonColor: "#4472C4",             // 按鈕顏色
                        buttonTextColor: "#fff",            // 按鈕文字顏色
                    },     // 資料檢視(顯示統計圖之統計資料，編輯後可動態更新)
                    magicType: {
                        show: true, // 是否顯示
                        title: {
                            line: '切換為折線圖',
                            bar: '切換為長條圖',
                            //stack: '切換為堆疊模式',
