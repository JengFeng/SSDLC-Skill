                // // //},
                // // {
                // //     type: 'inside',
                // //     yAxisIndex: [0],
                // //     start: 29,
                // //     end: 36
                // // }
            ],  // 縮放功能
            tooltip: {
                trigger: 'axis'    // item, axis
                , axisPointer: {   // 坐标轴指示器，坐标轴触发有效
                    type: 'cross'  //shadow' // 默认为直线，可选为：'line' | 'shadow'
                }

                //,enterable: true, // 鼠标是否可进入提示框浮层中

                //被計算過後a0的值就是標準差
                , formatter: function (param) {
                    var list = param.length == undefined ? [param] : param;
                    var temp = '';
                    for (var i = 0; i < list.length; i++) {

                        if (i == 0) temp += list[i].axisValueLabel;
                        var value = '{0}[{1}]：{2}'
                            .replace('{0}', list[i].marker)
                            .replace('{1}', list[i].seriesName)
                            .replace('{2}', list[i].data[2]);

                        temp += '<br />' + value;
                    }
                    return temp;
                }
            },//提示訊息
            legend: {
                type: 'scroll',             //圖例有scroll Bar 'plain'：普通图例。缺省就是普通图例。
