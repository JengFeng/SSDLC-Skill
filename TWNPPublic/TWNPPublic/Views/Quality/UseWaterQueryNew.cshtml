        // 驗證日期範圍的邏輯
    async function validateDateRange(startDate, endDate, Type) {
        // 定義對應時間格式
        let format;
        switch (Type) {
            case "hour":
                format = "YYYY/MM/DD HH:mm";
                break;
            case "day":
                format = "YYYY/MM/DD";
                break;
            case "week":
                format = "YYYY/MM";
                break;
            case "month":
                format = "YYYY/MM";
                break;
            case "year":
                format = "YYYY";
                break;
            default:
                format = null;
                break;
        }

        // 檢查格式是否正確
        if (format === null) {
            alert("請選擇X軸維度!!");
            return false;
        }

        // 檢查日期格式是否符合
        if (!moment(startDate, format, true).isValid() || !moment(endDate, format, true).isValid()) {
            alert(`時間格式不正確，請使用 ${format} 格式`);
            return false;
        }

        // 轉換為 Date 物件
        let Sdate = moment(startDate, format).toDate();
        let Edate = moment(endDate, format).toDate();

        // // 檢查 Type 為 "hour" 時，是否超過 24 小時
        // if (Type === "hour") {
        //     let diffHours = (Edate - Sdate) / (1000 * 60 * 60); // 換算成小時
        //     if (diffHours >= 24) {
        //         alert("開始時間和結束時間的差距不能等於或超過 24 小時");
        //         return false;
        //     }
        // }

        // 檢查 Type 為 "hour" 時，確保開始時間和結束時間為同一天，且時間差不能等於或超過 24 小時
        if (Type === "hour") {
            // 確保開始時間和結束時間是同一天
            if (!moment(Sdate).isSame(Edate, 'day')) {
                alert("開始時間和結束時間必須在同一天");
                return false;
            }

            // 計算時間差（小時）
            let diffHours = moment(Edate).diff(moment(Sdate), 'hours', true);
            if (diffHours >= 24) {
                alert("開始時間和結束時間的差距不能等於或超過 24 小時");
                return false;
            }
        }

        // 檢查時間差是否超過 3 年
        let diffDays = (Edate - Sdate) / (1000 * 60 * 60 * 24); // 換算成天數
        if (diffDays > 365 * 3) { // 3 年大約是 365*3 天
            alert("開始時間和結束時間的差距不能超過 3 年");
            return false;
        }

        return true; // 驗證通過
    }

    async function btnSearch() {
        JsonDatas = []; // 清空資料
        let model = {
            startDate: $("#inputStartTime").val(),
            endDate: $("#inputEndTime").val(),
            Type: $('#form-name').val(),
            TimeType: '',
        };

        // 呼叫 validateDateRange 來檢查日期範圍是否有效
        console.log("開始日期:", $("#inputStartTime").val());
        let startDate = $("#inputStartTime").val();
        let endDate = $("#inputEndTime").val();
        let Type = $('#form-name').val();

        let isValid = await validateDateRange(startDate, endDate, Type);
        if (!isValid) {
            return; // 如果日期範圍無效，則停止後續操作
        }

        let promises = []; // 用來存儲所有的 QueryData() 呼叫

        // 疊加1
        let QueryDataItem = {
            SeriesName: '查詢日期',
            DataID: '1',
            StartDate: $("#inputStartTime").val(),
            EndDate: $("#inputEndTime").val(),
        };
        console.log(QueryDataItem);
        promises.push(QueryData(QueryDataItem, model)); // 加入 Promise 陣列

        // 取得所有勾選的 checkbox 值 (套疊曲線)
        let checkedValues = Array.from(document.querySelectorAll(".checkbox-group input[type='checkbox']:checked"))
            .map(cb => cb.value);
        console.log(checkedValues);

        checkedValues.forEach(value => {
            switch (value) {
                case "day":
                    model.TimeType = 'day';
                    let QueryDataItem2 = { SeriesName: '前一日', DataID: '2' };
                    promises.push(QueryData(QueryDataItem2, model));
                    break;
                case "month":
                    model.TimeType = 'month';
                    let QueryDataItem3 = { SeriesName: '前一個月', DataID: '3' };
                    promises.push(QueryData(QueryDataItem3, model));
                    break;
                case "year":
                    model.TimeType = 'year';
                    let QueryDataItem4 = { SeriesName: '前一年', DataID: '4' };
                    promises.push(QueryData(QueryDataItem4, model));
                    break;
                default:
                    console.log("未知選項");
            }
        });

        // **等待所有 QueryData() 完成後，才執行 SetStationData()**
        await Promise.all(promises);
        SetStationData();

        // 同用水種別上年度同期平均用水量
        let checkedWaterValues = Array.from(document.querySelectorAll(".checkbox-group-water input[type='checkbox']:checked"))
            .map(cb => cb.value);

        checkedWaterValues.forEach(value => {
            switch (value) {
                case "waterType":
                    QueryWaterTypeData();
                    break;
                default:
                    console.log("未知選項");
            }
        });
    }

    function QueryWaterTypeData(){
        let model = {
            StartDate: $("#inputStartTime").val(),
            EndDate: $("#inputEndTime").val(),
        };

        $.post(GetWebSiteURL('@Url.Action("QueryWaterTypeData", "Quality")'), model, function (result) {
            console.log(result);
            if (result.Success) {
                if (result.Data == null || result.Data.length == 0) {
                    $('#c').text('同用水種別上年度同期平均用水量:-度');
                } else {
                    $('#c').html('同用水種別上年度同期平均用水量:<span style="color: #721c24;">' + result.Data.AVG_LASTYEARQTY + '</span>度');
                }
                $("#waterTypeContainer").show();
            } else {
                $('#c').text('同用水種別上年度同期平均用水量:-度');
                $("#waterTypeContainer").show();
            }
        });
    }

    // 使用起訖時間來查詢資料
    function QueryData(QueryDataItem, model) {
        return new Promise((resolve, reject) => {
            GetUserWaterData(model).then(Datas => {
                console.log("Datas:", Datas);
                QueryDataItem.Datas = Datas;
                if (QueryDataItem.SeriesName == '查詢日期') {
                    var title = '';
                    let currentMode = $("#form-name").val();
                    if (currentMode == 'hour') title = $("#inputStartTime").val();
                    else title = $("#inputStartTime").val() + "~" + $("#inputEndTime").val();

                    $('#a').html('(' + title + ') 之<span style="color: #0c5460;">【最低】</span>之時段:' + Datas.lowData);
                    $('#b').html('(' + title + ')' + ' 之<span style="color: #0c5460;">【最高】</span>之時段:' + Datas.heighData);
                }
                JsonDatas.push(QueryDataItem);
                resolve();
            }).catch(error => {
                console.log("取得數據時發生錯誤:", error);
                reject(error);
            });
        });
    }

    // 取得用水量資料
    function GetUserWaterData(model) {
        console.log('☆☆☆☆☆取得用水量資料☆☆☆☆☆');
        let url = GetWebSiteURL('@Url.Action("WaterNoteTableChart2", "Dashboard")');

        return new Promise((resolve, reject) => {
            $.post(url, model, function (result) {
                $("#spanError").text('');
                if (result.Success) {
                    if (!result.Data || result.Data.length === 0) {
                        $("#spanError").text('此時間段尚無資料');
                        myChart.clear();
                        resolve([]);
                    } else {
                        resolve(result.Data);
                    }
                } else {
                    alert(result.Message);
                    $("#spanError").text("查無資料");
                    myChart.clear();
                    reject(new Error('API 回應失敗'));
                }
            }).fail(function (xhr, status, error) {
                console.error("請求失敗:", error);
                $("#spanError").text('請求發生錯誤');
                myChart.clear();
                reject(error);
            });
        });
    }

    // 新增的資料清洗加工核心函式
    function ProcessAndPushData(Source_Data, Datas, dataID) {
        if (!Datas || !Datas.result) return;

        Datas.result.forEach(function (d) {
            if (d.Y == null) return; // 過濾掉無效的空資料

            let X = d.X; // 原始後端回傳時間，例如 "2026-01-16T08:00:00"
            let currentMode = $("#form-name").val(); // 獲取當前觀測的時間維度

            // 情境 A：小時維度 -> 跨日對齊。必須切除日期，只保留時分 "08:00"
            if (currentMode == 'hour') {
                X = d.X.split('T')[1].substring(0, 5);
            }
            // 情境 B：日、週、月維度 -> 跨年對齊。將 "2026-01-16" 格式化為 "01/16"
            else if (currentMode == 'day' || currentMode == 'week' || currentMode == 'month') {
                const datePart = d.X.split('T')[0]; // 提取 "2026-01-16"
                const parts = datePart.split('-');  // 拆分為 ['2026', '01', '16']
                X = parts[1] + '/' + parts[2];      // 拼裝為 "01/16"
            }
            // 情境 C：年度維度 -> 大跨度趨勢對比。只保留年份字串 "2026"
            else if (currentMode == 'year') {
                const datePart = d.X.split('T')[0];
                X = datePart.split('-')[0]; // 提取 "2026"
            }

            let Y = d.Y;
            let rawDate = new Date(d.X); // 保留原始時間戳記物件

            // 灌入全域二維陣列
            Source_Data.push([rawDate, X, Y, dataID]);
        });
    }

    // 畫出 Chart 圖 (整合重構後精簡重點的實作)
    function SetStationData() {
        if (!JsonDatas || JsonDatas.length < 1 || !JsonDatas[0].Datas || !JsonDatas[0].Datas.result || JsonDatas[0].Datas.result.length < 1) {
            return;
        }

        // 1. 定義排序規則並排序 JsonDatas
        const sortOrder = ["查詢日期", "前一日", "前一個月", "前一年"];
        JsonDatas.sort((a, b) => sortOrder.indexOf(a.SeriesName) - sortOrder.indexOf(b.SeriesName));

        // 2. 顯示圖表區塊
        var divID = 'mychart';
        $('#' + divID).show();

        // 3. 初始化全域中央資料集 (每次渲染皆為新實例，避免資料重複疊加)
        var Source_Data = [["Date", "X", "Y", "DataID"]];

        // 4. 呼叫資料清洗函式灌入資料
        for (var i = 0; i < JsonDatas.length; i++) {
            ProcessAndPushData(Source_Data, JsonDatas[i].Datas, JsonDatas[i].DataID);
        }

        // 5. 動態對應 X 軸名稱
        var xName = $("#form-name").val();
        const xNameMap = { 'hour': '時間(小時)', 'day': '時間(日期)', 'week': '時間(週)', 'month': '時間(月份)' };
        xName = xNameMap[xName] || '時間(年份)';

        // 6. 初始化基礎 Option 設定與 MasterDataset
        var option = {
            grid: [{ show: true, bottom: 80, containLabel: true }],
            legend: { type: 'scroll', orient: 'horizontal', top: 'bottom', left: 'center', padding: [0, 0, 15, 0] },
            tooltip: {
                trigger: 'axis',
                axisPointer: { type: 'cross' },
                formatter: function (param) {
                    var list = param.length == undefined ? [param] : param;
                    var temp = '';
                    for (var i = 0; i < list.length; i++) {
                        if (i == 0) temp += list[i].axisValueLabel;
                        // list[i].data[2] 對應 Source_Data 裡的 "Y" 欄位
                        var value = '{0}[{1}]：{2} 度'
                            .replace('{0}', list[i].marker)
                            .replace('{1}', list[i].seriesName)
                            .replace('{2}', list[i].data[2]);
                        temp += '<br />' + value;
                    }
                    return temp;
                }
            },
            dataset: [
                {
                    id: "MasterDataset_Source",
                    source: Source_Data // 注入清洗完畢的全域大陣列
                }
            ],
            xAxis: {
                type: 'category',
                name: xName,
                nameLocation: 'end'
            },
            yAxis: {
                type: 'value',
                name: '用水度數(度)',
                position: 'top',
                axisLine: { show: true }
            },
            toolbox: {
                show: true,
                feature: {
                    saveAsImage: { show: true, type: 'png', title: '另存為圖片', name: '用水量對比圖' },
                    magicType: { show: true, title: { line: '切換為折線圖', bar: '切換為長條圖' }, type: ['line', 'bar'] }
                }
            },
            series: [] // 動態推入
        };

        // 7. 疊代指標包，建立分流過濾通道與 Series
        JsonDatas.forEach(Item => {
            // 關鍵步驟 A：建立「衍生數據集過濾轉接器」
            option.dataset.push({
                id: `Dataset_Filter_Route_${Item.DataID}`,
                fromDatasetId: "MasterDataset_Source",
                transform: {
                    type: "filter",
                    config: { dimension: "DataID", value: Item.DataID }
                }
            });

            // 關鍵步驟 B：建立 Series 設定，拋棄傳統 data 屬性
            option.series.push({
                type: "bar", // 預設為長條圖，可透過工具列切換成折線圖
                name: Item.SeriesName,
                datasetId: `Dataset_Filter_Route_${Item.DataID}`, // 綁定分流通道 ID
                showSymbol: false,
                encode: {
                    x: "X",
                    y: "Y",
                    itemName: "Date",
                    tooltip: ["Y"]
                }
            });
        });

        // 8. 視窗縮放自適應
        window.onresize = function () {
            myChart.resize();
        };

        // 9. 執行最終渲染 (使用 true 完全覆蓋舊配置)
        myChart.clear();
        myChart.setOption(option, true);
    }

    function padLeft(word, lenght, char) {
        var str = word.toString();
        if (str.length >= lenght)
            return str;
        else
            return padLeft(char + str, lenght);
    }

    //擴充javascript的Date功能
    Date.prototype.addDays = function (days) {
        this.setDate(this.getDate() + days);
        return this;
    }
    //擴充javascript的Date功能
    Date.prototype.addMonths = function (Months) {
        this.setMonth(this.getMonth() + Months);
        return this;
    }
    //擴充javascript的Date功能
    Date.prototype.addYears = function (Years) {
        this.setFullYear(this.getFullYear() + Years);
        return this;
    }

</script>
