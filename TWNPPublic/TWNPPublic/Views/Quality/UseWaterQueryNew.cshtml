    // 使用起訖時間來查詢資料
    function QueryData(QueryDataItem, model) {
        return new Promise((resolve, reject) => { // 確保函式回傳 Promise
            GetUserWaterData(model).then(Datas => {
                console.log("Datas:", Datas);
                QueryDataItem.Datas = Datas;
                if (QueryDataItem.SeriesName == '查詢日期') {
                    var title = '';
                    if ($("#form-name").val() == 'hour') {
                        title = $("#inputStartTime").val();
                    }
                    else if ($("#form-name").val() == 'day') {
                        title = $("#inputStartTime").val()+"~"+$("#inputEndTime").val();
                    }
                    else if ($("#form-name").val() == 'week' || $("#form-name").val() == 'month') {
                        title = $("#inputStartTime").val() + "~" + $("#inputEndTime").val();
                    }
                    else if ($("#form-name").val() == 'year') {
                        title = $("#inputStartTime").val() + "~" + $("#inputEndTime").val();
                    }
                    $('#a').html('(' + title + ') 之<span style="color: #0c5460;">【最低】</span>之時段:' + Datas.lowData);
                    $('#b').html('(' + title + ')' + ' 之<span style="color: #0c5460;">【最高】</span>之時段:' + Datas.heighData);
                }
                JsonDatas.push(QueryDataItem); // 加入陣列
                resolve(); // **通知這個 QueryData() 已完成**
            }).catch(error => {
                console.log("取得數據時發生錯誤:", error);
                reject(error); // **發生錯誤時，拒絕 Promise**
            });
        });
    }

    // 取得用水量資料
    function GetUserWaterData(model) {
        console.log('☆☆☆☆☆取得用水量資料☆☆☆☆☆');

        let url = GetWebSiteURL('@Url.Action("WaterNoteTableChart2", "Dashboard")');

        return new Promise((resolve, reject) => {
            $.post(url, model, function (result) {
                $("#spanError").text('');

                if (result.Success) {
                    if (!result.Data || result.Data.length === 0) {
                        $("#spanError").text('此時間段尚無資料');
                        myChart.clear();
                        resolve([]); // 回傳空陣列，表示沒有資料
                    } else {
                        resolve(result.Data); // 正確回傳數據
                    }
                } else {
                    alert(result.Message);
                    $("#spanError").text("查無資料");
                    myChart.clear();
                    reject(new Error('API 回應失敗'));
                }
            }).fail(function (xhr, status, error) {
                console.error("請求失敗:", error);
                $("#spanError").text('請求發生錯誤');
                myChart.clear();
                reject(error);
            });
        });
    }

