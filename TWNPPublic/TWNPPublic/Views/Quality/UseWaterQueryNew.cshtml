                            color: colors[i]
                        }
                    },
                    axisLabel: {
                        formatter: '{value} '
                    }
                }
                )//yAxis_Array.push END
            }
        
        }


        //塞入所有資料集
        Datasets.splice(0, 0, {
            id: "Datasets_",
            source: Source_Data
        });

        window.onresize = function () {
            myChart.resize();
        };

        myChart.clear();

        //圖表設定
        var option = {
