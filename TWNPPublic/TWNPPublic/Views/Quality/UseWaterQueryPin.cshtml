    var allHours = [];
    ///水表指針比較要匯出所以時段資料，再去要一次資料
    function excelAllTimeData() {
        MM.mask.showInText("資料下載中...");
        return new Promise((resolve, reject) => {
            let url = GetWebSiteURL('@Url.Action("WaterNoteTableChart3", "Dashboard")');

            allHours = [];  //每次先清空，避免重複累加
            // 收集所有 checkbox 的值（不管有沒有勾選）
            $(".checkbox-group input[type='checkbox']").each(function () {
                allHours.push($(this).val());
            });

            let model = {
                StartDate: $("#inputStartTime").val(),
                EndDate: $("#inputEndTime").val(),
                HoursList: allHours,
                hoursPart:false
            };

            $.ajax({
                type: "POST",
                url: url,
                data: model,
                success: function (result) {
                    MM.mask.hide();
                    if (result.Success) {
                        if (result.Data.length === 0) {
                            alert('此時間段尚無資料');
                            resolve(null);  // 沒有資料
                        } else {
                            resolve(result.Data);  // 回傳資料
                        }
                    } else {
                        alert(result.Message || '查詢失敗');
                        resolve(null);
                    }
                },
                error: function (xhr, status, error) {
                    MM.mask.hide();
                    console.error("Ajax 錯誤：", status, error);
                    //alert('伺服器錯誤或無法連線，請稍後再試'+' status:'+status+' error'+error);
                    //let url = GetWebSiteURL('@Url.Action("WaterNoteTableChart3", "Dashboard")');
                    // 顯示錯誤訊息給使用者（可選擇精簡）
                    // alert(
                    //     '伺服器錯誤或無法連線，請稍後再試\n' +
                    //     'HTTP 狀態: ' + xhr.status + '\n' +
                    //     '錯誤訊息: ' + error + '\n\n' +
                    //     '網頁'+url+'\n\n' +
                    //     '如問題持續發生，請聯絡系統管理員。'
                    // );
                     alert(
                        '伺服器錯誤或無法連線，請稍後再試\n' +
                        '如問題持續發生，請聯絡系統管理員。'
                    );
                    reject(error);
                }
            });
        });
    }


