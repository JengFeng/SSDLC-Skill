@{
    ViewData["Title"] = "用水指針查詢";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section echart {
    <script type="text/javascript" src="~/js/echarts/echarts.js"></script>
    <script type="text/javascript" src="~/js/Common.js"></script>
    <script type="text/javascript" src="~/js/Easymap/7/MMJS/mask.js"></script>
}

<!-- CSS 區塊 -->
<style>
    table {
        width: 100%;
        border-collapse: collapse; /* 確保邊框合併 */
    }

    th, td {
        border: 1px solid black; /* 設定邊框顏色 */
        padding: 8px;
        text-align: center;
    }

    th {
        background-color: #f2f2f2; /* 表頭背景色 */
    }
    /* 頁籤樣式 */
    .tab {
        cursor: pointer;
        padding: 8px 16px;
        margin-right: 10px;
    }

    .tab.active {
        font-weight: bold;
        border-bottom: 2px solid blue;
    }

    .air-datepicker {
        z-index: 99999 !important;
    }

</style>

<!-- HTML 主區塊 -->
<div class="pageWrap">
    <partial name="_MenuPartial" />
    <div class="pageArea">
        <partial name="_NewsBoxPartial" />
        <div class="mainGroup">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index","Dashboard")">
                            <i class="bi bi-house-door-fill"></i>首頁
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">用水指針查詢</li>
                </ol>
            </nav>

            <!-- 頁籤切換區：水表指針比較(表格) 與 水表指針圖表 -->
            <div class="tabContainer" style="margin-bottom:15px;">
                <span id="tabComparison" class="tab active">水表指針比較</span>
                <span id="tabChart" class="tab">水表指針圖表</span>
            </div>

            <!-- 搜尋區 -->
            @* <div class="search-inline row">
                <div class="mb-3 col-xs-12 col-lg-12">
                    <label class="form-label">
                        <i class="bi bi-search"></i>日期起
                    </label>
                    <input type="text" class="form-control mb-3 col-xs-6 col-lg-6" id="inputStartTime">
                </div>
                <div class="mb-3 col-xs-12 col-lg-12">
                    <label class="form-label">
                        <i class="bi bi-search"></i>日期迄
                    </label>
                    <input type="text" class="form-control mb-3 col-xs-6 col-lg-6" id="inputEndTime">
                </div>
            </div> *@
            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label mb-3">
                        <i class="bi bi-search"></i>日期起
                    </label>
                    <div class="row">
                        <div class="col">
                            <input type="text" class="form-control" id="inputStartTime" readonly>
                        </div>
                        <div class="col-auto">~</div>
                        <div class="col">
                            <input type="text" class="form-control" id="inputEndTime" readonly>
                        </div>
                    </div>
                </div>
            </div>
            <!-- 包覆顯示時段的區塊 -->
            <div id="hourSelection">
                <label class="form-label mb-3">
                    <i class="bi bi-search"></i>顯示時段(請務必選擇6個時段不可超過)
                </label>
                <div class="px-4">
                    @foreach (var hour in ViewBag.HourList)
                    {
                        <div class="form-check form-check-inline checkbox-group">
                            <input class="form-check-input" type="checkbox" id="checkbox-@hour" value="@hour">
                            <label class="form-check-label" for="checkbox-@hour">
                                @hour 時
                            </label>
                        </div>
                    }
                </div>
                
            </div>
            <div class="btnGroup my-4">
                <a class="btn-green-o" href="javascript:;" onclick="btnSearch()">查詢</a>
                <a class="btn-lightGrey-o" href="javascript:;" onclick="btnExport()">下載</a>
                <a class="btn-blue-o" href="javascript:;" onclick="btnCover()">資料回寫</a>
            </div>
            <hr />

            <span id="spanError">資料查詢中.....</span>
            <div class="container py-5" id="comparisonView">
            @* <h2 class="mb-4 text-center fw-bold text-secondary">每日用水量紀錄</h2> *@

                <div class="row row-cols-1 g-3" id="data-container">
                    <!-- JS 會將卡片動態渲染在這裡 -->
                </div>
                <div>
                    <span>說明:</span><br />
                    <span>1.「估算用水量」以第六個時段指針值減去第一個時段指針值</span><br />
                    <span>2.「回傳指針」抓取該時段第一筆訊號當時的指針值</span><br />
                    <span>3.資料傳輸可能因環境與電信通訊等因素，造成訊息短暫未回傳情形，惟不影響計費正確性</span><br />
                    <span>4.為避免資料載入時間過長，查詢期間限兩年內</span>
                </div>
            </div>

            <!-- 水表指針圖表：圖表顯示區 (預設隱藏) -->
            <div id="chartView" style="">
                <div class="pagechartGroup" id="mychart" style="width:100%;height:500px;margin-top:15px"></div>
            </div>
        </div>
    </div>
</div><!-- wrap end -->

<!-- 資料回寫 Modal -->
<div class="modal fade" id="ModalContactPerson" tabindex="-1" aria-labelledby="ModalContactPersonLabel" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="exampleModalLabel01">資料回寫</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="datacover">
                <div class="mb-3">
                    <label for="recipient-name" class="col-form-label">日期</label>
                    <input type="text" class="form-control mb-3" id="inputDate" readonly onchange="dateChangeEvent()">
                </div>                  
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="btnDataCoverSubmit()" id="btnCover">確認回寫</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>
<!-- JavaScript 區塊 -->
<script>
    let ddlDateS = null, ddlDateE = null;
    $(function () {
        // 初始化日期選擇元件
        SettingTxtDate();
        // 預設為「水表指針比較」(表格)模式：
        // 1. 設定日期為前天月份的1號 ~ 當日的前一天 (格式：yyyy/MM/dd)
        // 2. 預設勾選顯示時段中的 00,03,06,09,12,15
        // 3. 顯示表格及顯示時段區塊

        var now = new Date();
        // 1. 本月的第一天
        var firstDayThisMonth = new Date(now.getFullYear(), now.getMonth(), 1);

        // 2. 结束日期為今天的前一天
        var lastDay = new Date(now); // 複製當前日期
        lastDay.setDate(now.getDate() - 1); // 昨天

        // 3. 判斷结束日期的前一天是否屬於上個月
        var firstDayOfEndMonth = new Date(lastDay.getFullYear(), lastDay.getMonth(), 1); // 獲取结束日期所在月份的月初
        var firstDayToUse;

        if (firstDayOfEndMonth.getMonth() === firstDayThisMonth.getMonth()) {
            // 如果结束日期的前一天屬於當前月，開始日期为當月的月初
            firstDayToUse = firstDayThisMonth;
        } else {
            // 否則，结束日期的前一天屬於上個月，開始日期為上個月的月初
            firstDayToUse = new Date(lastDay.getFullYear(), lastDay.getMonth(), 1);
        }

        // 4. 格式化日期 "yyyy/MM/dd"
        var startDateStrTable = firstDayToUse.getFullYear() + "/" +
            (firstDayToUse.getMonth() + 1).toString().padStart(2, "0") + "/" +
            firstDayToUse.getDate().toString().padStart(2, "0");

        var endDateStrTable = lastDay.getFullYear() + "/" +
            (lastDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
            lastDay.getDate().toString().padStart(2, "0");

        // 5. 輸入框的值
        $("#inputStartTime").val(startDateStrTable);
        $("#inputEndTime").val(endDateStrTable);

        // 預設勾選 00,03,06,09,12,15 的 checkbox
        var defaultHours = ["00", "03", "06", "09", "12", "15"];
        $("#hourSelection input[type='checkbox']").each(function () {
            var val = $(this).val();
            if (defaultHours.indexOf(val) != -1) {
                $(this).prop("checked", true);
            } else {
                $(this).prop("checked", false);
            }
        });
        // 顯示表格與顯示時段區塊，隱藏圖表
        $("#tabComparison").addClass("active");
        $("#tabChart").removeClass("active");
        $("#comparisonView").show();
        $("#chartView").hide();
        $("#hourSelection").show();

        //顯示確認回寫按鈕
        $('#btnCover').removeClass('d-none');

        // 初次查詢 (走表格查詢流程)
        btnSearch();

        // 頁籤點擊事件 -------------------------------------

        // 切換到「水表指針比較」(表格)模式
        $("#tabComparison").click(function () {
            ddlDateS.destroy();
            ddlDateE.destroy();

            $(this).addClass("active");
            $("#tabChart").removeClass("active");
            $("#comparisonView").show();
            $("#chartView").hide();
            $("#hourSelection").show();

            ddlDateS = CreateRocDate('inputStartTime', false, false, false, false);
            ddlDateE = CreateRocDate('inputEndTime', false, false, false, false);

            // 更新日期：本月1號 ~ 本月月底 (格式：yyyy/MM/dd)
            var now = new Date();
            var firstDay = new Date(new Date().setDate(new Date().getDate() - 6));//new Date(now.getFullYear(), now.getMonth(), 1);
            var lastDay = new Date(new Date().setDate(new Date().getDate() - 1));//new Date(now.getFullYear(), now.getMonth() + 1, 0);
            var startDateStrTable = firstDay.getFullYear() + "/" +
                (firstDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
                firstDay.getDate().toString().padStart(2, "0");
            var endDateStrTable = lastDay.getFullYear() + "/" +
                (lastDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
                lastDay.getDate().toString().padStart(2, "0");
            $("#inputStartTime").val(startDateStrTable);
            $("#inputEndTime").val(endDateStrTable);
            // 重設勾選狀態：預設勾選 00,03,06,09,12,15
            var defaultHours = ["00", "03", "06", "09", "12", "15"];
            $("#hourSelection input[type='checkbox']").each(function () {
                var val = $(this).val();
                if (defaultHours.indexOf(val) != -1) {
                    $(this).prop("checked", true);
                } else {
                    $(this).prop("checked", false);
                }
            });
            // 呼叫查詢 (走表格查詢流程)
            btnSearch();
        });

        // 切換到「水表指針圖表」模式
        $("#tabChart").click(function () {
            ddlDateS.destroy();
            ddlDateE.destroy();

            $(this).addClass("active");
            $("#tabComparison").removeClass("active");
            $("#chartView").show();
            $("#comparisonView").hide();
            // 圖表模式不顯示「顯示時段」區塊
            $("#hourSelection").hide();

            ddlDateS = CreateRocDate('inputStartTime', true, false, false, false);
            ddlDateE = CreateRocDate('inputEndTime', true, false, false, false);

            // 更新日期：本月1號加上 " 00:00" ~ 本月月底加上 " 24:00"
            var now = new Date();
            var firstDay = new Date(new Date().setDate(new Date().getDate() - 6));//new Date(now.getFullYear(), now.getMonth(), 1);
            var lastDay = new Date(new Date().setDate(new Date().getDate() - 1));//new Date(now.getFullYear(), now.getMonth() + 1, 0);
            var startDateStrChart = firstDay.getFullYear() + "/" +
                (firstDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
                firstDay.getDate().toString().padStart(2, "0") + " 00:00";
            var endDateStrChart = lastDay.getFullYear() + "/" +
                (lastDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
                lastDay.getDate().toString().padStart(2, "0") + " 23:00";
            $("#inputStartTime").val(startDateStrChart);
            $("#inputEndTime").val(endDateStrChart);
            // 呼叫查詢 (走圖表查詢流程)
            btnSearch();
        });
    });
   
    // 初始化日期選擇元件 (原有設定，如有需要請自行調整)
    const SettingTxtDate = () => {
        ddlDateS = CreateRocDate('inputStartTime', false, false, false, false);
        ddlDateE = CreateRocDate('inputEndTime', false, false, false, false);
        CreateRocDate('inputDate', false, false, false, false);
    };

    var myChart = echarts.init(document.getElementById('mychart'));
    window.onresize = function () {
        myChart.resize();
    };

     var ExcelData = {};
     var selectedHours = [];
    // 查詢按鈕點擊 (根據顯示模式走不同流程)
    function btnSearch() {
        $("#spanError").text('資料查詢中.....');
        // 組合查詢網址
        let url = "";
        if ($("#tabChart").hasClass("active")) {
            // 圖表模式下的查詢網址
            url = GetWebSiteURL('@Url.Action("WaterNoteTableChart4", "Dashboard")');
        } else {
            // //清除table
            // $("#data-table thead").empty();
            // $("#data-table tbody").empty();
            // 清空現有內容
            $("#data-container").empty();
            // 表格模式下的查詢網址
            url = GetWebSiteURL('@Url.Action("WaterNoteTableChart3", "Dashboard")');
        }

        selectedHours = [];
        // 收集所有被勾選的時段值 (僅對表格模式有作用)
        $(".checkbox-group input:checked").each(function () {
            selectedHours.push($(this).val());
        });

        let model = {
            StartDate: $("#inputStartTime").val(),
            EndDate: $("#inputEndTime").val(),
            HoursList: selectedHours
        };

            $.ajax({
                type: "POST",
                url: url,
                data: model,
                success: function (result) {
                    $("#spanError").text('');
                    if (result.Success) {
                        //console.log(result);
                        if (result.Data.length === 0) {
                            $("#spanError").text('此時間段尚無資料');
                            if (typeof myChart !== 'undefined') {
                                myChart.clear();
                            }
                        } else {
                            //console.log(result.Data);
                            ExcelData = result.Data;

                            if ($("#tabChart").hasClass("active")) {
                                updateChart(result.Data);  // 圖表模式
                            } else {
                                updateCards(result.Data);  // 表格模式
                            }
                        }
                    } else {
                        if (result.Message !== '') {
                            alert(result.Message);
                            $("#spanError").text('');
                        } else if (typeof myChart !== 'undefined') {
                            $("#spanError").text('此時間段尚無資料');
                            myChart.clear();
                        }
                    }
                },
                error: function (xhr, status, error) {
                    // 錯誤處理：例如後端未回應、500錯誤、非JSON格式
                    console.error("Ajax 錯誤：", status, error);
                    $("#spanError").text('伺服器錯誤或無法連線，請稍後再試');
                    if (typeof myChart !== 'undefined') {
                        myChart.clear();
                    }
                }
            });
    }

    // 根據返回的資料更新表格 (原有函式)
    function updateTable(data) {
        let tableBody = $("#data-table tbody");
        let tableHeader = $("#data-table thead");

        tableBody.empty();  // 清空現有表格內容
        tableHeader.empty(); // 清空現有表格標題

        if (data.length > 0 && data[0]._data && data[0]._data.length > 0) {
            // 動態生成標題行
            let headerRow = $("<tr>");
            headerRow.append("<th rowspan='2'>日期</th>");
            headerRow.append("<th colspan='2'>00:00～24:00 用水量</th>");

            // 根據 _data 的時間動態生成回傳指針數的標題
            let timeHeaders = "<th colspan='" + data[0]._data.length + "'>回傳指針數</th>";
            headerRow.append(timeHeaders);
            tableHeader.append(headerRow);

            // 第二行標題
            let subHeaderRow = $("<tr>");
            subHeaderRow.append("<th>估算量 (度)</th>");
            subHeaderRow.append("<th>較前一日增減</th>");

            // 動態生成時間標題
            data[0]._data.forEach(function (timeData) {
                let timeHeader = $("<th>").text(timeData._time + '時');
                subHeaderRow.append(timeHeader);
            });
            tableHeader.append(subHeaderRow);
        }

        // 遍歷每一筆資料並插入表格
        data.forEach(function (item) {
            let row = $("<tr>");
            let dateCell = $("<td>").text(formatDate(item._date));
            row.append(dateCell);

            let estimateCell = $("<td>").text(item._estimate);  //item._estimate.toFixed(0)
            let differenceText = '';
            let differenceColor = 'black';

            if (isNaN(item._difference)) {
                differenceText = item._difference;
            } else {
                const differenceValue = Number(item._difference);
                if (differenceValue > 0) {
                    differenceText = differenceValue + " %↑"; //differenceValue.toFixed(0) + " %↑";
                    differenceColor = 'red';
                } else if (differenceValue < 0) {
                    differenceText =  differenceValue + " %↓";//differenceValue.toFixed(0) + " %↓";
                    differenceColor = 'green';
                 } else if (differenceValue == 0) {
                    differenceText =  differenceValue + " % ";//differenceValue.toFixed(0) + " % ";
                } else {
                    differenceText = differenceValue;//differenceValue.toFixed(0);
                }
            }
            let differenceCell = $("<td>").text(differenceText).css('color', differenceColor);
            row.append(estimateCell).append(differenceCell);

            // 填充回傳指針數的時段數據
            item._data.forEach(function (timeData) {
                let amountCell = $("<td>").text(timeData._amount);//.text(timeData._amount.toFixed(0));
                row.append(amountCell);
            });

            tableBody.append(row);
        });
    }

    // 根據返回的資料更新卡片版面
    function updateCards(data) {
        let container = $("#data-container");
        container.empty(); // 清空現有內容

        // 遍歷每一筆資料
        data.forEach(function (item) {
            // 1. 處理日期
            let formattedDate = formatDate(item._date);

            // 2. 處理估算量
            let estimateText = item._estimate; // 若需取整數可加 .toFixed(0)

            // 3. 處理增減與顏色 (轉換為 Bootstrap 的 text-class)
            let differenceText = '';
            let differenceClass = 'text-dark'; // 預設黑色

            if (isNaN(item._difference)) {
                differenceText = item._difference;
            } else {
                const differenceValue = Number(item._difference);
                if (differenceValue > 0) {
                    differenceText = differenceValue + " %↑";
                    differenceClass = 'text-danger'; // Bootstrap 的紅色
                } else if (differenceValue < 0) {
                    differenceText = differenceValue + " %↓";
                    differenceClass = 'text-success'; // Bootstrap 的綠色
                } else if (differenceValue === 0) {
                    differenceText = differenceValue + " % ";
                } else {
                    differenceText = differenceValue;
                }
            }

            // 4. 動態生成「回傳指針數」的時段區塊 HTML
            let timeBlocksHtml = '';
            if (item._data && item._data.length > 0) {
                item._data.forEach(function (timeData) {
                    timeBlocksHtml += `
                        <div class="col col-sm bg-light rounded text-center">
                            <span class="d-block text-secondary lh-1 pt-2">${timeData._time}時</span>
                            <strong class="lh-1">${timeData._amount}</strong>
                        </div>
                    `;
                });
            }

            // 5. 組合單張卡片的完整 HTML
            let cardHtml = `
                <div class="col">
                    <div class="card shadow-sm">
                        <div class="card-body p-2 p-lg-4">
                            <div class="row align-items-center g-3">

                                <!-- 1. 日期群組 -->
                                <div class="col-12 col-lg-2 position-relative">
                                    <div class="bg-primary text-white rounded-3 py-2 px-3 fw-bold text-center w-100">
                                        <i class="bi bi-calendar-event d-none d-sm-inline-block me-1"></i>${formattedDate}
                                    </div>
                                    <!-- 電腦版垂直分隔線 -->
                                    <div class="d-none d-lg-block position-absolute top-50 translate-middle-y end-0" style="width: 1px; height: 70%; background-color: #dee2e6;"></div>
                                </div>

                                <!-- 2. 00:00~24:00 用水量群組 -->
                                <div class="col-12 col-lg-3 position-relative">
                                    <div class="text-secondary text-center fw-semibold mb-2 pb-1 border-bottom">00:00~24:00用水量</div>
                                    <div class="row gap-2 text-center">
                                        <div class="col border-end">
                                            <span class="d-block text-muted lh-1 mb-1">估算量</span>
                                            <strong class="text-dark">${estimateText}</strong>
                                        </div>
                                        <div class="col">
                                            <span class="d-block text-muted lh-1 mb-1">增減</span>
                                            <strong class="${differenceClass}">${differenceText}</strong>
                                        </div>
                                    </div>
                                    <!-- 電腦版垂直分隔線 -->
                                    <div class="d-none d-lg-block position-absolute top-50 translate-middle-y end-0" style="width: 1px; height: 70%; background-color: #dee2e6;"></div>
                                </div>

                                <!-- 3. 指針數群組 -->
                                <div class="col-12 col-lg-7">
                                    <div class="text-secondary text-center fw-semibold mb-2 pb-1 border-bottom">回傳指針數</div>
                                    <div class="row px-3 gap-1">
                                        ${timeBlocksHtml}
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            `;
            // 將組好的卡片加入容器中
            container.append(cardHtml);
        });
    }

    // 格式化日期 (轉換為 yyyy/MM/dd 格式)
    function formatDate(dateString) {
        let date = new Date(dateString);
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0');
        let day = date.getDate().toString().padStart(2, '0');
        return `${year}/${month}/${day}`;
    }
    var JsonDatas = [];//圖表資料
    // 疊加1
    let QueryDataItem = {
        SeriesName: '查詢日期',//$('#form-name').val(),
        DataID: '1',
        StartDate: $("#inputStartTime").val(),
        EndDate: $("#inputEndTime").val(),
    };
    // 更新圖表函式 (範例：請依照實際需求調整圖表設定)
    function updateChart(data) {

        JsonDatas = [];
        QueryDataItem.Datas = data;
