            $.ajax({
                url: GetWebSiteURL('@Url.Action("ExporttoExcelChart", "Quality")'),
                method: 'POST',
                data: { ResultData: JSON.stringify(ExcelData) }, //參數傳遞方式
                dataType: 'json',
                async: false,//是否非同步
                //API錯誤時
                error: function (error) {
                    alert('水表指針圖表-匯出錯誤1:' + error.responseText);
                },//error END
                success: response => {
                    /*var response = JSON.parse(res);*/
                    if(response.Result=="NG")
