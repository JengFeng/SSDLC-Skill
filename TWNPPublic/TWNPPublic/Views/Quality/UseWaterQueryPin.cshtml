<script>
    const SettingTxtDate = () => {
        ddlDateS = CreateRocDate('inputStartTime', false, false, false,true);
    }

    function btnSearch() {
        $("#spanError").text('');
        let url = "@Context.Items["urlPrefix"]@Url.Action("WaterNoteTableChart3", "Dashboard")";
        let model = {
            Cdate: $("#inputStartTime").val()
        };


        $.post("@Context.Items["urlPrefix"]@Url.Action("WaterNoteTableChart3", "Dashboard")", model, function (result) {
            $("#spanError").text('');
            if (result.Success) {

                if (result.Data.Length == 0) {
                    $("#spanError").text('此時間段尚無資料');
                    myChart.clear();
                }

                let parserY = result.Data.Y.map(item => Math.floor(item));
                const colors = ['#5391C7'];
                var option;
                option = {
                    color: colors,
                    tooltip: {
                        trigger: 'axis',
                        axisPointer: {
                            type: 'cross'
                        }
                    },
                    grid: {
                        bottom: 80
                    },
                    toolbox: {
                        show: true,
                        feature: {
                            saveAsImage: { title: "另存圖片" }
                        }
                    },
                    legend: {
                        y: 'top',
                        x: 'middle',
                        data: ["用水量趨勢", "用水指針"]
                    },
                    xAxis: {
                        nameGap: 25,
                        nameLocation: 'center',
                        name: '時間(小時)',
                        type: 'category',
                        data: result.Data.X
                    },
                    yAxis: [{
                        nameLocation: 'center',
                        nameGap: 25,
                        nameRotate: 360,
                        name: '用 \n 水 \n 量 \n ︵ \n 度 \n ︶ \n',
                        type: 'value',
                        axisLine: {
                            show: true,
                            lineStyle: {
                                color: '#5391C7'
                            }
                        },
                        axisLabel: { formatter: '{value}' }
                    },
                    {
                        nameLocation: 'center',
                        nameGap: 45,
                        nameRotate: 360,
                        name: '用 \n水 \n指 \n針 \n',
                        type: 'value',
                        position: 'right',
                        alignTicks: true,
                        axisLine: {
                            show: true,
                            lineStyle: {
                                color: '#ffb1c1'
                            },
                            splitLine: {
                                show: false
                            },
                        },
                        axisLabel: {
                            formatter: '{value}'
                        },
                        nameTextStyle: {
                            fontSize: 18
                        }
                    }],
                    series: [
                        {
                            name: '用水量趨勢',
                            type: 'bar',
                            data: parserY
                        },
                        {
                            name: '用水指針',
                            type: 'line',
                            yAxisIndex: 1,
                            itemStyle: { color: '#ffb1c1', lineStyle: { color: '#ffb1c1' } },
                            data: result.Data.O
                        }
                    ]
                };
                option && myChart.setOption(option);
            }
            else {
                $("#spanError").text('此時間段尚無資料');
                myChart.clear();
            }
        });
    }

</script>


