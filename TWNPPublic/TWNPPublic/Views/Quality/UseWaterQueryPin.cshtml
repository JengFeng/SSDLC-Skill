                success: response => {
                    /*var response = JSON.parse(res);*/
                    if(response.Result=="NG")
                    {
                        alert('水表指針比較-匯出錯誤2');
                        return;
                    }
                    //另開一個視窗，由另一個Action去產出檔案
                    var url =GetWebSiteURL('@Url.Action("Download", "Quality")')+"?FileGuid="+response.FileGuid+"&FileName="+response.FileName;

                    document.location=url;

