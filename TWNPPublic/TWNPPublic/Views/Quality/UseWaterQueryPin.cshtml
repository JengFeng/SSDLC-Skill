                    //  $.when(
                    //         windowExport
                    // ).then(function (data, textStatus, jqXHR) {
                    //     setTimeout(AAA,5000);
                    // });

                }//success END

            });//ajax END

        }
        else{

           const data = await excelAllTimeData();
           if (!data || data.length < 1) return;
           ExcelData = data;
           //查詢結果Json傳回後端
            $.ajax({
                url: GetWebSiteURL('@Url.Action("ExporttoExcelTable", "Quality")'),
