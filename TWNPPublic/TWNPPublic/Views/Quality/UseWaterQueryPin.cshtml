@{
    ViewData["Title"] = "用水指針查詢";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section echart {
    <script type="text/javascript" src="~/js/echarts/echarts.js"></script>
    <script type="text/javascript" src="~/js/Common.js"></script>
}

<!-- CSS 區塊 -->
<style>
    table {
        width: 100%;
        border-collapse: collapse; /* 確保邊框合併 */
    }

    th, td {
        border: 1px solid black; /* 設定邊框顏色 */
        padding: 8px;
        text-align: center;
    }

    th {
        background-color: #f2f2f2; /* 表頭背景色 */
    }
    /* 頁籤樣式 */
    .tab {
        cursor: pointer;
        padding: 8px 16px;
        margin-right: 10px;
    }

        .tab.active {
            font-weight: bold;
            border-bottom: 2px solid blue;
        }
</style>

<!-- HTML 主區塊 -->
<div class="pageWrap">
    <partial name="_MenuPartial" />
    <div class="pageArea">
        <partial name="_NewsBoxPartial" />
        <div class="mainGroup">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index","Dashboard")">
                            <i class="bi bi-house-door-fill"></i>首頁
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">用水指針查詢</li>
                </ol>
            </nav>

            <!-- 頁籤切換區：水表指針比較(表格) 與 水表指針圖表 -->
            <div class="tabContainer" style="margin-bottom:15px;">
                <span id="tabComparison" class="tab active">水表指針比較</span>
                <span id="tabChart" class="tab">水表指針圖表</span>
            </div>

            <!-- 搜尋區 -->
            @* <div class="search-inline row">
                <div class="mb-3 col-xs-12 col-lg-12">
                    <label class="form-label">
                        <i class="bi bi-search"></i>日期起
                    </label>
                    <input type="text" class="form-control mb-3 col-xs-6 col-lg-6" id="inputStartTime">
                </div>
                <div class="mb-3 col-xs-12 col-lg-12">
                    <label class="form-label">
                        <i class="bi bi-search"></i>日期迄
                    </label>
                    <input type="text" class="form-control mb-3 col-xs-6 col-lg-6" id="inputEndTime">
                </div>
            </div> *@
            <div class="search-inline row">
                <div class="mb-3 col-12">
                    <label class="form-label">
                        <i class="bi bi-search"></i>日期起
                    </label>
                    <div class="d-flex align-items-center justify-content-between">
                        <input type="text" class="form-control mb-3" id="inputStartTime">
                        <span class="mx-2">~</span>
                        <input type="text" class="form-control mb-3" id="inputEndTime">
                    </div>
                </div>
            </div>
            <!-- 包覆顯示時段的區塊 -->
            <div id="hourSelection" class="search-inline row">
                <div class="mb-3 col-xs-12 col-lg-12">
                    <label class="form-label">
                        <i class="bi bi-search"></i>顯示時段(請務必選擇6個時段不可超過)
                    </label>
                    <div class="d-flex flex-wrap">
                        @foreach (var hour in ViewBag.HourList)
                        {
                            <div class="form-check me-3 checkbox-group">
                                <input class="form-check-input" type="checkbox" id="checkbox-@hour" value="@hour">
                                <label class="form-check-label" for="checkbox-@hour">
                                    @hour 時
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="btnGroup" style="border-bottom: 1px solid #EBF7F5;padding-bottom:25px">
                <a class="btn-green-o" href="javascript:;" onclick="btnSearch()">查詢</a>
                <a class="btn-lightGrey-o" href="javascript:;" onclick="btnExport()">下載</a>
            </div>
            <span id="spanError">資料查詢中.....</span>
            <!-- 水表指針比較：表格顯示區 -->
            <div id="comparisonView">
                <table id="data-table" border="1">
                    <thead>
                        @* <tr>
                            <th rowspan="2">日期</th>
                            <th colspan="2">00:00～24:00 用水量</th>
                            <th colspan="6">回傳指針數</th>
                        </tr>
                        <tr>
                            <th>估算量 (度)</th>
                            <th>較前一日增減</th>
                            <th>00時</th>
                            <th>03時</th>
                            <th>06時</th>
                            <th>09時</th>
                            <th>12時</th>
                            <th>15時</th>
                        </tr> *@
                    </thead>
                    <tbody>
                        @* <tr>
                            <td>113/01/01</td>
                            <td>5</td>
                            <td>-17% ↓</td>
                            <td>397</td>
                            <td>397</td>
                            <td>398</td>
                            <td>400</td>
                            <td>402</td>
                            <td>402</td>
                        </tr>
                        <tr>
                            <td>113/01/02</td>
                            <td>3</td>
                            <td>-40% ↓</td>
                            <td>402</td>
                            <td>402</td>
                            <td>404</td>
                            <td>405</td>
                            <td>405</td>
                            <td>407</td>
                        </tr>
                        <tr>
                            <td>113/01/03</td>
                            <td>2</td>
                            <td>-33% ↓</td>
                            <td>405</td>
                            <td>405</td>
                            <td>407</td>
                            <td>409</td>
                            <td>411</td>
                            <td>414</td>
                        </tr> *@
                    </tbody>
                </table>
                <div>
                    <span>說明:</span><br />
                    <span>1.「估算用水量」以第六個時段指針值減去第一個時段指針值</span><br />
                    <span>2.「回傳指針」抓取該時段第一筆訊號當時的指針值</span><br />
                    <span>3.資料傳輸可能因環境與電信通訊等因素，造成訊息短暫未回傳情形，惟不影響計費正確性</span><br />
                    <span>4.為避免資料載入時間過程，查詢期間限兩年內</span>
                </div>
            </div>

            <!-- 水表指針圖表：圖表顯示區 (預設隱藏) -->
            <div id="chartView" style="">
                <div class="pagechartGroup" id="mychart" style="width:100%;height:500px;margin-top:15px"></div>
            </div>
        </div>
    </div>
</div><!-- wrap end -->
<!-- JavaScript 區塊 -->
<script>
    let ddlDateS = null, ddlDateE = null;
    $(function () {
        // 初始化日期選擇元件
        SettingTxtDate();
        // 預設為「水表指針比較」(表格)模式：
        // 1. 設定日期為本月1號 ~ 本月月底 (格式：yyyy/MM/dd)
        // 2. 預設勾選顯示時段中的 00,03,06,09,12,15
        // 3. 顯示表格及顯示時段區塊
        var now = new Date();
        var firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
        var lastDay = new Date(new Date().setDate(new Date().getDate() - 1)); // 先取得今天的日期//new Date(now.getFullYear(), now.getMonth() + 1, 0);
        var startDateStrTable = firstDay.getFullYear() + "/" +
            (firstDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
            firstDay.getDate().toString().padStart(2, "0");
        var endDateStrTable = lastDay.getFullYear() + "/" +
            (lastDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
            lastDay.getDate().toString().padStart(2, "0");
        $("#inputStartTime").val(startDateStrTable);
        $("#inputEndTime").val(endDateStrTable);
        // 預設勾選 00,03,06,09,12,15 的 checkbox
        var defaultHours = ["00", "03", "06", "09", "12", "15"];
        $("#hourSelection input[type='checkbox']").each(function () {
            var val = $(this).val();
            if (defaultHours.indexOf(val) != -1) {
                $(this).prop("checked", true);
            } else {
                $(this).prop("checked", false);
            }
        });
        // 顯示表格與顯示時段區塊，隱藏圖表
        $("#tabComparison").addClass("active");
        $("#tabChart").removeClass("active");
        $("#comparisonView").show();
        $("#chartView").hide();
        $("#hourSelection").show();

        // 初次查詢 (走表格查詢流程)
        btnSearch();

        // 頁籤點擊事件 -------------------------------------

        // 切換到「水表指針比較」(表格)模式
        $("#tabComparison").click(function () {
            ddlDateS.destroy();
            ddlDateE.destroy();

            $(this).addClass("active");
            $("#tabChart").removeClass("active");
            $("#comparisonView").show();
            $("#chartView").hide();
            $("#hourSelection").show();

            ddlDateS = CreateRocDate('inputStartTime', false, false, false, false);
            ddlDateE = CreateRocDate('inputEndTime', false, false, false, false);

            // 更新日期：本月1號 ~ 本月月底 (格式：yyyy/MM/dd)
            var now = new Date();
            var firstDay = new Date(new Date().setDate(new Date().getDate() - 6));//new Date(now.getFullYear(), now.getMonth(), 1);
            var lastDay = new Date(new Date().setDate(new Date().getDate() - 1));//new Date(now.getFullYear(), now.getMonth() + 1, 0);
            var startDateStrTable = firstDay.getFullYear() + "/" +
                (firstDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
                firstDay.getDate().toString().padStart(2, "0");
            var endDateStrTable = lastDay.getFullYear() + "/" +
                (lastDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
                lastDay.getDate().toString().padStart(2, "0");
            $("#inputStartTime").val(startDateStrTable);
            $("#inputEndTime").val(endDateStrTable);
            // 重設勾選狀態：預設勾選 00,03,06,09,12,15
            var defaultHours = ["00", "03", "06", "09", "12", "15"];
            $("#hourSelection input[type='checkbox']").each(function () {
                var val = $(this).val();
                if (defaultHours.indexOf(val) != -1) {
                    $(this).prop("checked", true);
                } else {
                    $(this).prop("checked", false);
                }
            });
            // 呼叫查詢 (走表格查詢流程)
            btnSearch();
        });

        // 切換到「水表指針圖表」模式
        $("#tabChart").click(function () {
            ddlDateS.destroy();
            ddlDateE.destroy();

            $(this).addClass("active");
            $("#tabComparison").removeClass("active");
            $("#chartView").show();
            $("#comparisonView").hide();
            // 圖表模式不顯示「顯示時段」區塊
            $("#hourSelection").hide();

            ddlDateS = CreateRocDate('inputStartTime', true, false, false, false);
            ddlDateE = CreateRocDate('inputEndTime', true, false, false, false);

            // 更新日期：本月1號加上 " 00:00" ~ 本月月底加上 " 24:00"
            var now = new Date();
            var firstDay = new Date(new Date().setDate(new Date().getDate() - 6));//new Date(now.getFullYear(), now.getMonth(), 1);
            var lastDay = new Date(new Date().setDate(new Date().getDate() - 1));//new Date(now.getFullYear(), now.getMonth() + 1, 0);
            var startDateStrChart = firstDay.getFullYear() + "/" +
                (firstDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
                firstDay.getDate().toString().padStart(2, "0") + " 00:00";
            var endDateStrChart = lastDay.getFullYear() + "/" +
                (lastDay.getMonth() + 1).toString().padStart(2, "0") + "/" +
                lastDay.getDate().toString().padStart(2, "0") + " 23:00";
            $("#inputStartTime").val(startDateStrChart);
            $("#inputEndTime").val(endDateStrChart);
            // 呼叫查詢 (走圖表查詢流程)
            btnSearch();
        });
    });
   
    // 初始化日期選擇元件 (原有設定，如有需要請自行調整)
    const SettingTxtDate = () => {
        ddlDateS = CreateRocDate('inputStartTime', false, false, false, false);
        ddlDateE = CreateRocDate('inputEndTime', false, false, false, false);
    };

    var myChart = echarts.init(document.getElementById('mychart'));
    window.onresize = function () {
        myChart.resize();
    };

     var ExcelData = {};
     var selectedHours = [];
    // 查詢按鈕點擊 (根據顯示模式走不同流程)
    function btnSearch() {
        $("#spanError").text('資料查詢中.....');
        // 組合查詢網址
        let url = "";
        if ($("#tabChart").hasClass("active")) {
            // 圖表模式下的查詢網址
            url = "@Context.Items["urlPrefix"]@Url.Action("WaterNoteTableChart4", "Dashboard")";
        } else {
            //清除table
            $("#data-table thead").empty();
            $("#data-table tbody").empty();
            // 表格模式下的查詢網址
            url = "@Context.Items["urlPrefix"]@Url.Action("WaterNoteTableChart3", "Dashboard")";
        }

        selectedHours = [];
        // 收集所有被勾選的時段值 (僅對表格模式有作用)
        $(".checkbox-group input:checked").each(function () {
            selectedHours.push($(this).val());
        });

        let model = {
            StartDate: $("#inputStartTime").val(),
            EndDate: $("#inputEndTime").val(),
            HoursList: selectedHours
        };

        $.post(url, model, function (result) {
            $("#spanError").text('');
            if (result.Success) {
                console.log(result);
                if (result.Data.length == 0) {
                    $("#spanError").text('此時間段尚無資料');
                    if (typeof myChart !== 'undefined') {
                        myChart.clear();
                    }
                } else {
                    console.log(result.Data);
                    ExcelData = result.Data;
                    // 根據目前顯示的頁籤更新內容
                    if ($("#tabChart").hasClass("active")) {
                        // 圖表模式下：
                        // TODO: 實作第二種水表指針圖表查詢方式（若有需要）
                        updateChart(result.Data);
                    } else {
                        // 表格模式下更新表格
                        updateTable(result.Data);
                    }
                }
            } else {
                if (result.Message != ''){
                    alert(result.Message);
                    $("#spanError").text('');
                }
                else if (typeof myChart !== 'undefined') {
                    $("#spanError").text('此時間段尚無資料');
                    myChart.clear();
                }
            }
        });
    }

    // 根據返回的資料更新表格 (原有函式)
    function updateTable(data) {
        let tableBody = $("#data-table tbody");
        let tableHeader = $("#data-table thead");

        tableBody.empty();  // 清空現有表格內容
        tableHeader.empty(); // 清空現有表格標題

        if (data.length > 0 && data[0]._data && data[0]._data.length > 0) {
            // 動態生成標題行
            let headerRow = $("<tr>");
            headerRow.append("<th rowspan='2'>日期</th>");
            headerRow.append("<th colspan='2'>00:00～24:00 用水量</th>");

            // 根據 _data 的時間動態生成回傳指針數的標題
            let timeHeaders = "<th colspan='" + data[0]._data.length + "'>回傳指針數</th>";
            headerRow.append(timeHeaders);
            tableHeader.append(headerRow);

            // 第二行標題
            let subHeaderRow = $("<tr>");
            subHeaderRow.append("<th>估算量 (度)</th>");
            subHeaderRow.append("<th>較前一日增減</th>");

            // 動態生成時間標題
            data[0]._data.forEach(function (timeData) {
                let timeHeader = $("<th>").text(timeData._time + '時');
                subHeaderRow.append(timeHeader);
            });
            tableHeader.append(subHeaderRow);
        }

        // 遍歷每一筆資料並插入表格
        data.forEach(function (item) {
            let row = $("<tr>");
            let dateCell = $("<td>").text(formatDate(item._date));
            row.append(dateCell);

            let estimateCell = $("<td>").text(item._estimate);  //item._estimate.toFixed(0)
            let differenceText = '';
            let differenceColor = 'black';

            if (isNaN(item._difference)) {
                differenceText = item._difference;
            } else {
                const differenceValue = Number(item._difference);
                if (differenceValue > 0) {
                    differenceText = differenceValue + " %↑"; //differenceValue.toFixed(0) + " %↑";
                    differenceColor = 'red';
                } else if (differenceValue < 0) {
                    differenceText =  differenceValue + " %↓";//differenceValue.toFixed(0) + " %↓";
                    differenceColor = 'green';
                } else {
                    differenceText = differenceValue;//differenceValue.toFixed(0);
                }
            }
            let differenceCell = $("<td>").text(differenceText).css('color', differenceColor);
            row.append(estimateCell).append(differenceCell);

            // 填充回傳指針數的時段數據
            item._data.forEach(function (timeData) {
                let amountCell = $("<td>").text(timeData._amount);//.text(timeData._amount.toFixed(0));
                row.append(amountCell);
            });

            tableBody.append(row);
        });
    }

    // 格式化日期 (轉換為 yyyy/MM/dd 格式)
    function formatDate(dateString) {
        let date = new Date(dateString);
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0');
        let day = date.getDate().toString().padStart(2, '0');
        return `${year}/${month}/${day}`;
    }
    var JsonDatas = [];//圖表資料
    // 疊加1
    let QueryDataItem = {
        SeriesName: '查詢日期',//$('#form-name').val(),
        DataID: '1',
        StartDate: $("#inputStartTime").val(),
        EndDate: $("#inputEndTime").val(),
    };
    // 更新圖表函式 (範例：請依照實際需求調整圖表設定)
    function updateChart(data) {

        JsonDatas = [];
        QueryDataItem.Datas = data;
        JsonDatas.push(QueryDataItem);

        if (!JsonDatas || JsonDatas == null || JsonDatas.length < 1 || JsonDatas[0].Datas == null || JsonDatas[0].Datas.result == null || JsonDatas[0].Datas.result.length < 1)
            return;

        var divID = 'mychart';//div的ID
        var colors = ['#5470C6', '#91CC75', '#EE6666'];//Y軸色彩
        var Datasets = [];//所有資料及篩選功能
        var yAxis_Array = [];//多個Y軸(這邊沒使用)
        var Series = [];//所有序列

        $('#' + divID).show();//顯示Chart圖區塊

        var Source_Data = [["Date", "X", "Y", "DataID"]];//資料欄位設定

        //每一組資料
        for (var i = 0; i < JsonDatas.length; i++) {

            var Item = JsonDatas[i];
            var Datas = JsonDatas[i].Datas;//API取得的資料
            //沒資料時跳過
            if (Datas == undefined || Datas.result == null || Datas.result == undefined || Datas.result.length < 1)
                continue;

            //轉換資料
            Datas.result.forEach(function (d) {
                if (d.Y == null)
                    return;//continue的效果
                let X = d.X.slice(0, 16);
                let Y = d.Y;//d.Y.toFixed(5);
                let DataID = Item.DataID;
                let strDate2 = new Date(d.X);
                Source_Data.push([strDate2, X, Y, DataID]);
            });

            //塞入資料篩選條件
            Datasets.push(
                {
                    id: Item.DataID,               //對應series中的datasetId
                    fromDatasetId: "Datasets_",    //對應[Datasets陣列]中的id
                    transform: {  //篩選資料
                        type: "filter",
                        config: { dimension: "DataID", value: Item.DataID }//要篩選Source_Data裡的哪個欄位以及哪個值

                    }
                }
            );

            //序列
            Series.push(
                {
                    type: "line",
                    name: Item.SeriesName, //序列顯示名稱
                    datasetId: Item.DataID, //對應[Datasets陣列]中的id
                    yAxisIndex: 0,//第幾個Y軸
                    showSymbol: false,
                    encode: {
                        x: "X",
                        y: "Y",
                        itemName: "Date",
                        tooltip: ["Y"]
                    }
                }
            );

            //設定Y軸樣式
            if (i == 0) {
                //設定Y軸樣式
                yAxis_Array.push({
                    type: 'value',
                    // name: Datas.yAxisLabel.replace('cmd', 'CMD'),//Item.NODETYPE.replace('計', '') + '(' + Datas.yAxisLabel.replace('cmd', 'CMD') + ')',
                    position: 'top',
                    alignTicks: true,
                    offset: 0,//Y軸水平位移
                    //nameLocation: 'center',
                    name: '水表指針',
                    axisLine: {//Y軸垂直線
                        show: true,
                        lineStyle: {
                            color: colors[i]
                        }
                    },
                    axisLabel: {
                        formatter: '{value} '
                    }
                }
                )//yAxis_Array.push END
            }

        }

        //塞入所有資料集
        Datasets.splice(0, 0, {
            id: "Datasets_",
            source: Source_Data
        });

        window.onresize = function () {
            myChart.resize();
        };

        myChart.clear();

        //圖表設定
        var option = {
            grid: [
                {
                    show: true,
                    bottom: 80,
                    containLabel: true
                }// { left: '7%',right: '7%', top: '7%',bottom: '7%', width: '38%', height: '38%' },
            ],//Chart圖主體padding
            dataset: Datasets,//
            title: {
                show: false,
                padding: 10, //标题内边距，单位px，默认各方向内边距为5，接受数组分别设定上右下左边距
                text: "1223",// 設定圖表的標題
                left: 'center'

            },     // 標題
            //tooltip: {
            //    trigger: 'axis'
            //},//
            xAxis: {
                name: '時間(小時)',// 坐标轴名称
                nameLocation: 'end', // 坐标轴名称显示位置。'start'、'middle'、'end'
                type: 'category'  //'value' 数值轴，适用于连续数据。'category' 类目轴，适用于离散的类目数据。time' 时间轴，适用于连续的时序数据，与数值轴相比时间轴带有时间的格式化，在刻度计算上也有所不同，例如会根据跨度的范围来决定使用月，星期，日还是小时范围的刻度。'log' 对数轴。适用于对数数据。
            },// X 軸
            yAxis: yAxis_Array,// Y 軸
            toolbox: {
                show: true,           // 是否顯示工具欄套件
                orient: 'horizontal', // 圖例方向 horizontal, vertical
                feature: {
                    //saveAsImage: {},  // 僅啟動，使用預設
                    saveAsImage: {
                        show: true,                 // 是否顯示
                        type: 'png',                // 圖片格式(png, jpeg)
                        title: '另存為圖片',         // 工具名稱
