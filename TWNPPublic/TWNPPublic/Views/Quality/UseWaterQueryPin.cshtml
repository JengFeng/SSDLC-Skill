            return;
        if ($("#tabChart").hasClass("active")){

            //查詢結果Json傳回後端
            $.ajax({
                url: '@Url.Action("ExporttoExcelChart", "Quality")',
                method: 'POST',
                data: { ResultData: JSON.stringify(ExcelData) }, //參數傳遞方式
                dataType: 'json',
                async: false,//是否非同步
