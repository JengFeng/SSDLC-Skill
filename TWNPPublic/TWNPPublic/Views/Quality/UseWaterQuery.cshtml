@{
    ViewData["Title"] = "用水指針查詢";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section echart{
    <script type="text/javascript" src="~/js/echarts/echarts.js"></script>
}
    <script>
        $(function () {
            $("#inputStartTime").val("@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")");
            $("#inputEndTime").val("@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")");
            $(".menuList > a:nth-child(2)").addClass("active").siblings().removeClass("active");
            btnSearch();
        });
    </script>
    <div class="pageWrap">
        <partial name="_MenuPartial" />
        <div class="pageArea">
            <partial name="_NewsBoxPartial" />
            <div class="mainGroup">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard")"><i class="bi bi-house-door-fill"></i>首頁</a></li>
                        <li class="breadcrumb-item active" aria-current="page">用水指針查詢</li>
                    </ol>
                </nav>
                <div class="search-inline row">
                    <div class="mb-3 col-xs-12 col-lg-12">
                        <label class="form-label"><i class="bi bi-search"></i> 日期起</label>
                        <input type="date" id="inputStartTime" class="form-control mb-3 col-xs-6 col-lg-6">
                        @*<input type="time" id="StartTimeZone" class="form-control mb-3 col-xs-6 col-lg-6" />*@
                    </div>
                    @*                <div class="mb-3 col-xs-12 col-lg-6">
                <label class="form-label">日期訖</label>
                <input type="date" id="inputEndTime" class="form-control mb-3 col-xs-6 col-lg-6">
                <input type="time" id="EndTimeZone" class="form-control mb-3 col-xs-6 col-lg-6" />
                </div>*@
                </div>
                <div class="btnGroup" style="border-bottom: 1px solid #EBF7F5;padding-bottom:25px">
                    <a class="btn-green-o" href="javascript:;" onclick="btnSearch()">查詢</a>
                    <a class="btn-lightGrey-o" href="javascript:;" onclick="btnReset()">重製</a>
                </div>
                <span id="spanError">此時間段尚無資料</span>
                <div class="pagechartGroup" id="mychart" style="width:100%;height:500px;margin-top:15px">
                </div>
            </div>
        </div>
    </div><!-- wrap end -->

    <script>


        var myChart = echarts.init(document.getElementById('mychart'));
        window.onresize = function () {
            myChart.resize();
        };

        function btnReset() {
            history.go(0);
        }

        function btnSearch() {
            $("#spanError").text('');
            let url = "@Url.Action("WaterNoteTableChart","Dashboard")";
            let model = {
                Cdate: $("#inputStartTime").val()
            };


            $.post("@Url.Action("WaterNoteTableChart","Dashboard")", model, function (result) {
                $("#spanError").text('');
                if (result.Success) {

                    if (result.Data.Length == 0) {
                        $("#spanError").text('此時間段尚無資料');
                        myChart.clear();
                    }

                    let parserY = result.Data.Y.map(item => Math.floor(item));
                    const colors = ['#5391C7'];
                    var option;
                    option = {
                        color: colors,
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: {
                                type: 'cross'
                            }
                        },
                        grid: {
                            bottom: 80
                        },
                        toolbox: {
                            show: true,
                            feature: {
                                saveAsImage: { title: "另存圖片" }
                            }
                        },
                        legend: {
                            y: 'top',
                            x: 'middle',
                            data: ["用水量趨勢"]
                        },
                        xAxis: {
                            nameGap: 25,
                            nameLocation: 'center',
                            name: '時間(小時)',
                            type: 'category',
                            data: result.Data.X
                        },
                        yAxis: {
                            nameLocation: 'center',
                            nameGap: 25,
                            nameRotate: 360,
                            name: '用 \n 水 \n 量 \n ︵ \n 度 \n ︶ \n',
                            type: 'value',
                            axisLine: {
                                show: true,
                                lineStyle: {
                                    color: colors[0]
                                }
                            },
                            axisLabel: { formatter: '{value}' }
                        },
                        series: [
                            {
                                name: '用水量趨勢',
                                type: 'line',
                                // detail: {
                                //    formatter: function (value) {
                                //        return Math.round(value *100)/100;
                                //    }
                                //},
                                data: parserY
                            }
                        ]
                    };
                    option && myChart.setOption(option);
                }
                else {
                    $("#spanError").text('此時間段尚無資料');
                    myChart.clear();
                }
            });
        }

