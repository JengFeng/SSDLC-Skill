@{
    ViewData["Title"] = "用水指針查詢";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section echart{
<script type="text/javascript" src="~/js/echarts/echarts.js"></script>
}
<script>
    $(function(){
        $("#inputStartTime").val("@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")");
        $("#inputEndTime").val("@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")");
        $(".menuList > a:nth-child(2)").addClass("active").siblings().removeClass("active");
        btnSearch();
    });
</script>
<div class="pageWrap">
    <partial name="_MenuPartial" />
    <div class="pageArea">
        <partial name="_NewsBoxPartial" />
        <div class="mainGroup">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard")"><i class="bi bi-house-door-fill"></i>首頁</a></li>
                    <li class="breadcrumb-item active" aria-current="page">用水指針查詢</li>
                </ol>
            </nav>
            <div class="search-inline row">
                <div class="mb-3 col-xs-12 col-lg-6">
                    <label class="form-label"><i class="bi bi-search"></i> 日期起</label>
                    <input type="date" id="inputStartTime" class="form-control mb-3 col-xs-6 col-lg-6">
                    @*<input type="time" id="StartTimeZone" class="form-control mb-3 col-xs-6 col-lg-6" />*@
                </div>
                <div class="mb-3 col-xs-12 col-lg-6">
                    <label class="form-label">日期訖</label>
                    <input type="date" id="inputEndTime" class="form-control mb-3 col-xs-6 col-lg-6">
                    @*<input type="time" id="EndTimeZone" class="form-control mb-3 col-xs-6 col-lg-6" />*@
                </div>
            </div>
            <div class="btnGroup" style="border-bottom: 1px solid #EBF7F5;padding-bottom:25px">
                <a class="btn-green-o" href="javascript:;" onclick="btnSearch()">查詢</a>
                <a class="btn-lightGrey-o" href="javascript:;" onclick="btnReset()">重製</a>
            </div>
            <span id="spanError">此時間段尚無資料</span>
            <div class="pagechartGroup" id="divpagechartGroup" style="width:100%;height:500px;margin-top:15px">
            </div>
        </div>
    </div>
</div><!-- wrap end -->

<script>

    window.onresize = function() {
      myChart.resize();
    };
    function btnReset(){
        history.go(0);
    }

    function btnSearch(){
        $("#spanError").text('');
        var url = "@Url.Action("UseWaterChart","Quality")";
        var model = {
            StartTime : $("#inputStartTime").val(),
            EndTime :$("#inputEndTime").val(),
            //StartTimeZone : $("#StartTimeZone").val()
            //EndTimeZone : $("#EndTimeZone").val()
        };

        $.ajax({
            url: url,
            type: "Post",
            data: model,
            success: function (data) {
                if (data.Success) {
                        LoadChartMethod(jQuery.parseJSON(data.Data));
                    } else {
                        if (data.ModelStateErrors != null) {
                        } else {
                            $("#spanError").text(data.Data.alert);
                            return;
                        }
                    }
                },
            traditional: true
        });
    }

    var myChart = echarts.init(document.getElementById('divpagechartGroup'));
    function LoadChartMethod(obj){
        let fakerMount = obj.Amountdatas.map((_,value) => value * 5);
        var option;
        const colors = ['#ffb1c1', '#5391C7'];
        option = {
            color:colors,
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    type: 'cross'
                }
            },
            legend: {
                data: ['用水量','水費']
            },
            toolbox: {
                show: true,
                feature: {
                    saveAsImage: {}
                }
            },
            xAxis: [{
                name: '時間(小時)',
                type: 'time',
                axisTick: {
                    alignWithLabel: true
                }
            }],
            dataZoom: [
                {
                    minSpan: 0.01,
                    type: 'slider',
                    start: 0,
                    end: 50
                }
            ],
            yAxis: [
                {
                    nameLocation : 'center',
                    nameGap: 45,
                    nameRotate : 360,
                    type: 'value',
                    name: ' 水 \n 費 \n ︵ \n 元 \n ︶ \n',
                    position: 'right',
                    alignTicks: true,
                    axisLine: {
                        show: true,
                        lineStyle: {
                          color: '#ffb1c1'
                        }
                    },
                    axisLabel: {
                        formatter: '{value}'
                    },
                    nameTextStyle: {
                        fontSize: 18
                    }
                },
                {
                    nameLocation : 'center',
                    nameGap: 45,
                    nameRotate : 360,
                    name:'用 \n 水 \n 量 \n ︵ \n 度 \n ︶ \n',
                    type: 'value',
                    position: 'left',
                    alignTicks: true,
                    axisLine: {
                        show: true,
                        lineStyle: {
                            color: '#5391C7'
                        },
                        splitLine: {
                            show: false
                        },
                    },
                    axisLabel: {
                        formatter: '{value}'
                    },
                    nameTextStyle: {
                        fontSize: 18
                    }
                }],
          series: [
            {
              name: '水費',
              type: 'bar',
              data: null,
              lineStyle: {color: '#ffb1c1'},
              data: obj.Amountdatas
            },
            {
              name: '用水量',
              type: 'line',
              yAxisIndex: 1,
              lineStyle: {color: '#5391C7'},
              data: obj.Pindatas
            }
          ]
        };
        option && myChart.setOption(option);
    }
</script>