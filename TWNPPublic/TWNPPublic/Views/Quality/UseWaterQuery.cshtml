@{
    ViewData["Title"] = "用水指針查詢";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
	$(function(){	
		$(".menuList > a:nth-child(3)").addClass("active").siblings().removeClass("active");
	});
</script>
<div class="pageWrap">
	<partial name="_MenuPartial" />
	<div class="pageArea">
        <partial name="_NewsBoxPartial" />
        <div class="mainGroup">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard")"><i class="bi bi-house-door-fill"></i>首頁</a></li>
                    <li class="breadcrumb-item active" aria-current="page">用水指針查詢</li>
                </ol>
            </nav>


            <div class="search-inline row">
                    
                    <div class="mb-3 col-xs-12 col-lg-6">
                        <label for="form-name" class="form-label"><i class="bi bi-search"></i> 日期起</label>
                        <input type="text" class="form-control datepicker-here" data-timepicker="true" data-time-format='hh:ii aa'  data-language='zh'>
                    </div>
                    <div class="mb-3 col-xs-12 col-lg-6">
                        <label for="form-name" class="form-label">日期訖</label>
                        <input type="text" class="form-control datepicker-here" data-timepicker="true" data-time-format='hh:ii aa'  data-language='zh'>
                    </div>

                    


                </div>

                <div class="pagechartGroup">
                    這裡放圖表，預設高500px
                </div>

        </div>


	</div>


</div><!-- wrap end -->