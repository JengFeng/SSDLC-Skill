		<SimpleData name="gid">299</SimpleData>
		<SimpleData name="id">1006</SimpleData>
		<SimpleData name="system_nam">鹿野系統</SimpleData>
		<SimpleData name="admin_unit">第十區管理處</SimpleData>
		<SimpleData name="station">永安淨水場、瑞豐淨水場、瑞源淨水場、紅葉淨水場、武陵淨水場</SimpleData>
		<SimpleData name="region1">鹿野鄉：鹿野、和平社區、四維、永隆、永興、永安、永安高台、永樂、永昌、明野、馬背、龍田、五十戶、瑞源、後湖、新良、日圓、瑞隆、瑞和、新豐景、寶華、延平鄉：桃源、紅葉、永康新村、武陵、鸞山村之鸞山部落、梅山部落。</SimpleData>
		<SimpleData name="update_dat">2019/06/21</SimpleData>
	</SchemaData></ExtendedData>
