	<ExtendedData><SchemaData schemaUrl="#water_area">
		<SimpleData name="fid">sql_statement.48</SimpleData>
		<SimpleData name="gid">335</SimpleData>
		<SimpleData name="id">1103</SimpleData>
		<SimpleData name="system_nam">北斗系統</SimpleData>
		<SimpleData name="admin_unit">第十一區管理處</SimpleData>
		<SimpleData name="station">北斗淨水場、埤頭淨水場、永靖淨水場、埔心淨水場、下壩淨水場</SimpleData>
		<SimpleData name="region1">北斗鎮、永靖鄉。溪州鄉：全區(榮光村、大庄村、成功村、西畔村、柑園村、潮洋村、張厝村、蔡公村、三條村、三圳村、水尾村及溪厝村部分除外)。田尾鄉：全區(福田村、新興村除外)。埤頭鄉：全區(中和村、竹圍村、庄內村、大湖村除外)。埔心鄉：全區(埤霞村、埤腳村、中羅村</SimpleData>
		<SimpleData name="region2">員林市：三潭里部分地區。田中鎮：三民里部分地區。二林鎮：永豐村大排沙段1戶、原斗里3戶、東華里3戶、華崙里1戶，合計8戶。</SimpleData>
		<SimpleData name="update_dat">2019/07/12</SimpleData>
	</SchemaData></ExtendedData>
