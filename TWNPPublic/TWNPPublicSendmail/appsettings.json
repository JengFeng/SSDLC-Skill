{
  "WcfUrl": "http://59.120.223.172/TWN_WCF/DapperService.svc",
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": false,
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/logs/SendMail-${shortdate}.log",
        "layout": "${date} [${uppercase:${level}}] ${message} ${exception}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile"
      }
    ]
  }
}